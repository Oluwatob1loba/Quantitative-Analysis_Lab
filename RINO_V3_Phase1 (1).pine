// RIGEL NOIR V3 Phase 1 refined 3 October 2026. Integrated extension of the supplied approved V2.3 implementation.
// Authoritative rules and documented changes: TAD_V2_3.md and TAD_V3_Phase1.md.
// Structural closes are native-confirmed; developing HTF packets are display-only.
//@version=6
indicator("RIGEL NOIR", shorttitle = "RINO", overlay = true, max_bars_back = 5000, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// =============================================================================================
// SECTION 1 -- INPUTS / UI MATRIX (Market Structure)
// =============================================================================================
string layerEnableTooltip    = "Show or hide this layer's levels on the chart."
string layerTimeframeTooltip = "The higher timeframe this layer's structure is calculated from."
string lineWidthTooltip      = "Thickness of this layer's drawn levels, in pixels."

tf1EnableInput    = input.bool(true, "Enable", group = "TF1 - Macro Layer", inline = "tf1Main", tooltip = "Default: on. Show or hide the larger timeframe levels; calculations continue.")
tf1Input          = input.timeframe("1W", "Timeframe", group = "TF1 - Macro Layer", inline = "tf1Main", tooltip = "Default: 1W. Choose the timeframe for the larger candle ranges and the setup engine.")
lookbackInput     = input.int(4, "Lookback (candles)", minval = 1, maxval = 120, group = "TF1 - Macro Layer", tooltip = "Default: 4. Keep this many closed TF1 candles; larger values retain more levels and use more drawing space.")
tf1SubLookbackInput    = input.int(3, "Sub-lookback (most recent, full opacity)", minval = 1, maxval = 120, group = "TF1 - Macro Layer", tooltip = "Default: 3. Use this many recent TF1 candles for the setup reference window and full-strength levels; the main lookback caps this count.")
tf1ShowOpenInput  = input.bool(false, "Show Open", group = "TF1 - Macro Layer", inline = "tf1Style", tooltip = "Default: off. Show each retained candle opening price as a dotted line.")
tf1MidLookbackInput  = input.int(1, "Mid lookback (candles)", minval = 1, maxval = 120, group = "TF1 - Macro Layer", tooltip = "Default: 1. Keep this many closed-candle midpoint lines; price breaks do not remove them.")
tf1OpenLookbackInput = input.int(0, "Open lookback (0 = follow main)", minval = 0, maxval = 120, group = "TF1 - Macro Layer", tooltip = "Default: 0. Zero follows the main lookback; a positive count gives opening-price lines their own lifetime.")
tf1LineWidthInput = input.int(1, "Width", minval = 1, maxval = 4, group = "TF1 - Macro Layer", inline = "tf1Style", tooltip = "Default: 1. Set this line thickness in pixels.")
tf1HighColor      = input.color(#2962FF, "High", group = "TF1 - Macro Layer", inline = "tf1Colors1", tooltip = "Default: #2962FF placeholder. Choose the color and transparency of high; calculations stay unchanged.")
tf1LowColor       = input.color(#FF6D00, "Low", group = "TF1 - Macro Layer", inline = "tf1Colors1", tooltip = "Default: #FF6D00 placeholder. Choose the color and transparency of low; calculations stay unchanged.")
tf1NeutralColor   = input.color(#8D8D8D, "Neutral (Close = Open)", group = "TF1 - Macro Layer", tooltip = "Default: #8D8D8D placeholder. Choose the color and transparency of neutral (close = open); calculations stay unchanged.")
tf1MidColor       = input.color(#787B86, "Mid", group = "TF1 - Macro Layer", inline = "tf1Colors2", tooltip = "Default: #787B86 placeholder. Choose the color and transparency of mid; calculations stay unchanged.")
tf1OpenColor      = input.color(#9598A1, "Open", group = "TF1 - Macro Layer", inline = "tf1Colors2", tooltip = "Default: #9598A1 placeholder. Choose the color and transparency of open; calculations stay unchanged.")

tf2EnableInput         = input.bool(true, "Enable", group = "TF2 - Structure Layer", inline = "tf2Main", tooltip = "Default: on. Show or hide the swing levels; calculations continue.")
tf2Input               = input.timeframe("1D", "Timeframe", group = "TF2 - Structure Layer", inline = "tf2Main", tooltip = "Default: 1D. Choose the timeframe for swing structure; use a timeframe at or above the chart and at or below TF1.")
tf2AnchorToTf1Input    = input.bool(true, "Anchor to TF1 window", group = "TF2 - Structure Layer", inline = "tf2Anchor", tooltip = "Default: on. Keep swing drawings within the TF1 history window; turn off to use the manual count.")
tf2ManualLookbackInput = input.int(10, "Manual lookback (candles)", minval = 1, maxval = 300, group = "TF2 - Structure Layer", tooltip = "Default: 10. Keep this many TF2 candles when the TF1 anchor switch is off.")
tf2LineWidthInput      = input.int(1, "Width", minval = 1, maxval = 4, group = "TF2 - Structure Layer", tooltip = "Default: 1. Set this line thickness in pixels.")
tf2ShowMinorInput      = input.bool(true, "Show Minor structure", group = "TF2 - Structure Layer", tooltip = "Default: on. Show the smaller or displaced swings; they never set structural direction.")
tf2CriticalEnableInput = input.bool(true, "Highlight Critical Swings", group = "TF2 - Structure Layer", tooltip = "Default: on. Highlight swings close to their larger candle extreme; turn off to use the regular swing color.")
criticalProximityPctInput = input.float(0.1, "Critical proximity (%)", minval = 0.0, step = 0.1, group = "TF2 - Structure Layer", tooltip = "Default: 0.1. A larger percentage accepts swings farther from their larger candle extreme; zero requires an exact price match.")
criticalOnMinorInput   = input.bool(true, "Allow Critical on Minor swings", group = "TF2 - Structure Layer", tooltip = "Default: on. Allow smaller swings to receive the same extreme-price highlight.")
tf2CriticalColor       = input.color(#c84a9a, "Critical", group = "TF2 - Structure Layer", inline = "tf2Colors", tooltip = "Default: #c84a9a placeholder. Choose the color and transparency of critical; calculations stay unchanged.")
tf2MutedColor          = input.color(#a76f9e, "Regular", group = "TF2 - Structure Layer", inline = "tf2Colors", tooltip = "Default: #a76f9e placeholder. Choose the color and transparency of regular; calculations stay unchanged.")
tf2MinorColor          = input.color(#a76f9e, "Minor", group = "TF2 - Structure Layer", inline = "tf2Colors", tooltip = "Default: #a76f9e placeholder. Choose the color and transparency of minor; calculations stay unchanged.")
criticalMarkerSizeInput = input.string("Tiny", "Critical marker size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = "TF2 - Structure Layer", tooltip = "Default: Tiny. Choose the size of the circle placed beside a highlighted swing.")
criticalMarkerTicksInput = input.int(1, "Critical marker distance in ticks", minval = 0, maxval = 1000, group = "TF2 - Structure Layer", tooltip = "Default: 1. Move swing circles vertically by this many minimum price steps; zero places their centers exactly on the line.")
var criticalMarkerSize = switch criticalMarkerSizeInput
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge

fadeOpacityInput = input.int(30, "Faded opacity %", minval = 0, maxval = 100, group = "Fade (Shared)", tooltip = "Default: 30. Set visibility for older TF1 levels and smaller swings; zero hides them and 100 shows full color.")

// V3 configuration stays separate from the V2 trading state and display families.
v3EnableInput = input.bool(true, "Enable Phase 1 setup engine", group = "V3 Core", tooltip = "Default: on. Run or stop the setup and draw-level modules; the independent candle panel stays separate.")
v3DolShowInput = input.bool(true, "Show DOL state and extra anchors", group = "V3 DOL", tooltip = "Default: on. Show draw-level states and extra anchors; hiding them does not change setup detection.")
v3DolLabelsInput = input.bool(false, "PDOL / SDOL labels", group = "V3 DOL", tooltip = "Default: off. Show primary and secondary draw names at the level origin; high labels sit above and low labels below.")
v3DolProximityInput = input.float(0.1, "Cross-anchor confluence %", minval = 0, step = 0.1, group = "V3 DOL", tooltip = "Default: 0.1. Increase the allowed price distance between untouched primary draws on different timeframes.")
v3ConfluentColorInput = input.color(#00BCD4, "Confluent PDOL color", group = "V3 DOL", tooltip = "Default: #00BCD4 placeholder. Choose the color and transparency of confluent pdol color; calculations stay unchanged.")
v3Dol1On = input.bool(true, "Anchor 1", group = "V3 DOL", inline = "dol1", tooltip = "Default: on. Enable this extra draw timeframe; a duplicate of TF1 is skipped.")
v3Dol1Tf = input.timeframe("1W", "Timeframe", group = "V3 DOL", inline = "dol1", tooltip = "Default: 1W. Choose this extra draw timeframe; values below the chart are skipped.")
v3Dol1Lookback = input.int(0, "Anchor 1 candles: 0 recent, -1 main", minval = -1, maxval = 120, group = "V3 DOL", tooltip = "Default: 0. Zero follows the TF1 recent count; minus one follows the main count; a positive value keeps that many candles of this anchor.")
v3Dol2On = input.bool(true, "Anchor 2", group = "V3 DOL", inline = "dol2", tooltip = "Default: on. Enable this extra draw timeframe; a duplicate of TF1 is skipped.")
v3Dol2Tf = input.timeframe("1D", "Timeframe", group = "V3 DOL", inline = "dol2", tooltip = "Default: 1D. Choose this extra draw timeframe; values below the chart are skipped.")
v3Dol2Lookback = input.int(0, "Anchor 2 candles: 0 recent, -1 main", minval = -1, maxval = 120, group = "V3 DOL", tooltip = "Default: 0. Zero follows the TF1 recent count; minus one follows the main count; a positive value keeps that many candles of this anchor.")
v3Dol3On = input.bool(false, "Anchor 3", group = "V3 DOL", inline = "dol3", tooltip = "Default: off. Enable this extra draw timeframe; a duplicate of TF1 is skipped.")
v3Dol3Tf = input.timeframe("3M", "Timeframe", group = "V3 DOL", inline = "dol3", tooltip = "Default: 3M. Choose this extra draw timeframe; values below the chart are skipped.")
v3Dol3Lookback = input.int(0, "Anchor 3 candles: 0 recent, -1 main", minval = -1, maxval = 120, group = "V3 DOL", tooltip = "Default: 0. Zero follows the TF1 recent count; minus one follows the main count; a positive value keeps that many candles of this anchor.")
v3ShowTsInput = input.bool(true, "TS markers", group = "V3 Setups", tooltip = "Default: on. Show labels for confirmed sweep setups and context events.")
v3ShowZoneInput = input.bool(true, "Entry zone", group = "V3 Setups", tooltip = "Default: on. Show the rejection-wick entry area for target-qualified setups.")
v3ShowRangeInput = input.bool(true, "Reference high / low", group = "V3 Setups", tooltip = "Default: on. Show the high and low of the frozen reference window.")
v3ShowCeInput = input.bool(true, "50% CE", group = "V3 Setups", tooltip = "Default: on. Show the midpoint of the frozen reference range.")
v3ShowTargetInput = input.bool(true, "PDOL target", group = "V3 Setups", tooltip = "Default: on. Show the selected untouched primary draw price.")
v3ShowStopInput = input.bool(false, "Reference stop", group = "V3 Setups", tooltip = "Default: off. Show the stop-price reference beyond the manipulation extreme.")
v3ShowRrInput = input.bool(true, "3R / 5R references", group = "V3 Setups", tooltip = "Default: on. Show price references at three and five times the entry-to-stop distance; these are not assumed profits.")
v3ShowQuarterInput = input.bool(false, "Wick quadrant lines", group = "V3 Setups", tooltip = "Default: off. Show the selected percentage lines inside the rejection wick; individual switches control each selected line.")
v3QuadrantsInput = input.string("25", "Wick percentages separated by commas", group = "V3 Setups", tooltip = "Default: 25. Enter up to eight unique percentages from 0 to 100, separated by commas; each marks that fraction from the bottom of the wick.")
v3SupersededGeometryInput = input.bool(false, "Full geometry for superseded setups", group = "V3 Setups", tooltip = "Default: off. Show full drawings for target-qualified events that could not take ownership; otherwise show their labels only.")
v3Quadrant1Input = input.bool(true, "Show wick percentage 1", group = "V3 Wick Percentages", tooltip = "Default: on. Show or hide percentage position 1 from the valid comma-separated wick list.")
v3Quadrant2Input = input.bool(true, "Show wick percentage 2", group = "V3 Wick Percentages", tooltip = "Default: on. Show or hide percentage position 2 from the valid comma-separated wick list.")
v3Quadrant3Input = input.bool(true, "Show wick percentage 3", group = "V3 Wick Percentages", tooltip = "Default: on. Show or hide percentage position 3 from the valid comma-separated wick list.")
v3Quadrant4Input = input.bool(true, "Show wick percentage 4", group = "V3 Wick Percentages", tooltip = "Default: on. Show or hide percentage position 4 from the valid comma-separated wick list.")
v3Quadrant5Input = input.bool(true, "Show wick percentage 5", group = "V3 Wick Percentages", tooltip = "Default: on. Show or hide percentage position 5 from the valid comma-separated wick list.")
v3Quadrant6Input = input.bool(true, "Show wick percentage 6", group = "V3 Wick Percentages", tooltip = "Default: on. Show or hide percentage position 6 from the valid comma-separated wick list.")
v3Quadrant7Input = input.bool(true, "Show wick percentage 7", group = "V3 Wick Percentages", tooltip = "Default: on. Show or hide percentage position 7 from the valid comma-separated wick list.")
v3Quadrant8Input = input.bool(true, "Show wick percentage 8", group = "V3 Wick Percentages", tooltip = "Default: on. Show or hide percentage position 8 from the valid comma-separated wick list.")

v3SetupKeepInput = input.int(12, "Retained TS events", minval = 1, maxval = 30, group = "V3 Setups", tooltip = "Default: 12. Keep this many confirmed setup or context records; older drawings are deleted.")
v3StopTicksInput = input.int(1, "Stop buffer in minimum ticks", minval = 1, maxval = 1000, group = "V3 Setups", tooltip = "Default: 1. Put the stop-price reference this many minimum price steps beyond the manipulation extreme.")
v3BullColorInput = input.color(#26a69a, "Long", group = "V3 Setup Style", inline = "sc", tooltip = "Default: #26a69a placeholder. Choose the color and transparency of long; calculations stay unchanged.")
v3BearColorInput = input.color(#ef5350, "Short", group = "V3 Setup Style", inline = "sc", tooltip = "Default: #ef5350 placeholder. Choose the color and transparency of short; calculations stay unchanged.")
v3ZoneOpacityInput = input.int(12, "Zone opacity %", minval = 0, maxval = 100, group = "V3 Setup Style", tooltip = "Default: 12. Increase this percentage to make the rejection-wick fill more visible.")
v3LineWidthInput = input.int(1, "Line width", minval = 1, maxval = 4, group = "V3 Setup Style", tooltip = "Default: 1. Set this line thickness in pixels.")
v3LabelSizeInput = input.string("Tiny", "Label size", options = ["Tiny", "Small", "Normal"], group = "V3 Setup Style", tooltip = "Default: Tiny. Choose the size of this display text.")
v3LabelPlacementInput = input.string("Outside wick", "Label placement", options = ["Outside wick", "At close"], group = "V3 Setup Style", tooltip = "Default: Outside wick. Put setup labels outside the rejection wick or at the last manipulation close.")
v3LabelOffsetInput = input.int(10, "Label offset in ticks", minval = 0, maxval = 10000, group = "V3 Setup Style", tooltip = "Default: 10. Move outside-wick labels by this many minimum price steps.")
v3Tf1FvgInput = input.bool(true, "TF1 fair value gaps", group = "V3 Key Levels", tooltip = "Default: on. Show TF1 three-candle gaps where the first and third candle wicks do not overlap.")
v3Tf2FvgInput = input.bool(true, "TF2 fair value gaps", group = "V3 Key Levels", tooltip = "Default: on. Show TF2 three-candle gaps where the first and third candle wicks do not overlap.")
v3Tf1ViInput = input.bool(false, "TF1 volume imbalances", group = "V3 Key Levels", tooltip = "Default: off. Show TF1 gaps between a close and the next open when the two candle wick ranges overlap.")
v3Tf2ViInput = input.bool(false, "TF2 volume imbalances", group = "V3 Key Levels", tooltip = "Default: off. Show TF2 gaps between a close and the next open when the two candle wick ranges overlap.")
v3ViWickExtendInput = input.bool(false, "Extend volume imbalances into overlapping wicks", group = "V3 Key Levels", tooltip = "Default: off. Expand each body-gap imbalance to include the shared wick interval; turn off to keep body-gap bounds.")
v3GapLeftInput = input.string("Confirming candle", "Zone starts at", options = ["Confirming candle", "Sequence start"], group = "V3 Key Levels", tooltip = "Default: Confirming candle. Start gap drawings at the confirming candle or at the first candle in their formation sequence.")
v3GapKeepInput = input.int(30, "Retained zones total", minval = 1, maxval = 80, group = "V3 Key Levels", tooltip = "Default: 30. Keep at most this many gap and imbalance zones across both layers.")
v3GapAgeInput = input.int(20, "Zone age in native candles", minval = 1, maxval = 120, group = "V3 Key Levels", tooltip = "Default: 20. Remove zones older than this many candles of their own timeframe.")
v3FvgColorInput = input.color(color.new(#787B86, 85), "FVG", group = "V3 Key Levels", inline = "gc", tooltip = "Default: #787B86, 85 placeholder. Choose the color and transparency of fvg; calculations stay unchanged.")
v3ViColorInput = input.color(color.new(#F23645, 85), "VI", group = "V3 Key Levels", inline = "gc", tooltip = "Default: #F23645, 85 placeholder. Choose the color and transparency of vi; calculations stay unchanged.")
tweezerToleranceInput = input.float(5.0, "Tweezer tolerance % of body EMA", minval = 0, step = 0.5, group = "Candlestick Patterns", tooltip = "Default: 5.0. Increase the allowed difference between paired highs or lows, measured against the average candle body.")
v3RankingInput = input.bool(true, "Show context grade", group = "V3 Ranking", tooltip = "Default: on. Show context grades on actionable setups; hiding grades does not hide setups.")
v3WOpposition = input.float(-1, "Opposes a live owner with a clean target", maxval = 0, group = "V3 Ranking", tooltip = "Default: -1. Apply this negative weight when a new candidate opposes a live setup whose selected target is still untouched; zero removes the penalty.")
v3WConfluence = input.float(1, "DOL confluence", group = "V3 Ranking", tooltip = "Default: 1. Add this weight when untouched primary draws on different timeframes sit close together.")
v3WHtf = input.float(1, "HTF alignment", group = "V3 Ranking", tooltip = "Default: 1. Add this weight when the target agrees with the highest available untouched draw.")
v3WKey = input.float(1, "FVG / VI", group = "V3 Ranking", tooltip = "Default: 1. Add this weight when the sweep reaches an existing gap or body imbalance.")
// K4: reserved timing weight; the dormant provider contributes zero in Phase 1.
float v3WTiming = 1.0
v3WCritical = input.float(1, "Critical break", group = "V3 Ranking", tooltip = "Default: 1. Add this weight for a break of a swing near its larger candle extreme.")
v3WMajor = input.float(0, "Major break", group = "V3 Ranking", tooltip = "Default: 0. Add this weight for a break of a main swing.")
v3WMinor = input.float(-1, "Minor break", group = "V3 Ranking", tooltip = "Default: -1. Add this weight for a break of a smaller swing.")
v3WCaution = input.float(-1, "TF3 unconfirmed break", group = "V3 Ranking", tooltip = "Default: -1. Add this weight when a native swing break lacks matching chart-candle confirmation.")
v3WLocation = input.float(1, "Premium / discount", group = "V3 Ranking", tooltip = "Default: 1. Add this weight for a long entry below the reference midpoint or a short entry above it.")
v3WPattern = input.float(1, "Directional TF2 star / engulfing", group = "V3 Ranking", tooltip = "Default: 1. Add this weight for an existing directional star or engulfing shape at the entry area.")
v3GradeAInput = input.float(5, "Grade A threshold", group = "V3 Ranking", tooltip = "Default: 5. Set the minimum context score for grade A; raising it makes grade A harder to reach.")
v3GradeBInput = input.float(2, "Grade B threshold", group = "V3 Ranking", tooltip = "Default: 2. Set the minimum context score for grade B; lower scores are grade C.")
v3ExportInput = input.bool(false, "Enable JSON event alerts", group = "V3 Export", tooltip = "Default: off. Allow informational JSON alerts; create one TradingView alert for any alert function call to receive them.")
v3ExportRealtimeInput = input.bool(false, "Flush on confirmed chart bars between TF1 closes", group = "V3 Export", tooltip = "Default: off. Send queued events at each closed chart candle; turn off to wait for the next TF1 confirmation.")
v3PanelInput = input.bool(true, "Enable HTF candle panel", group = "HTF Candles", tooltip = "Default: on. Show or hide the higher timeframe candles beside the chart.")
v3PanelLimitInput = input.int(4, "Next eligible groups", minval = 1, maxval = 6, group = "HTF Candles", tooltip = "Default: 4. Show at most this many enabled timeframes above the chart; slot order decides which groups appear.")
v3Panel1On = input.bool(true, "HTF 1", group = "HTF Candles", inline = "p1", tooltip = "Default: on. Enable this panel slot; only timeframes above the chart are drawn.")
v3Panel1Tf = input.timeframe("60", "TF", group = "HTF Candles", inline = "p1", tooltip = "Default: 60. Choose this panel timeframe; values at or below the chart are skipped.")
v3Panel1Count = input.int(24, "Candles", minval = 1, maxval = 40, group = "HTF Candles", inline = "p1", tooltip = "Default: 24. Keep up to this many candles in this group; shared drawing limits can reduce the displayed count.")
v3Panel1Label = input.string("", "HTF 1 label override", group = "HTF Candles", tooltip = "Default: blank. Enter a custom group name; a blank value keeps the timeframe name.")
v3Panel2On = input.bool(true, "HTF 2", group = "HTF Candles", inline = "p2", tooltip = "Default: on. Enable this panel slot; only timeframes above the chart are drawn.")
v3Panel2Tf = input.timeframe("240", "TF", group = "HTF Candles", inline = "p2", tooltip = "Default: 240. Choose this panel timeframe; values at or below the chart are skipped.")
v3Panel2Count = input.int(30, "Candles", minval = 1, maxval = 40, group = "HTF Candles", inline = "p2", tooltip = "Default: 30. Keep up to this many candles in this group; shared drawing limits can reduce the displayed count.")
v3Panel2Label = input.string("", "HTF 2 label override", group = "HTF Candles", tooltip = "Default: blank. Enter a custom group name; a blank value keeps the timeframe name.")
v3Panel3On = input.bool(true, "HTF 3", group = "HTF Candles", inline = "p3", tooltip = "Default: on. Enable this panel slot; only timeframes above the chart are drawn.")
v3Panel3Tf = input.timeframe("1D", "TF", group = "HTF Candles", inline = "p3", tooltip = "Default: 1D. Choose this panel timeframe; values at or below the chart are skipped.")
v3Panel3Count = input.int(20, "Candles", minval = 1, maxval = 40, group = "HTF Candles", inline = "p3", tooltip = "Default: 20. Keep up to this many candles in this group; shared drawing limits can reduce the displayed count.")
v3Panel3Label = input.string("", "HTF 3 label override", group = "HTF Candles", tooltip = "Default: blank. Enter a custom group name; a blank value keeps the timeframe name.")
v3Panel4On = input.bool(true, "HTF 4", group = "HTF Candles", inline = "p4", tooltip = "Default: on. Enable this panel slot; only timeframes above the chart are drawn.")
v3Panel4Tf = input.timeframe("1W", "TF", group = "HTF Candles", inline = "p4", tooltip = "Default: 1W. Choose this panel timeframe; values at or below the chart are skipped.")
v3Panel4Count = input.int(12, "Candles", minval = 1, maxval = 40, group = "HTF Candles", inline = "p4", tooltip = "Default: 12. Keep up to this many candles in this group; shared drawing limits can reduce the displayed count.")
v3Panel4Label = input.string("", "HTF 4 label override", group = "HTF Candles", tooltip = "Default: blank. Enter a custom group name; a blank value keeps the timeframe name.")
v3Panel5On = input.bool(true, "HTF 5", group = "HTF Candles", inline = "p5", tooltip = "Default: on. Enable this panel slot; only timeframes above the chart are drawn.")
v3Panel5Tf = input.timeframe("1M", "TF", group = "HTF Candles", inline = "p5", tooltip = "Default: 1M. Choose this panel timeframe; values at or below the chart are skipped.")
v3Panel5Count = input.int(9, "Candles", minval = 1, maxval = 40, group = "HTF Candles", inline = "p5", tooltip = "Default: 9. Keep up to this many candles in this group; shared drawing limits can reduce the displayed count.")
v3Panel5Label = input.string("", "HTF 5 label override", group = "HTF Candles", tooltip = "Default: blank. Enter a custom group name; a blank value keeps the timeframe name.")
v3Panel6On = input.bool(true, "HTF 6", group = "HTF Candles", inline = "p6", tooltip = "Default: on. Enable this panel slot; only timeframes above the chart are drawn.")
v3Panel6Tf = input.timeframe("3M", "TF", group = "HTF Candles", inline = "p6", tooltip = "Default: 3M. Choose this panel timeframe; values at or below the chart are skipped.")
v3Panel6Count = input.int(8, "Candles", minval = 1, maxval = 40, group = "HTF Candles", inline = "p6", tooltip = "Default: 8. Keep up to this many candles in this group; shared drawing limits can reduce the displayed count.")
v3Panel6Label = input.string("", "HTF 6 label override", group = "HTF Candles", tooltip = "Default: blank. Enter a custom group name; a blank value keeps the timeframe name.")
v3PanelPaddingInput = input.int(15, "Padding from chart", minval = 1, maxval = 200, group = "HTF Layout", tooltip = "Default: 15. Move the panel farther right using this many nominal chart periods.")
v3PanelSpaceInput = input.int(1, "Space between candles", minval = 0, maxval = 20, group = "HTF Layout", tooltip = "Default: 1. Set the horizontal gap between candle bodies in nominal chart periods.")
v3PanelGroupSpaceInput = input.int(10, "Space between groups", minval = 1, maxval = 100, group = "HTF Layout", tooltip = "Default: 10. Set the horizontal gap between timeframe groups in nominal chart periods.")
v3PanelWidthInput = input.int(4, "Candle width", minval = 1, maxval = 10, group = "HTF Layout", tooltip = "Default: 4. Set body width in nominal chart periods; larger values make candles easier to read.")
v3PanelBullBody = input.color(#75b5ad, "Bull body", group = "HTF Style", inline = "pb", tooltip = "Default: #75b5ad placeholder. Choose the color and transparency of bull body; calculations stay unchanged.")
v3PanelBearBody = input.color(#9b779d, "Bear body", group = "HTF Style", inline = "pb", tooltip = "Default: #9b779d placeholder. Choose the color and transparency of bear body; calculations stay unchanged.")
v3PanelBullBorder = input.color(#568f88, "Bull border", group = "HTF Style", inline = "pbr", tooltip = "Default: #568f88 placeholder. Choose the color and transparency of bull border; calculations stay unchanged.")
v3PanelBearBorder = input.color(#7b597d, "Bear border", group = "HTF Style", inline = "pbr", tooltip = "Default: #7b597d placeholder. Choose the color and transparency of bear border; calculations stay unchanged.")
v3PanelBullWick = input.color(#568f88, "Bull wick", group = "HTF Style", inline = "pw", tooltip = "Default: #568f88 placeholder. Choose the color and transparency of bull wick; calculations stay unchanged.")
v3PanelBearWick = input.color(#7b597d, "Bear wick", group = "HTF Style", inline = "pw", tooltip = "Default: #7b597d placeholder. Choose the color and transparency of bear wick; calculations stay unchanged.")
v3PanelLabelInput = input.bool(true, "HTF label", group = "HTF Labels", tooltip = "Default: on. Show each group timeframe name or custom label.")
v3PanelLabelPosInput = input.string("Top", "Label position", options = ["Top", "Bottom"], group = "HTF Labels", tooltip = "Default: Top. Put group text above or below the displayed candles.")
v3PanelLabelAlignInput = input.bool(true, "Align label rows", group = "HTF Labels", tooltip = "Default: on. Align group labels on one shared row; turn off to use each group high or low.")
v3PanelLabelColorInput = input.color(#787B86, "Text color", group = "HTF Labels", tooltip = "Default: #787B86 placeholder. Choose the color and transparency of text color; calculations stay unchanged.")
v3PanelLabelSizeInput = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = "HTF Labels", tooltip = "Default: Small. Choose the size of this display text.")
v3PanelTimerInput = input.bool(true, "Remaining time", group = "HTF Labels", tooltip = "Default: on. Show the live time remaining; unavailable or closed-market countdowns show n/a.")
v3PanelFvgInput = input.bool(true, "Panel FVG", group = "HTF Imbalances", tooltip = "Default: on. Show confirmed unfilled three-candle gaps on the candle panel.")
v3PanelFvgFillInput = input.color(color.new(#787B86, 45), "Panel gap fill", group = "HTF Imbalances", tooltip = "Default: #787B86, 45 placeholder. Choose the color and transparency of panel gap fill; calculations stay unchanged.")
v3PanelFvgBorderInput = input.color(color.new(#787B86, 10), "Panel gap border", group = "HTF Imbalances", tooltip = "Default: #787B86, 10 placeholder. Choose the color and transparency of panel gap border; calculations stay unchanged.")
v3PanelViFillInput = input.color(color.new(#F23645, 45), "Panel imbalance fill", group = "HTF Imbalances", tooltip = "Default: #F23645, 45 placeholder. Choose the color and transparency of panel imbalance fill; calculations stay unchanged.")
v3PanelViBorderInput = input.color(color.new(#F23645, 10), "Panel imbalance border", group = "HTF Imbalances", tooltip = "Default: #F23645, 10 placeholder. Choose the color and transparency of panel imbalance border; calculations stay unchanged.")
v3PanelViInput = input.bool(false, "Panel volume imbalance", group = "HTF Imbalances", tooltip = "Default: off. Show confirmed unfilled overlapping-wick body gaps on the candle panel.")
v3PanelTraceInput = input.bool(false, "Trace lines", group = "HTF Trace", tooltip = "Default: off. Draw opening, closing, highest and lowest prices from a selected panel group back to its native origin.")
v3PanelTraceAnchorInput = input.string("Last Timeframe", "Anchor to", options = ["First Timeframe", "Last Timeframe"], group = "HTF Trace", tooltip = "Default: Last Timeframe. Use the first or last visible timeframe group for the four trace prices.")
v3PanelPriceInput = input.bool(false, "Trace price labels", group = "HTF Trace", tooltip = "Default: off. Show numeric prices beside the four trace lines.")
v3TraceOpenColor = input.color(#787B86, "Open", group = "HTF Trace", inline = "tro", tooltip = "Default: #787B86 placeholder. Choose the color and transparency of open; calculations stay unchanged.")
v3TraceOpenStyle = input.string("Dotted", "Style", options = ["Solid", "Dotted", "Dashed"], group = "HTF Trace", inline = "tro", tooltip = "Default: Dotted. Choose a solid, dotted or dashed line.")
v3TraceOpenWidth = input.int(2, "Width", minval = 1, maxval = 4, group = "HTF Trace", inline = "tro", tooltip = "Default: 2. Set this line thickness in pixels.")
v3TraceCloseColor = input.color(#787B86, "Close", group = "HTF Trace", inline = "trc", tooltip = "Default: #787B86 placeholder. Choose the color and transparency of close; calculations stay unchanged.")
v3TraceCloseStyle = input.string("Dotted", "Style", options = ["Solid", "Dotted", "Dashed"], group = "HTF Trace", inline = "trc", tooltip = "Default: Dotted. Choose a solid, dotted or dashed line.")
v3TraceCloseWidth = input.int(1, "Width", minval = 1, maxval = 4, group = "HTF Trace", inline = "trc", tooltip = "Default: 1. Set this line thickness in pixels.")
v3TraceHighColor = input.color(#787B86, "High", group = "HTF Trace", inline = "trh", tooltip = "Default: #787B86 placeholder. Choose the color and transparency of high; calculations stay unchanged.")
v3TraceHighStyle = input.string("Dotted", "Style", options = ["Solid", "Dotted", "Dashed"], group = "HTF Trace", inline = "trh", tooltip = "Default: Dotted. Choose a solid, dotted or dashed line.")
v3TraceHighWidth = input.int(1, "Width", minval = 1, maxval = 4, group = "HTF Trace", inline = "trh", tooltip = "Default: 1. Set this line thickness in pixels.")
v3TraceLowColor = input.color(#787B86, "Low", group = "HTF Trace", inline = "trl", tooltip = "Default: #787B86 placeholder. Choose the color and transparency of low; calculations stay unchanged.")
v3TraceLowStyle = input.string("Dotted", "Style", options = ["Solid", "Dotted", "Dashed"], group = "HTF Trace", inline = "trl", tooltip = "Default: Dotted. Choose a solid, dotted or dashed line.")
v3TraceLowWidth = input.int(1, "Width", minval = 1, maxval = 4, group = "HTF Trace", inline = "trl", tooltip = "Default: 1. Set this line thickness in pixels.")

// =============================================================================================
// SECTION 2 -- TYPE DEFINITION (UDT)
// =============================================================================================
type Level
    line   id
    float  price
    int    startTime
    int    endTime          // na while active; set to the BREAKING native candle opening timestamp
                             // the instant invalidation is detected (Sections 7a/8a), so the line
                             // renders correctly terminated on ANY TF3, not just its own native one.
    string tf                // "TF1" or "TF2"
    bool   isActive
    string isHighLow         // "High" | "Low" | "Mid" | "Open" (TF1)   or   "High" | "Low" (TF2)
    string polarity          // "resistance" | "support" -- unused/inert for Mid, see Section 7
    bool   isCritical = false // TF2 Major or eligible Minor (TAD V2.2 Section 9). Set ONCE at confirmation,
                              // permanent thereafter. Defaults false so every existing TF1
                              // Level.new() call (Section 7, untouched by this revision) doesn't
                              // need to mention this field at all -- it simply doesn't apply there.
    bool   criticalTested = false // TF2 Major or Minor. False means "not yet possible to test" (the
                              // parent TF1 candle hadn't closed at confirmation time), NOT
                              // "confirmed not critical" -- those are different things isCritical
                              // alone can't distinguish. Section 7's retry step flips this to true
                              // (resolving isCritical for good) the moment that parent closes.
    string tf1Direction = "" // TF1 High/Low only (TAD V2.2 Section 8): "up" | "down" | "neutral",
                              // set ONCE at spawn from that candle's own close-vs-open, driving
                              // the per-candle color swap. Irrelevant for Mid, Open, and all of
                              // TF2 -- left at its default "" for those, which f_lineColor treats
                              // as "up" (the as-configured, non-inverted mapping).
    label  markerId = na      // TF2 Critical swings only (TAD V2.2 Section 9.2). The small
                              // circular marker's own drawing-object handle, kept on the Level so
                              // it shares that Level's exact lifecycle -- created once alongside
                              // the line, deleted only when the Level itself is pruned (Section 8c).

    string dolRole = ""
    int    dolState = 0
    int    availableAt = na
    int    dolChangedAt = na
    bool   dolConfluent = false
    bool   dolCoverage = true
    label  dolLabel = na

// Used by Section 18's Period Dividers. Declared here, alongside Level, purely to keep both
// user-defined types in one place -- it is not referenced until Section 18.
type Divider
    line  lineId
    label labelId

// =============================================================================================
// SECTION 3 -- HELPER FUNCTIONS (Market Structure)
// =============================================================================================
// BUG B3: parsing never depends on timeframe.in_seconds returning a calendar value.
// One day is one rank unit; month ranks use the documented Gregorian mean comparison key.
// This is an ordinal comparison policy, not OHLC aggregation or an exact calendar duration.
f_v3TfRank(string period) =>
    tf = period == "" ? timeframe.period : period
    last = str.substring(tf, str.length(tf)-1, str.length(tf))
    hasUnit = last == "S" or last == "D" or last == "W" or last == "M" or last == "T"
    numberText = hasUnit ? str.substring(tf, 0, str.length(tf)-1) : tf
    multiplier = numberText == "" ? 1.0 : str.tonumber(numberText)
    scale = last == "S" ? 1.0/86400.0 : last == "D" ? 1.0 : last == "W" ? 7.0 : last == "M" ? 30.4375 : last == "T" ? float(na) : 1.0/1440.0
    not na(multiplier) and multiplier > 0 ? multiplier * scale : float(na)
f_v3TfKey(string period) =>
    tf = period == "" ? timeframe.period : period
    last = str.substring(tf, str.length(tf)-1, str.length(tf))
    hasUnit = last == "S" or last == "D" or last == "W" or last == "M" or last == "T"
    numberText = hasUnit ? str.substring(tf, 0, str.length(tf)-1) : tf
    multiplier = numberText == "" ? 1.0 : str.tonumber(numberText)
    str.tostring(multiplier, "#") + (hasUnit ? last : "min")
f_v3TfLe(string lower, string upper) =>
    a = f_v3TfRank(lower)
    b = f_v3TfRank(upper)
    not na(a) and not na(b) and a <= b
f_v3Quadrants(string csv) =>
    array<float> values = array.new<float>()
    for part in str.split(csv, ",")
        value = str.tonumber(str.trim(part))
        if not na(value) and value >= 0 and value <= 100 and not array.includes(values, value) and array.size(values) < 8
            array.push(values, value)
    values
var array<float> v3QuadrantValues = f_v3Quadrants(v3QuadrantsInput)
v3QuadrantSwitches = array.from(v3Quadrant1Input, v3Quadrant2Input, v3Quadrant3Input, v3Quadrant4Input, v3Quadrant5Input, v3Quadrant6Input, v3Quadrant7Input, v3Quadrant8Input)

f_lineStyle(kind) =>
    kind == "Mid" ? line.style_dashed : kind == "Open" ? line.style_dotted : line.style_solid

// Takes the whole Level so TF1's color can depend on tf1Direction (High/Low only, TAD V2.2
// Section 8) and TF2's on isCritical -- neither piece of state applies outside its own timeframe,
// which is exactly why both default to values that fall through to the "normal" mapping (empty
// string reads as "up" below; isCritical = false routes to the shared Regular color). Handles TF1
// and TF2 Major only -- Minor structure is colored directly in its own render-loop branch, since
// it always fades unconditionally and never needs the Critical/Regular branch here.
f_lineColor(lvl) =>
    color result = na
    if lvl.tf == "TF1"
        if lvl.isHighLow == "High"
            // Upclose (or the unset "" default): as-configured High color. Downclose: inverted --
            // takes the Low color instead. Neutral: its own third color, overriding either side.
            result := lvl.tf1Direction == "down" ? tf1LowColor : lvl.tf1Direction == "neutral" ? tf1NeutralColor : tf1HighColor
        else if lvl.isHighLow == "Low"
            result := lvl.tf1Direction == "down" ? tf1HighColor : lvl.tf1Direction == "neutral" ? tf1NeutralColor : tf1LowColor
        else if lvl.isHighLow == "Mid"
            result := tf1MidColor
        else
            result := tf1OpenColor
    else
        result := (tf2CriticalEnableInput and lvl.isCritical) ? tf2CriticalColor : tf2MutedColor
    result

// Applies the shared Fade opacity (TAD V2.2 Section 8 fade + TF2 Minor) as true transparency,
// letting the chart show through, rather than shifting the color toward gray. Pine's own
// color.new() transparency argument runs the opposite direction from "opacity" (0 = fully
// visible, 100 = fully invisible), so this just flips the sign on the user-facing percentage.
f_fadeColor(baseColor, opacityPct) =>
    color.new(baseColor, 100 - opacityPct)
// Deletes a Level's drawing objects and clears its handles so the same Level can be re-rendered
// later from its stored stamps. Hiding in this system must be an explicit act -- "just stop
// updating the line" leaves an orphaned object on the chart forever, which is exactly the class
// of bug behind the "toggle off and the lines stay there" report. Used by Section 9's render
// gates (out-of-window levels, closed visibility gates) and by the Minor/Critical toggles.
// Deletes a Level's drawing objects and clears its handles so the same Level can be re-rendered
// later from its stored stamps. Hiding in this system must be an explicit act -- "just stop
// updating the line" leaves an orphaned object on the chart forever, which is exactly the class
// of bug behind the "toggle off and the lines stay there" report. Used by Section 9's render
// gates (out-of-window levels, closed visibility gates) and by the Minor/Critical toggles.
// V2.3 fix (RE10041): the outer na() guard is mandatory, not defensive padding. A Level-typed
// VARIABLE can itself be na (no object at all) -- tf1CurrentMid is exactly that on every bar
// before the first TF1 close -- and touching ANY field of a na UDT reference is a runtime error,
// not a silent no-op. This guard makes the helper safe to call with any Level handle, anywhere.
f_hideLevel(lvl) =>
    if not na(lvl)
        if not na(lvl.id)
            line.delete(lvl.id)
            lvl.id := na
        if not na(lvl.markerId)
            label.delete(lvl.markerId)
            lvl.markerId := na
        if not na(lvl.dolLabel)
            label.delete(lvl.dolLabel)
            lvl.dolLabel := na
    true

// Event transport is informational. It never calls strategy functions or broker APIs.
var array<string> v3PendingEvents = array.new<string>()
var array<int> v3QueueDrops = array.new<int>(1, 0)
f_v3Quote(string textValue) =>
    "\"" + str.replace_all(str.replace_all(str.replace_all(textValue, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n") + "\""
f_v3Number(float value) =>
    na(value) ? "null" : str.tostring(value, "#.##########")
f_v3Bool(bool value) =>
    value ? "true" : "false"
f_v3Event(string kind, string nativeTf, int origin, int detected, string fields) =>
    if v3ExportInput
        eventId = kind + ":" + nativeTf + ":" + str.tostring(origin) + ":" + str.tostring(detected) + ":" + fields
        payload = "{\"eventId\":" + f_v3Quote(eventId) + ",\"kind\":" + f_v3Quote(kind) + ",\"nativeTf\":" + f_v3Quote(nativeTf) + ",\"originTime\":" + str.tostring(origin) + ",\"detectedAt\":" + str.tostring(detected) + fields + "}"
        array.push(v3PendingEvents, payload)
        if array.size(v3PendingEvents) > 200
            array.shift(v3PendingEvents)
            array.set(v3QueueDrops, 0, array.get(v3QueueDrops, 0) + 1)
    true
f_v3DolEvent(Level level, string nativeTf) =>
    f_v3Event("DOL_STATE", nativeTf, level.startTime, level.dolChangedAt, ",\"role\":" + f_v3Quote(level.dolRole) + ",\"price\":" + f_v3Number(level.price) + ",\"state\":" + str.tostring(level.dolState))
f_v3Size(string selection) =>
    selection == "Normal" ? size.normal : selection == "Small" ? size.small : size.tiny
f_v3Style(string selection) =>
    selection == "Solid" ? line.style_solid : selection == "Dashed" ? line.style_dashed : line.style_dotted
// Admission checks make optional V3 drawings yield BEFORE Pine's garbage collector evicts core.
f_v3Room(int linesNeeded, int boxesNeeded, int labelsNeeded) =>
    array.size(line.all) + linesNeeded < 490 and array.size(box.all) + boxesNeeded < 490 and array.size(label.all) + labelsNeeded < 490
// Optional panel registries are cleared ahead of core rendering on the last bar.
// This prevents yesterday's panel from consuming headroom needed by newly-confirmed structure.
var array<line> v3PanelLines = array.new<line>()
var array<box> v3PanelBoxes = array.new<box>()
var array<label> v3PanelLabels = array.new<label>()
if barstate.islast
    for handle in v3PanelLines
        line.delete(handle)
    for handle in v3PanelBoxes
        box.delete(handle)
    for handle in v3PanelLabels
        label.delete(handle)
    array.clear(v3PanelLines)
    array.clear(v3PanelBoxes)
    array.clear(v3PanelLabels)

// =============================================================================================
// SECTION 4 -- DATA FETCHING (non-repainting)
// =============================================================================================
// V3 correction: a confirmed native packet must have the offset INSIDE its request.
// Developing HTF data is reserved for the independent candle panel.
[tf1O, tf1H, tf1L, tf1C, tf1ClosedT, tf1ClosedEnd] = request.security(syminfo.tickerid, tf1Input, [open[1], high[1], low[1], close[1], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
tf1T = time(tf1Input)

[tf2C, tf2ClosedT, tf2ClosedEnd] = request.security(syminfo.tickerid, tf2Input, [close[1], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
tf2T = time(tf2Input)

// Confirmed native pivot packets use timestamp identity, including consecutive pivot events.
[tf2PivotHigh, tf2PivotLow, tf2PivotTime] = request.security(syminfo.tickerid, tf2Input, [ta.pivothigh(high, 1, 1)[1], ta.pivotlow(low, 1, 1)[1], time[2]], lookahead = barmerge.lookahead_on)

tf2ManualAnchorTime = request.security(syminfo.tickerid, tf2Input, time[tf2ManualLookbackInput], lookahead = barmerge.lookahead_on)

// =============================================================================================
// SECTION 5 -- PERSISTENT STATE (Market Structure)
// =============================================================================================
var array<Level> tf1Levels      = array.new<Level>()   // TF1 High/Low(/Open) levels, oldest-first
var array<int>   tf1CandleTime  = array.new<int>()     // one UNIX timestamp per TF1 candle GROUP, oldest-first
var array<Level> tf1MidLevels   = array.new<Level>()   // Midpoint levels, oldest-first (V2.3: array replaces the single tf1CurrentMid; size capped by tf1MidLookbackInput, 1 = original isolated behaviour)
var array<Level> tf2Levels      = array.new<Level>()   // confirmed TF2 Major Structure swings, oldest-first --
                                                         // strictly alternates High/Low by construction (Section 8)
var array<Level> tf2MinorLevels = array.new<Level>()   // superseded TF2 pivots, retained but structurally
                                                         // walled off from bias/CHoCH; eligible for Critical (Section 8)

// TF2 alternation filter's pending (unconfirmed) candidates -- at most one high-side and one
// low-side candidate can exist at any time. A candidate is confirmed as Major the instant the
// OPPOSITE type appears; it is superseded (and tagged Minor) the instant a more extreme same-type
// pivot appears first. "More extreme" is judged wick-vs-wick (Option A, restored in V2.3): the
// same price that gets stored and rendered is the price that wins the contest, so the array can
// never disagree with the chart the user is looking at.
var float pendingHighPrice = na
var int   pendingHighTime  = na
var float pendingLowPrice  = na
var int   pendingLowTime   = na

// System-wide bias state (TAD V2.2 Section 7.2): "undefined" until enough confirmed Major
// structure exists to even evaluate a Protected Swing relationship, then bullish or bearish.
var string bias = "undefined"

// =============================================================================================
// SECTION 6 -- DYNAMIC VISIBILITY GATES (Market Structure)
// =============================================================================================
showTf1 = tf1EnableInput and f_v3TfLe(timeframe.period, tf1Input)
showTf2 = tf2EnableInput and f_v3TfLe(timeframe.period, tf2Input)

// One TF2 candle's duration in milliseconds -- used by Section 9's render loop to centre Critical
// markers over their parent candle rather than pinning them to its opening edge. Computed once
// here rather than per-level in the loop, since it depends only on the configured timeframe.
tf2DurationMs = timeframe.in_seconds(tf2Input) * 1000

// Cross-timeframe bridge for Critical Swing classification (TAD V2.2 Section 9.1), needed by
// both Section 7 (retry, below) and Section 8 (initial test) -- placed here, after tf1CandleTime/
// tf1Levels are declared (Section 5) and before either section's own logic, since Pine resolves
// identifiers top-to-bottom regardless of which numbered section surrounds them.
//
// Finds the ONE TF1 candle group whose time window contains a given timestamp, and returns
// [resolved, High, Low]. Genuinely deferred, not just "not found": tf1T is the FIXED, already-
// known opening time of whichever TF1 candle is CURRENTLY forming -- reading a timestamp boundary
// live is safe, unlike reading a still-changing price. If originTime falls on or after that
// boundary, its true parent is the candle currently forming, whose High/Low are not confirmed
// values yet -- resolved comes back false, and the caller must wait rather than substitute the
// nearest OLDER (and therefore wrong) already-closed candle. Only when originTime predates the
// current candle's own start does the backward search below even run, at which point
// tf1CandleTime being sorted oldest-first means the FIRST entry found searching backward that is
// <= originTime is, by construction, the correct containing group.
f_findParentTf1HighLow(originTime) =>
    resolved = not na(tf1T) and originTime < tf1T
    float foundHigh = na
    float foundLow  = na
    if resolved
        float parentTime = na
        i = array.size(tf1CandleTime) - 1
        while i >= 0 and na(parentTime)
            groupTime = array.get(tf1CandleTime, i)
            if groupTime <= originTime
                parentTime := groupTime
            i -= 1
        if not na(parentTime)
            for lvl in tf1Levels
                if lvl.startTime == parentTime
                    if lvl.isHighLow == "High"
                        foundHigh := lvl.price
                    if lvl.isHighLow == "Low"
                        foundLow := lvl.price
    [resolved, foundHigh, foundLow]

// Single place where a swing's Critical status is actually decided, so the tolerance rule can
// never drift between the three call sites that need it (Major confirmation, Minor creation, and
// Section 7e's deferred retry). Returns [resolved, isCritical] -- resolved = false means the
// parent TF1 candle hasn't closed yet and the question is still open, which is a different thing
// from a resolved "no" and is why criticalTested exists as its own field on the Level UDT.
// Tolerance is a percentage of the absolute native parent price; zero price has an exact-match branch.
f_testCritical(originTime, price, isHigh) =>
    [resolved, parentHigh, parentLow] = f_findParentTf1HighLow(originTime)
    parentPrice = isHigh ? parentHigh : parentLow
    // V2.3: Proximity test. A TF2 swing is Critical if it forms within X% of its parent TF1 candle's High or Low.
    // This percentage-based proximity test replaces the original tick-based tolerance, absorbing spread differences
    // and timeframe aggregation mismatches so that valid structural alignments are reliably flagged regardless of
    // the instrument's tick value. 1.0% is the default.
    isCrit = false
    if resolved and not na(parentPrice) and parentPrice != 0
        pctDiff = math.abs(price - parentPrice) / math.abs(parentPrice) * 100.0
        isCrit := pctDiff <= criticalProximityPctInput
    if resolved and parentPrice == 0
        isCrit := price == 0
    [resolved, isCrit]

// =============================================================================================
// SECTION 7 -- TF1 ENGINE (Time & Price Anchor)
// =============================================================================================
newTf1Bar = f_v3TfLe(timeframe.period, tf1Input) and not na(tf1ClosedT) and tf1ClosedT != tf1ClosedT[1]

if newTf1Bar and not na(tf1ClosedT)
    closedO = tf1O
    closedH = tf1H
    closedL = tf1L
    closedC = tf1C
    closedT = tf1ClosedT

    // --- 7a. Invalidation: a confirmed CLOSE beyond the level, on TF1's OWN timeframe only --
    // never TF3's. The endTime cap is tf1ClosedT, the BREAKING candle's own opening timestamp, not
    // tf1T (the next candle's opening time = the breaking candle's END). Capping at the end would
    // draw the line straight through the candle that broke it and stop only on its far side,
    // visually overshooting the break; capping at the open stops the line cleanly at the breaking
    // candle's left edge, leaving that candle fully visible to the right of the terminated line.
    // If the line is already drawn, it's snapped to that cap immediately; if not (e.g. showTf1 was
    // off at the time), Section 9 handles it on first draw.
    for lvl in tf1Levels
        if lvl.isActive
            brokeUp   = closedC > lvl.price
            brokeDown = closedC < lvl.price
            if (lvl.polarity == "resistance" and brokeUp) or (lvl.polarity == "support" and brokeDown)
                lvl.isActive := false
                if lvl.dolRole != ""
                    lvl.dolState := 2
                    lvl.dolChangedAt := tf1ClosedEnd
                    f_v3DolEvent(lvl, tf1Input)
                lvl.endTime := tf1ClosedT
                if not na(lvl.id)
                    line.set_x2(lvl.id, lvl.endTime)

    // --- 7b. Spawn High/Low(/Open) for the candle that just closed -- these are the levels that
    // participate in the N-candle lookback window and get evicted together in 7c.
    openPolarity = closedC > closedO ? "support" : "resistance"

    // TAD V2.2 Section 8: this candle's own close-vs-open direction, stamped once onto its High
    // and Low levels to drive the per-candle color swap. Deliberately NOT applied to Open --
    // Open's own polarity above is already derived from this exact same comparison, so swapping
    // its color on top of that would be circular; Open keeps its own independent tf1OpenColor,
    // same as Mid keeps tf1MidColor, both entirely unaffected by this per-candle logic.
    tf1CandleDirection = closedC > closedO ? "up" : closedC < closedO ? "down" : "neutral"

    array.push(tf1Levels, Level.new(id = na, price = closedH, startTime = closedT, endTime = na, tf = "TF1", isActive = true, isHighLow = "High", polarity = "resistance", tf1Direction = tf1CandleDirection, dolRole = tf1CandleDirection == "neutral" ? "" : tf1CandleDirection == "up" ? "PDOL" : "SDOL", availableAt = tf1ClosedEnd))
    array.push(tf1Levels, Level.new(id = na, price = closedL, startTime = closedT, endTime = na, tf = "TF1", isActive = true, isHighLow = "Low", polarity = "support", tf1Direction = tf1CandleDirection, dolRole = tf1CandleDirection == "neutral" ? "" : tf1CandleDirection == "down" ? "PDOL" : "SDOL", availableAt = tf1ClosedEnd))

    if tf1ShowOpenInput
        array.push(tf1Levels, Level.new(id = na, price = closedO, startTime = closedT, endTime = na, tf = "TF1", isActive = true, isHighLow = "Open", polarity = openPolarity))

    array.push(tf1CandleTime, closedT)
    

    // --- 7e. Resolve deferred Critical Swing tests: this TF1 candle that just closed may be
    // exactly the parent one or more pending TF2 swings were waiting on (Section 8b defers rather
    // than tests against the wrong, still-open period). Runs generically over every untested
    // swing, not just ones from the immediately-preceding period -- if something is still pending
    // from further back for any reason, this same pass catches it too. Both arrays are swept:
    // Minor swings carry the same Critical question as Major ones, since whether a price sits on
    // its TF1 parent's extreme has nothing to do with which pivot won the alternation contest.
    for lvl2c in tf2Levels
        if not lvl2c.criticalTested
            [resolvedC, isCritC] = f_testCritical(lvl2c.startTime, lvl2c.price, lvl2c.isHighLow == "High")
            if resolvedC
                lvl2c.isCritical := isCritC
                lvl2c.criticalTested := true

    for lvlMc in tf2MinorLevels
        if not lvlMc.criticalTested
            [resolvedMc, isCritMc] = f_testCritical(lvlMc.startTime, lvlMc.price, lvlMc.isHighLow == "High")
            if resolvedMc
                lvlMc.isCritical := isCritMc
                lvlMc.criticalTested := true

    // --- 7c. Per-type window eviction (V2.3 amendment) ---
    // The old group-shift eviction assumed every candle contributed exactly the same 2-or-3
    // levels, which made independent per-type lookbacks impossible. Eviction scans every entry
    // against its own type-specific startTime cutoff: tf1CandleTime is sorted oldest-first, so the timestamp
    // at position (size - N) is the oldest candle an N-candle window still retains, and any level
    // whose own origin predates ITS type's cutoff is hidden and shifted out. The loop stops at the
    // first survivor in older revisions; V3 scans all entries to handle interleaved type windows. High/Low obey the main lookback; Open
    // obeys its own window when set (0 or Show Open off = follow main); Mid is handled in 7d.
    openKeepNow   = tf1ShowOpenInput and tf1OpenLookbackInput > 0 ? tf1OpenLookbackInput : lookbackInput
    hlCutoffNow   = array.get(tf1CandleTime, math.max(array.size(tf1CandleTime) - lookbackInput, 0))
    openCutoffNow = array.get(tf1CandleTime, math.max(array.size(tf1CandleTime) - openKeepNow, 0))
    // V3 lifetime correction: a retained Open cannot block eviction of later expired extremes.
    evictIdx = array.size(tf1Levels) - 1
    while evictIdx >= 0
        candidate = array.get(tf1Levels, evictIdx)
        cutoff = candidate.isHighLow == "Open" ? openCutoffNow : hlCutoffNow
        if candidate.startTime < cutoff
            f_hideLevel(candidate)
            array.remove(tf1Levels, evictIdx)
        evictIdx -= 1
    // Trim the candle-time index to the widest window any level type still needs.
    keepCandlesNow = math.max(lookbackInput, openKeepNow)
    while array.size(tf1CandleTime) > keepCandlesNow
        array.shift(tf1CandleTime)

        // --- 7d. Midpoint array (V2.3 amendment) ---
    // Mids stay outside tf1Levels and outside price-invalidation entirely (TAD V2 Section 2):
    // window slide is the only thing that ever retires them. With the lookback at 1 this is
    // exactly the old isolated behaviour; above 1, older Mids persist as dashed lines until the
    // window slides past them. f_hideLevel on eviction keeps the stamps/handles discipline: the
    // Level leaves the array and its line dies with it, nothing orphaned.
    array.push(tf1MidLevels, Level.new(id = na, price = (closedH + closedL) / 2.0, startTime = closedT, endTime = na, tf = "TF1", isActive = true, isHighLow = "Mid", polarity = "support"))
    while array.size(tf1MidLevels) > tf1MidLookbackInput
        oldMid = array.shift(tf1MidLevels)
        f_hideLevel(oldMid)

// =============================================================================================
// SECTION 8 -- TF2 ENGINE (Major Structure: Alternation, Bias/CHoCH, Critical Swing)
// =============================================================================================
// 8a. A TF2 candle closes  -> test every active TF2 Major AND Minor level for invalidation, on
//     TF2's OWN confirmed close only -- same mechanics as 7a. Immediately after Major
//     invalidation, checks whether the swing that just broke was the current Protected Swing --
//     if so, this is a CHoCH and bias flips (TAD V2.2 Section 7.2). A BOS (the MOST RECENT swing
//     breaking, same direction as prevailing bias) needs no separate code at all: it's already
//     fully represented by that swing's own isActive flip in the loop below, at a different array
//     index than the Protected Swing, so bias correctly stays put.
// 8b. A raw TF2 pivot fires -> alternation filter (TAD V2.2 Section 7.1): tracks at most one
//     pending (unconfirmed) candidate per side. A same-type pivot either supersedes the pending
//     candidate (the older one retained as Minor) or is itself immediately Minor -- decided by
//     comparing wick prices (ratified Option A). The wick still sets the level's own
//     stored/rendered price either way, since a level is only ever actually broken at its real
//     extreme; the wick also decides which competing pivot wins the pending slot.
//     An opposite-type pivot confirms whatever was pending on the OTHER side as Major Structure;
//     Critical Swing status (TAD V2.2 Section 9.1) is evaluated once, right here, at that exact
//     moment, and is permanent from then on.
// 8c. Every bar -> prune any TF2 Major or Minor level whose own start time has fallen behind the
//     anchor window, mirroring 7c.
biasBeforeClose = bias
newTf2Bar = f_v3TfLe(timeframe.period, tf2Input) and not na(tf2ClosedT) and tf2ClosedT != tf2ClosedT[1]

if newTf2Bar and not na(tf2ClosedT)
    closed2C = tf2C

    // Capture the CURRENT Protected Swing's active/inactive state BEFORE this bar's invalidation
    // pass runs, so a CHoCH is detected on the EXACT bar it happens, rather than re-triggering on
    // every later bar just because that swing is already broken. Alternation guarantees confirmed
    // Major Structure strictly alternates High/Low, so the entry immediately before the most
    // recent confirmed swing is, by construction, always the opposite type -- no search needed,
    // just the last two array entries.
    n2 = array.size(tf2Levels)
    protectedIdx = n2 >= 2 ? n2 - 2 : na
    wasProtectedActive = not na(protectedIdx) ? array.get(tf2Levels, protectedIdx).isActive : false

    for lvl2 in tf2Levels
        if lvl2.isActive
            brokeUp2   = closed2C > lvl2.price
            brokeDown2 = closed2C < lvl2.price
            if (lvl2.polarity == "resistance" and brokeUp2) or (lvl2.polarity == "support" and brokeDown2)
                lvl2.isActive := false
                lvl2.endTime := tf2ClosedT
                if not na(lvl2.id)
                    line.set_x2(lvl2.id, lvl2.endTime)

    // Minor levels get the identical close-based invalidation treatment, entirely independent of
    // Major above -- Minor never feeds bias/CHoCH, but a broken Minor line shouldn't linger drawn
    // looking live once price has actually closed through it.
    for lvlM in tf2MinorLevels
        if lvlM.isActive
            brokeUpM   = closed2C > lvlM.price
            brokeDownM = closed2C < lvlM.price
            if (lvlM.polarity == "resistance" and brokeUpM) or (lvlM.polarity == "support" and brokeDownM)
                lvlM.isActive := false
                lvlM.endTime := tf2ClosedT
                if not na(lvlM.id)
                    line.set_x2(lvlM.id, lvlM.endTime)

    // CHoCH: the Protected Swing was active a moment ago and is now broken -- flip bias. This is
    // a SEPARATE, system-wide state change from that level's own isActive flip above; the two
    // occur on the same candle close but are not the same mechanism (TAD V2.2 Section 7.2).
    if not na(protectedIdx) and wasProtectedActive
        protectedSwing = array.get(tf2Levels, protectedIdx)
        if not protectedSwing.isActive
            if bias == "bullish" and protectedSwing.isHighLow == "Low"
                bias := "bearish"
            else if bias == "bearish" and protectedSwing.isHighLow == "High"
                bias := "bullish"

// Effective anchor: either TF1's own oldest-tracked-candle time, or an independent manual window.
// V2.3: the anchor follows the MAIN High/Low window explicitly, not whatever the candle-time
// index happens to retain -- an independent Open lookback deeper than the main window must not
// silently widen the TF2 anchored structure window.
tf1WindowAnchor = array.size(tf1CandleTime) > 0 ? array.get(tf1CandleTime, math.max(array.size(tf1CandleTime) - lookbackInput, 0)) : na
tf2AnchorTime   = tf2AnchorToTf1Input ? tf1WindowAnchor : tf2ManualAnchorTime

// --- 8b. Alternation filter + Critical Swing classification ---
// V2.3: the pivotInWindow CREATION gate is gone. Pivots are one-time events; filtering them at
// creation meant any pivot that fired while a NARROW anchor was active was never recorded at all,
// so re-widening the anchor later could not bring its structure back. Pivots are now recorded
// unconditionally (bounded by the memory horizon in 8c) and the anchor window is enforced at
// RENDER time in Section 9 instead -- which is what makes the anchor toggle reversible both ways.
newPivotHigh  = f_v3TfLe(timeframe.period, tf2Input) and not na(tf2PivotHigh) and (na(tf2PivotTime[1]) or tf2PivotTime != tf2PivotTime[1])
newPivotLow   = f_v3TfLe(timeframe.period, tf2Input) and not na(tf2PivotLow) and (na(tf2PivotTime[1]) or tf2PivotTime != tf2PivotTime[1])

if newPivotHigh
    if na(pendingHighPrice) or tf2PivotHigh > pendingHighPrice
        // This pivot becomes (or remains) the pending candidate. Whatever was pending before, if
        // anything, has just been superseded -- tag it Minor and retain it, never discard it.
        // It still gets Critical-tested on the way out: losing the alternation contest says
        // nothing about whether its price happens to be its parent TF1 candle's own extreme.
        if not na(pendingHighPrice)
            [resSupH, critSupH] = f_testCritical(pendingHighTime, pendingHighPrice, true)
            array.push(tf2MinorLevels, Level.new(id = na, price = pendingHighPrice, startTime = pendingHighTime, endTime = na, tf = "TF2", isActive = true, isHighLow = "High", polarity = "resistance", isCritical = critSupH, criticalTested = resSupH))
        pendingHighPrice := tf2PivotHigh
        pendingHighTime  := tf2PivotTime
    else
        // Less extreme (by wick) than the current pending candidate -- it never had a chance to
        // lead, so it's Minor immediately, and the pending candidate above is left untouched.
        [resLoseH, critLoseH] = f_testCritical(tf2PivotTime, tf2PivotHigh, true)
        array.push(tf2MinorLevels, Level.new(id = na, price = tf2PivotHigh, startTime = tf2PivotTime, endTime = na, tf = "TF2", isActive = true, isHighLow = "High", polarity = "resistance", isCritical = critLoseH, criticalTested = resLoseH))

if newPivotLow
    if na(pendingLowPrice) or tf2PivotLow < pendingLowPrice
        if not na(pendingLowPrice)
            [resSupL, critSupL] = f_testCritical(pendingLowTime, pendingLowPrice, false)
            array.push(tf2MinorLevels, Level.new(id = na, price = pendingLowPrice, startTime = pendingLowTime, endTime = na, tf = "TF2", isActive = true, isHighLow = "Low", polarity = "support", isCritical = critSupL, criticalTested = resSupL))
        pendingLowPrice := tf2PivotLow
        pendingLowTime  := tf2PivotTime
    else
        [resLoseL, critLoseL] = f_testCritical(tf2PivotTime, tf2PivotLow, false)
        array.push(tf2MinorLevels, Level.new(id = na, price = tf2PivotLow, startTime = tf2PivotTime, endTime = na, tf = "TF2", isActive = true, isHighLow = "Low", polarity = "support", isCritical = critLoseL, criticalTested = resLoseL))

// Confirmation: whichever side just got a NEW pivot of the OPPOSITE type confirms whatever was
// pending on ITS OWN side as Major Structure -- alternation, by definition, means "the opposite
// type just appeared", regardless of whether that new opposite-type pivot itself goes on to
// become the new pending candidate, or is itself immediately superseded/Minor (both handled,
// independently, above). Runs after both branches so a same-bar simultaneous high+low resolves.
if newPivotLow and not na(pendingHighPrice)
    [resolvedA, isCriticalHigh] = f_testCritical(pendingHighTime, pendingHighPrice, true)
    array.push(tf2Levels, Level.new(id = na, price = pendingHighPrice, startTime = pendingHighTime, endTime = na, tf = "TF2", isActive = true, isHighLow = "High", polarity = "resistance", isCritical = isCriticalHigh, criticalTested = resolvedA))
    // Bootstrap: TAD V2.2 Section 7.2 only specifies the bullish<->bearish CHoCH transitions, not
    // how bias FIRST leaves "undefined". Once at least 2 confirmed Major swings exist, bias takes
    // its first value from that pair's own direction: Low-then-High (this branch) reads bullish.
    if bias == "undefined" and array.size(tf2Levels) >= 2
        bias := "bullish"
    pendingHighPrice := na
    pendingHighTime  := na

if newPivotHigh and not na(pendingLowPrice)
    [resolvedB, isCriticalLow] = f_testCritical(pendingLowTime, pendingLowPrice, false)
    array.push(tf2Levels, Level.new(id = na, price = pendingLowPrice, startTime = pendingLowTime, endTime = na, tf = "TF2", isActive = true, isHighLow = "Low", polarity = "support", isCritical = isCriticalLow, criticalTested = resolvedB))
    // Mirror bootstrap: High-then-Low reads as bearish.
    if bias == "undefined" and array.size(tf2Levels) >= 2
        bias := "bearish"
    pendingLowPrice := na
    pendingLowTime  := na

// --- 8c. Two-tier lifetime: MEMORY horizon (here) vs RENDER window (Section 9) ---
// Tier 2 (memory, this block): a Level leaves the array for good only once its origin falls
// behind the EARLIEST anchor the user could switch to right now -- the older of the TF1 window
// and the manual window. Tier 1 (render, Section 9): levels outside the CURRENT anchor window are
// hidden (objects deleted, handles cleared) but RETAINED in the array.
// Why two tiers: the old code deleted Levels the moment they left the current window. Because a
// pivot event is one-time, that made the anchor toggle destructive -- narrow the window and every
// swing outside it was forgotten forever; widen it again and the chart came back empty until new
// pivots slowly re-formed. Hiding instead of forgetting makes the toggle fully reversible in both
// directions while memory stays bounded by whichever of the two anchor inputs is wider.
memoryHorizon = math.min(nz(tf1WindowAnchor, nz(tf2ManualAnchorTime, time)), nz(tf2ManualAnchorTime, nz(tf1WindowAnchor, time)))

if not na(memoryHorizon)
    i2 = array.size(tf2Levels) - 1
    while i2 >= 0
        lvl2p = array.get(tf2Levels, i2)
        if lvl2p.startTime < memoryHorizon
            f_hideLevel(lvl2p)
            array.remove(tf2Levels, i2)
        i2 -= 1

    iM = array.size(tf2MinorLevels) - 1
    while iM >= 0
        lvlMp = array.get(tf2MinorLevels, iM)
        if lvlMp.startTime < memoryHorizon
            f_hideLevel(lvlMp)
            array.remove(tf2MinorLevels, iM)
        iM -= 1

// V3 correction: an expired pending pivot must not later re-enter as fresh Major structure.
if not na(pendingHighTime) and pendingHighTime < memoryHorizon
    pendingHighPrice := na
    pendingHighTime := na
if not na(pendingLowTime) and pendingLowTime < memoryHorizon
    pendingLowPrice := na
    pendingLowTime := na

// =============================================================================================
// SECTION 9 -- RENDER LOOP (Market Structure)
// =============================================================================================
// A level not yet drawn (id == na) is created now: if it's still active, it's drawn live,
// extending to the current bar's time like normal; if it's ALREADY inactive by the time it first
// gets drawn (e.g. it was invalidated while showTf1/showTf2 was off), it's drawn already
// terminated at its stored endTime instead of starting live and needing a later correction.
// A level that's already drawn and still active keeps extending to "now" every bar. A level
// that's already drawn and already inactive needs nothing further here -- it was already snapped
// to its exact endTime the instant invalidation was detected (Sections 7a/8a).

// Sub-lookback fade cutoff (TAD V2.2 Section 8): recomputed every bar since the window slides
// forward as new TF1 candles close. tf1CandleTime is sorted oldest-first, so the timestamp
// exactly tf1SubLookbackEff positions from the end marks the boundary -- anything at or after it
// is "recent" (full opacity), anything before it fades. Clamped to lookbackInput so sub-lookback
// can never exceed however many candles are actually being tracked right now.
tf1SubLookbackEff = math.min(tf1SubLookbackInput, lookbackInput)
tf1SubLookbackCutoff = array.size(tf1CandleTime) > 0 ? array.get(tf1CandleTime, math.max(array.size(tf1CandleTime) - tf1SubLookbackEff, 0)) : na

// Visibility-gate cleanup (V2.3): when the chart timeframe rises ABOVE a layer's own timeframe,
// that layer's gate closes -- and its already-drawn objects must be explicitly deleted, not
// abandoned. Previously the render loop simply stopped running, leaving every TF1/TF2 line and
// marker orphaned on the chart at exactly the moment the gate said they should not be visible.
if not showTf1
    for lvlHide1 in tf1Levels
        f_hideLevel(lvlHide1)
    for midHide in tf1MidLevels
        f_hideLevel(midHide)

if not showTf2
    for lvlHide2 in tf2Levels
        f_hideLevel(lvlHide2)
    for lvlHide3 in tf2MinorLevels
        f_hideLevel(lvlHide3)

if showTf1
    for lvl in tf1Levels
        baseColor = f_lineColor(lvl)
        // Faded, not the as-configured color, once this level's own candle has aged past the
        // sub-lookback window. Re-evaluated every bar regardless of isActive -- an already-broken
        // level can still visibly transition from full opacity to faded as the window slides past
        // it, since fade is about RECENCY, not about whether the level is still live.
        renderColor = (not na(tf1SubLookbackCutoff) and lvl.startTime < tf1SubLookbackCutoff) ? f_fadeColor(baseColor, fadeOpacityInput) : baseColor
        if v3DolShowInput and lvl.dolState == 1
            renderColor := f_fadeColor(baseColor, fadeOpacityInput)
        if v3DolShowInput and lvl.dolConfluent and lvl.dolState == 0
            renderColor := v3ConfluentColorInput
        if na(lvl.id)
            endpoint = lvl.isActive ? time : lvl.endTime
            lvl.id := line.new(x1 = lvl.startTime, y1 = lvl.price, x2 = endpoint, y2 = lvl.price, xloc = xloc.bar_time, extend = extend.none, color = renderColor, style = f_lineStyle(lvl.isHighLow), width = tf1LineWidthInput)
        else
            line.set_color(lvl.id, renderColor)
            if lvl.isActive
                line.set_x2(lvl.id, time)

    // Midpoint levels (V2.3 amendment): rendered from the Mid array, oldest-first, live-extending
    // to "now" exactly like the old single instance. Deliberately excluded from the fade check:
    // Mids are already a secondary annotation layer, and fading them on top of their own lookback
    // window would double-penalize age. With the lookback at 1 this draws exactly one line.
    for midLvl in tf1MidLevels
        if na(midLvl.id)
            midLvl.id := line.new(x1 = midLvl.startTime, y1 = midLvl.price, x2 = time, y2 = midLvl.price, xloc = xloc.bar_time, extend = extend.none, color = f_lineColor(midLvl), style = f_lineStyle(midLvl.isHighLow), width = tf1LineWidthInput)
        else
            line.set_x2(midLvl.id, time)

if showTf2
    for lvl2 in tf2Levels
        // Render gate (V2.3, lifetime tier 1): a Major level whose origin has slid behind the
        // CURRENT anchor window is hidden, not forgotten -- f_hideLevel deletes its drawing
        // objects and clears the handles, while the Level itself stays in the array so that
        // re-widening the window (or flipping the anchor toggle back) redraws it instantly from
        // its stored stamps. This is what makes the anchor toggle reversible: a pivot is a
        // one-time event, so a Level deleted here could never be re-created later.
        if lvl2.startTime < tf2AnchorTime
            f_hideLevel(lvl2)
            continue
        if na(lvl2.id)
            endpoint2 = lvl2.isActive ? time : lvl2.endTime
            lvl2.id := line.new(x1 = lvl2.startTime, y1 = lvl2.price, x2 = endpoint2, y2 = lvl2.price, xloc = xloc.bar_time, extend = extend.none, color = f_lineColor(lvl2), style = line.style_solid, width = tf2LineWidthInput)
        else
            // Colour is refreshed every bar, not only at creation, so flipping "Highlight Critical
            // Swings" later re-colours lines that already exist instead of leaving a stale mix of
            // old and new colours on the chart.
            line.set_color(lvl2.id, f_lineColor(lvl2))
            if lvl2.isActive
                line.set_x2(lvl2.id, time)

        // Critical Swing marker (TAD V2.2 Section 9.2 -- exception explicitly granted to the
        // no-labels rule for this one case, since it carries no text/name, only a shape).
        // A small filled circle per TAD V2.2 Section 9.2's original specification, positioned
        // immediately above/below the swing. Kept at the user-configured size input, defaulting
        // to Tiny so the dot reads as "this exact point" without adding pixel mass to the swing.
        //
        // Positioned at the CENTRE of its TF2 candle's own time span, not at startTime. startTime
        // is that candle's opening edge, which on TF2 itself is barely distinguishable from its
        // centre -- but viewed from a much lower TF3, a single Weekly candle spans dozens of bars,
        // and pinning the marker to its left edge makes it look badly offset from the swing it
        // belongs to. Adding half the TF2 candle duration puts it over the middle of the parent
        // candle at every zoom level.
        //
        // Created once, the moment isCritical is true, independent of the toggle -- but its COLOUR
        // responds to the toggle every bar, exactly like the line's own colour does via
        // f_lineColor, so turning the toggle off actually hides it rather than leaving a stale
        // marker with no matching line.
        // Critical Swing marker (TAD V2.2 Section 9.2): a small circular label stamped at the
        // swing's own past timestamp. V2.3 revert from plotshape: labels are the ONLY Pine
        // mechanism that can place a marker on a historical bar after the fact. Critical status
        // is confirmed bars after the swing's origin (pivot right-bar confirmation, then the
        // alternation filter, then possibly the deferred TF1 retry), so a plotshape emission
        // window -- which only ever sees the bar being computed right now -- can never catch it.
        if lvl2.isCritical
            markerColor = tf2CriticalEnableInput ? tf2CriticalColor : color.new(tf2CriticalColor, 100)
            if na(lvl2.markerId)
                markerOffset = criticalMarkerTicksInput * syminfo.mintick
                markerY = lvl2.isHighLow == "High" ? lvl2.price + markerOffset : lvl2.price - markerOffset
                markerX = int(lvl2.startTime + tf2DurationMs / 2)
                lvl2.markerId := label.new(x = markerX, y = markerY, text = "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_circle, color = markerColor, size = criticalMarkerSize)
            else
                label.set_color(lvl2.markerId, markerColor)

    // Minor structure has its own colour (tf2MinorColor), independent of Regular, always shown at
    // the shared Fade opacity -- unconditionally, not gated by TF1's sub-lookback recency check,
    // since Minor fades because of WHAT it is (superseded structure), not because of its age.
    //
    // The one exception is a Critical Minor swing: when criticalOnMinorInput is on, a Minor swing
    // that sits on its parent TF1 candle's own extreme is promoted to the full Critical colour and
    // gets the same marker as a Critical Major swing. It lost the alternation contest, but the
    // price level it marks is still a TF1 extreme, and that is what Critical is actually about.
    //
    // V2.3 structure-agnostic rule: that Critical marker is NOT gated by Show Minor. Whether a
    // price sits on its parent TF1 candle's extreme is a fact about price, independent of which
    // pivot won the alternation contest and independent of whether superseded structure is
    // currently being drawn at all -- so the marker survives Show Minor being switched off, while
    // the plain Minor line still obeys the toggle.
    //
    // Hiding is explicit in both directions (V2.3): switching a draw flag off deletes the objects
    // immediately instead of abandoning them mid-chart -- the old "just stop updating" behaviour
    // is what left orphaned lines on the chart forever and flooded them back in on re-enable --
    // and switching the flag back on redraws from the stored stamps, no reconstruction needed.
    for lvlM2 in tf2MinorLevels
        inWindowM       = lvlM2.startTime >= tf2AnchorTime
        minorIsCrit     = criticalOnMinorInput and tf2CriticalEnableInput and lvlM2.isCritical
        drawMinorLine   = tf2ShowMinorInput and inWindowM
        drawMinorMarker = minorIsCrit and inWindowM

        if not drawMinorLine and not na(lvlM2.id)
            line.delete(lvlM2.id)
            lvlM2.id := na
        if not inWindowM and not na(lvlM2.markerId)
            label.delete(lvlM2.markerId)
            lvlM2.markerId := na

        if drawMinorLine
            // Critical Minor renders at full Critical colour; everything else Minor renders in
            // Minor's own colour at the shared Fade opacity -- unconditionally, not gated by TF1's
            // sub-lookback recency check, since Minor fades because of WHAT it is (superseded
            // structure), not because of its age.
            thisMinorColor = minorIsCrit ? tf2CriticalColor : f_fadeColor(tf2MinorColor, fadeOpacityInput)
            if na(lvlM2.id)
                endpointM2 = lvlM2.isActive ? time : lvlM2.endTime
                lvlM2.id := line.new(x1 = lvlM2.startTime, y1 = lvlM2.price, x2 = endpointM2, y2 = lvlM2.price, xloc = xloc.bar_time, extend = extend.none, color = thisMinorColor, style = line.style_solid, width = tf2LineWidthInput)
            else
                line.set_color(lvlM2.id, thisMinorColor)
                if lvlM2.isActive
                    line.set_x2(lvlM2.id, time)

        // Critical Minor marker: structure-agnostic (survives Show Minor being off, per the V2.3
        // rule), stamped as a label at the swing's own past timestamp for the same reason as Major.
        if drawMinorMarker
            if na(lvlM2.markerId)
                minorOffset = criticalMarkerTicksInput * syminfo.mintick
                minorMarkerY = lvlM2.isHighLow == "High" ? lvlM2.price + minorOffset : lvlM2.price - minorOffset
                minorMarkerX = int(lvlM2.startTime + tf2DurationMs / 2)
                lvlM2.markerId := label.new(x = minorMarkerX, y = minorMarkerY, text = "", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_circle, color = tf2CriticalColor, size = criticalMarkerSize)
            else
                label.set_color(lvlM2.markerId, tf2CriticalColor)
        else if not na(lvlM2.markerId)
            // Reclassified or toggle changed: hide via full transparency rather than deleting, so
            // the marker returns instantly if the condition flips back without a rebuild.
            label.set_color(lvlM2.markerId, color.new(tf2CriticalColor, 100))

// =============================================================================================
// SECTION 9B -- MOVING AVERAGE OVERLAYS (implements TAD V2.2 Section 10)
// =============================================================================================
// Labeled 9B rather than "Section 10" to avoid renumbering the Sessions module immediately below,
// whose own internal numbering (10-18) predates this revision and is left untouched throughout.
// Entirely independent of the TF1/TF2/TF3 Market Structure engine above and the Sessions module
// below -- no interaction with, and no authority over, structure, bias, or invalidation. Both
// overlays anchor to a higher timeframe than whatever the chart currently displays, using the
// same anchor-independent-of-displayed-timeframe request.security pull already used for TF1 and
// TF2 (Section 4), so a Weekly EMA stays computed from Weekly closes even while viewing a 4-hour
// chart, rather than silently degrading into a same-timeframe plot. Continuously-recomputed
// plotted lines, not discrete Level-UDT drawing objects -- no startTime/endTime, no pruning
// needed (TAD V2.2 Section 10.3's own Bounded Lifetime note: plot() manages its own redraw every
// bar without manual object lifecycle work).
maEnableInput  = input.bool(true, "Enable", group = "MA Overlays", tooltip = "Default: on. Show or hide the existing moving-average overlays; they do not gate setups.")
maSmoothInput  = input.bool(true, "Smooth (scale length to chart timeframe)", group = "MA Overlays", tooltip = "Default: on. Use a chart-based approximation for smoother averages; turn off for native-timeframe calculations.")
emaAnchorInput = input.timeframe("1W", "EMA anchor timeframe", group = "MA Overlays", tooltip = "Default: 1W. Choose the shared timeframe used by both exponential averages.")
ema1LenInput   = input.int(9, "Length", minval = 1, group = "MA Overlays", inline = "ema1", tooltip = "Default: 9. Set this moving-average length; larger values react more slowly.")
ema1SrcInput   = input.source(close, "Source", group = "MA Overlays", inline = "ema1", tooltip = "Default: close price. Choose the price series used by this moving average.")
ema1Color      = input.color(#2962FF, "Color", group = "MA Overlays", inline = "ema1", tooltip = "Default: #2962FF placeholder. Choose the color and transparency of color; calculations stay unchanged.")
ema2LenInput   = input.int(18, "Length", minval = 1, group = "MA Overlays", inline = "ema2", tooltip = "Default: 18. Set this moving-average length; larger values react more slowly.")
ema2SrcInput   = input.source(close, "Source", group = "MA Overlays", inline = "ema2", tooltip = "Default: close price. Choose the price series used by this moving average.")
ema2Color      = input.color(#FF6D00, "Color", group = "MA Overlays", inline = "ema2", tooltip = "Default: #FF6D00 placeholder. Choose the color and transparency of color; calculations stay unchanged.")
smaAnchorInput = input.timeframe("1D", "SMA anchor timeframe", group = "MA Overlays", tooltip = "Default: 1D. Choose the timeframe used by the simple average.")
smaLenInput    = input.int(200, "Length", minval = 1, group = "MA Overlays", inline = "sma1", tooltip = "Default: 200. Set this moving-average length; larger values react more slowly.")
smaSrcInput    = input.source(close, "Source", group = "MA Overlays", inline = "sma1", tooltip = "Default: close price. Choose the price series used by this moving average.")
smaColor       = input.color(#787B86, "Color", group = "MA Overlays", inline = "sma1", tooltip = "Default: #787B86 placeholder. Choose the color and transparency of color; calculations stay unchanged.")

// Visibility gate, mirroring Section 6's own rule for TF1/TF2: an overlay only renders if the
// chart is at or below its anchor timeframe. A Weekly EMA on a Monthly chart would be pulling
// finer-grained data than the chart itself displays, which is meaningless -- so it's hidden
// rather than drawn misleadingly. Each overlay is gated against its OWN anchor independently,
// so the Daily SMA can hide while the Weekly EMAs stay visible, or vice versa.
showEmaOverlay = maEnableInput and timeframe.in_seconds() <= timeframe.in_seconds(emaAnchorInput)
showSmaOverlay = maEnableInput and timeframe.in_seconds() <= timeframe.in_seconds(smaAnchorInput)

// Scale factor for Smooth mode: how many chart candles fit inside one anchor candle. Floored at
// 1 so that when chart and anchor timeframes match (or the chart is somehow higher), the length
// passes through unscaled rather than collapsing toward zero.
emaScale = math.max(int(math.round(timeframe.in_seconds(emaAnchorInput) / timeframe.in_seconds())), 1)
smaScale = math.max(int(math.round(timeframe.in_seconds(smaAnchorInput) / timeframe.in_seconds())), 1)

// Both MA variants are computed before selection so their rolling histories remain continuous.
ema1Stepped = request.security(syminfo.tickerid, emaAnchorInput, ta.ema(ema1SrcInput, ema1LenInput), lookahead = barmerge.lookahead_off)
ema2Stepped = request.security(syminfo.tickerid, emaAnchorInput, ta.ema(ema2SrcInput, ema2LenInput), lookahead = barmerge.lookahead_off)
smaStepped  = request.security(syminfo.tickerid, smaAnchorInput, ta.sma(smaSrcInput, smaLenInput), lookahead = barmerge.lookahead_off)

// V2.3 fix (RE10004): Pine's rolling functions may reference at most 5000 historical candles.
// Smooth mode scales the anchor length by the chart-to-anchor ratio, so on low chart timeframes
// the product blows past that ceiling (Weekly 18 on a 30m chart = 18 x 336 = 6048 -> RE10004 on
// bar 0, exactly when the chart is first replayed at <=30m). The cap keeps the script alive at
// every timeframe; when it binds, the smooth line is a slightly faster approximation of the true
// anchor MA rather than a crash -- and switching Smooth off remains the mathematically-exact
// stepped variant at ANY timeframe, so exactness is always one click away.
smoothLenCap = 5000
ema1Smooth = ta.ema(ema1SrcInput, math.min(math.max(ema1LenInput * emaScale, 1), smoothLenCap))
ema2Smooth = ta.ema(ema2SrcInput, math.min(math.max(ema2LenInput * emaScale, 1), smoothLenCap))
smaSmooth  = ta.sma(smaSrcInput,  math.min(math.max(smaLenInput  * smaScale, 1), smoothLenCap))

ema1Value = maSmoothInput ? ema1Smooth : ema1Stepped
ema2Value = maSmoothInput ? ema2Smooth : ema2Stepped
smaValue  = maSmoothInput ? smaSmooth  : smaStepped

plot(showEmaOverlay ? ema1Value : na, title = "EMA 1 (Weekly 9 default)", color = ema1Color, linewidth = 1)
plot(showEmaOverlay ? ema2Value : na, title = "EMA 2 (Weekly 18 default)", color = ema2Color, linewidth = 1)
plot(showSmaOverlay ? smaValue  : na, title = "SMA 200 (Daily default)", color = smaColor, linewidth = 2)

// =============================================================================================
// SECTION 9C -- CANDLESTICK PATTERNS: SHARED SIZING CORE (implements TAD V2.2 Section 11.2)
// =============================================================================================
// Piece 1 of the Section 11 delivery: the volatility-relative measurement layer every pattern
// detector in Piece 2 will share. Nothing here renders and nothing here decides trend context --
// both arrive in later pieces (11.4 rendering, 11.3 context), per the delivery plan.
//
// WHY EMA-RELATIVE SIZING (trading rationale): a "small body" or "long shadow" means something
// completely different in a quiet week than in a news week. Measuring bodies and shadows against
// a 14-period exponential average of recent body size makes every threshold self-adjusting across
// volatility regimes, instead of one fixed number silently changing meaning. The 14-period default
// comes from the studied reference source and is exposed as an input, not hardcoded (TAD 11.2).
//
// WHY A PURE FUNCTION (mechanical rationale): f_candleCore reads whichever OHLC context it is
// evaluated in. Piece 2 will call it INSIDE request.security() for TF1 and for TF2 separately, so
// each timeframe's patterns are measured on that timeframe's own candles -- never on TF3 -- the
// same anchor-independent-of-displayed-timeframe philosophy the TF1/TF2 engines already use.

patternBodyAvgLenInput = input.int(14, "Body-size average length", minval = 1, group = "Candlestick Patterns", tooltip = "Default: 14. Set the number of native candles in the body-size average; longer values adapt more slowly.")
dojiBodyPctInput       = input.float(5.0, "Doji body % of range", minval = 0.5, step = 0.5, group = "Candlestick Patterns", tooltip = "Default: 5.0. Raise the largest body size allowed for a small-body doji, as a percentage of its whole candle.")
shadowEqualsInput      = input.float(100.0, "Doji shadow balance tolerance %", minval = 1.0, step = 5.0, group = "Candlestick Patterns", tooltip = "Default: 100.0. Raise the allowed difference between the two doji wicks; lower values require closer balance.")
shadowPercentInput     = input.float(5.0, "Shadow existence % of body", minval = 0.5, step = 0.5, group = "Candlestick Patterns", tooltip = "Default: 5.0. Set the smallest wick counted as present, as a percentage of the candle body.")
spinningPctInput       = input.float(34.0, "Spinning top shadow % of range", minval = 1.0, step = 1.0, group = "Candlestick Patterns", tooltip = "Default: 34.0. Set the minimum size of each spinning-top wick, as a percentage of the whole candle.")
hammerFactorInput      = input.float(2.0, "Hammer shadow multiple of body", minval = 1.0, step = 0.5, group = "Candlestick Patterns", tooltip = "Default: 2.0. Set how many times longer the main hammer wick must be than its body.")

// The shared measurement pass. Returns one tuple of series so a single call site computes
// everything any detector needs, once per timeframe context. Division-by-zero guards are added
// where the reference source assumed non-zero shadows -- a zero-shadow candle must yield false,
// not a runtime error.
f_candleCore() =>
    bodyHi   = math.max(close, open)
    bodyLo   = math.min(close, open)
    body     = bodyHi - bodyLo
    bodyAvg  = ta.ema(body, patternBodyAvgLenInput)
    smallBody = body < bodyAvg
    longBody  = body > bodyAvg
    upShadow  = high - bodyHi
    dnShadow  = bodyLo - low
    hasUpShadow = upShadow > shadowPercentInput / 100.0 * body
    hasDnShadow = dnShadow > shadowPercentInput / 100.0 * body
    whiteBody = open < close
    blackBody = open > close
    rng       = high - low
    bodyMiddle = body / 2.0 + bodyLo
    // Doji: tiny body AND balanced shadows, both required together (TAD 11.2).
    shadowBalanced = upShadow == dnShadow or (dnShadow != 0 and upShadow != 0 and (math.abs(upShadow - dnShadow) / dnShadow * 100.0) < shadowEqualsInput and (math.abs(dnShadow - upShadow) / upShadow * 100.0) < shadowEqualsInput)
    isDojiBody = rng > 0 and body <= rng * dojiBodyPctInput / 100.0
    isDoji     = isDojiBody and shadowBalanced
    // Spinning top: both shadows independently long, body NOT doji-sized -- the deliberate
    // contrast with Doji's balance requirement (TAD 11.2). Colour-agnostic on purpose: the
    // reference's separate White/Black variants are merged into one flag per TAD 11.1.
    spinningShape = rng > 0 and dnShadow >= rng * spinningPctInput / 100.0 and upShadow >= rng * spinningPctInput / 100.0 and not isDojiBody
    // Hammer-family shared shape: small body high in the range, long lower shadow, negligible
    // upper shadow. Hanging Man uses this exact same shape; trend context splits them (Piece 3).
    hammerShape = smallBody and body > 0 and bodyLo > hl2 and dnShadow >= hammerFactorInput * body and not hasUpShadow
    [smallBody, longBody, whiteBody, blackBody, isDojiBody, isDoji, spinningShape, hammerShape, hasUpShadow, hasDnShadow, bodyHi, bodyLo, bodyMiddle, bodyAvg]

// =============================================================================================
// SECTION 9D -- CANDLESTICK PATTERNS: DETECTORS & TF1/TF2 PULLS (implements TAD V2.2 Section 11.1)
// =============================================================================================
// Piece 2 of the Section 11 delivery: the eleven pattern detectors, built as pure shape-matching
// logic on top of the Piece 1 sizing core. Trend context (Section 11.3) is deliberately excluded
// here and arrives in Piece 3, keeping the shape definitions strictly geometric and reusable.
//
// UI GROUPING: To keep the settings panel clean (per your earlier request), the 11 patterns are
// grouped into 6 logical toggles. Bullish/Bearish Engulfing share one toggle; Tweezer Top/Bottom
// share one; Morning Star and Morning Doji Star share one; Evening Star and Evening Doji Star
// share one; Hammer and Hanging Man share one. This satisfies the TAD's "one switch per pattern"
// rule at the pattern-family level without cluttering the UI with 11 separate checkboxes.

// --- Master Render Toggles ---
renderTf1PatternsInput = input.bool(true, "Render Patterns on TF1", group = "Candlestick Patterns", tooltip = "Default: on. Show native candlestick labels for this layer; raw shape calculations continue.")
renderTf2PatternsInput = input.bool(true, "Render Patterns on TF2", group = "Candlestick Patterns", tooltip = "Default: on. Show native candlestick labels for this layer; raw shape calculations continue.")

// --- Pattern Family Toggles ---
patEngulfingInput = input.bool(true, "Engulfing", group = "Candlestick Patterns", inline = "pat1", tooltip = "Default: on. Show or hide this candlestick family; setup eligibility stays independent.")
patTweezerInput   = input.bool(true, "Tweezer", group = "Candlestick Patterns", inline = "pat1", tooltip = "Default: on. Show or hide this candlestick family; setup eligibility stays independent.")
patSpinningInput  = input.bool(true, "Spinning Top", group = "Candlestick Patterns", inline = "pat2", tooltip = "Default: on. Show or hide this candlestick family; setup eligibility stays independent.")
patMorningInput   = input.bool(true, "Morning Star", group = "Candlestick Patterns", inline = "pat2", tooltip = "Default: on. Show or hide this candlestick family; setup eligibility stays independent.")
patEveningInput   = input.bool(true, "Evening Star", group = "Candlestick Patterns", inline = "pat3", tooltip = "Default: on. Show or hide this candlestick family; setup eligibility stays independent.")
patHammerInput    = input.bool(true, "Hammer / Hanging Man", group = "Candlestick Patterns", inline = "pat3", tooltip = "Default: on. Show or hide this candlestick family; setup eligibility stays independent.")

// The pure shape detectors. Returns an array of 11 booleans.
// Trend context (uptrend/downtrend) from the reference source is stripped out here; it will be
// applied as a gate in Piece 3 (Section 11.3) using TF1-local SMAs or TF2 structural bias.
f_patterns() =>
    [smallBody, longBody, whiteBody, blackBody, isDojiBody, isDoji, spinningShape, hammerShape, hasUpShadow, hasDnShadow, bodyHi, bodyLo, bodyMiddle, bodyAvg] = f_candleCore()
    
    // 1. Bullish Engulfing
    bool p1 = whiteBody and longBody and blackBody[1] and smallBody[1] and close >= open[1] and open <= close[1] and (close > open[1] or open < close[1])
    // 2. Bearish Engulfing
    bool p2 = blackBody and longBody and whiteBody[1] and smallBody[1] and close <= open[1] and open >= close[1] and (close < open[1] or open > close[1])
    
    // 3. Tweezer Top (Reference doji-guard included)
    bool tweezerGuard = not isDojiBody or (hasUpShadow and hasDnShadow)
    bool p3 = tweezerGuard and math.abs(high-high[1]) <= bodyAvg*tweezerToleranceInput/100.0 and whiteBody[1] and blackBody and longBody[1]
    // 4. Tweezer Bottom
    bool p4 = tweezerGuard and math.abs(low-low[1]) <= bodyAvg*tweezerToleranceInput/100.0 and blackBody[1] and whiteBody and longBody[1]
    
    // 5. Spinning Top (Colour-agnostic per TAD 11.1)
    bool p5 = spinningShape
    
    // 6. Morning Star
    bool p6 = longBody[2] and smallBody[1] and longBody and blackBody[2] and bodyHi[1] < bodyLo[2] and whiteBody and bodyHi >= bodyMiddle[2] and bodyHi < bodyHi[2] and bodyHi[1] < bodyLo
    // 7. Morning Doji Star (Overlaps with Morning Star if middle candle is doji, per TAD 11.3 known overlap)
    bool p7 = longBody[2] and isDojiBody[1] and longBody and blackBody[2] and bodyHi[1] < bodyLo[2] and whiteBody and bodyHi >= bodyMiddle[2] and bodyHi < bodyHi[2] and bodyHi[1] < bodyLo
    
    // 8. Evening Star
    bool p8 = longBody[2] and smallBody[1] and longBody and whiteBody[2] and bodyLo[1] > bodyHi[2] and blackBody and bodyLo <= bodyMiddle[2] and bodyLo > bodyLo[2] and bodyLo[1] > bodyHi
    // 9. Evening Doji Star
    bool p9 = longBody[2] and isDojiBody[1] and longBody and whiteBody[2] and bodyLo[1] > bodyHi[2] and blackBody and bodyLo <= bodyMiddle[2] and bodyLo > bodyLo[2] and bodyLo[1] > bodyHi
    
    // 10. Hammer (Shape only)
    bool p10 = hammerShape
    // 11. Hanging Man (Shape only)
    bool p11 = hammerShape
    
        // V2.3 fix: return a single int bitmask instead of an array. Arrays do not reliably cross
    // the request.security boundary -- when the crossing fails it fails silently (na every bar),
    // which made every pattern boolean permanently false with no compile or runtime error.
    // An int is a plain series: the same crossing mechanism Section 4's tuples already use.
    // Bit map: 1=BullEng, 2=BearEng, 4=TweezerTop, 8=TweezerBot, 16=Spin, 32=MorStar,
    // 64=MorDoji, 128=EveStar, 256=EveDoji, 512=Hammer, 1024=HangMan
        // V2.3 fix (CE10005): Pine Script has NO bitwise operators -- the `flags | mask` build can
    // never compile. Arithmetic base-2 encoding uses only addition and ternaries: each pattern
    // contributes its own power-of-two weight, so the sum is a unique 11-bit fingerprint with no
    // bitwise math on either side of the request.security boundary. An int is a plain series --
    // the same proven crossing mechanism Section 4's tuples already use -- which is why this
    // replaced the original array<bool> return that crossed silently as na.
    // Bit map: 1=BullEng, 2=BearEng, 4=TweezerTop, 8=TweezerBot, 16=Spin, 32=MorStar,
    // 64=MorDoji, 128=EveStar, 256=EveDoji, 512=Hammer, 1024=HangMan
    int flags = (p1 ? 1 : 0) + (p2 ? 2 : 0) + (p3 ? 4 : 0) + (p4 ? 8 : 0) + (p5 ? 16 : 0) + (p6 ? 32 : 0) + (p7 ? 64 : 0) + (p8 ? 128 : 0) + (p9 ? 256 : 0) + (p10 ? 512 : 0) + (p11 ? 1024 : 0)
    flags

// Raw flags cross as confirmed native scalars; chart offsets are not applied again.
tf1PatFlags = request.security(syminfo.tickerid, tf1Input, f_patterns()[1], lookahead = barmerge.lookahead_on)
tf2PatFlags = request.security(syminfo.tickerid, tf2Input, f_patterns()[1], lookahead = barmerge.lookahead_on)

// Decode helper with no bitwise operators (Pine has none): for a power-of-two weight m, that bit
// is set in the sum exactly when the remainder of flags divided by 2m is at least m.
// Example: flags = 5 (BullEng + TweezerTop), mask = 4: 5 % 8 = 5 >= 4 -> true. mask = 2: 5 % 4 = 1 >= 2 -> false.
f_bit(int flags, int mask) =>
    (flags % (2 * mask)) >= mask

// TF1 Pattern States (trend-context gate applied later, Section 9E)
bool tf1_BullEng    = f_bit(tf1PatFlags, 1)    and patEngulfingInput
bool tf1_BearEng    = f_bit(tf1PatFlags, 2)    and patEngulfingInput
bool tf1_TweezerTop = f_bit(tf1PatFlags, 4)    and patTweezerInput
bool tf1_TweezerBot = f_bit(tf1PatFlags, 8)    and patTweezerInput
bool tf1_Spinning   = f_bit(tf1PatFlags, 16)   and patSpinningInput
bool tf1_MorStar    = f_bit(tf1PatFlags, 32)   and patMorningInput
bool tf1_MorDoji    = f_bit(tf1PatFlags, 64)   and patMorningInput
bool tf1_EveStar    = f_bit(tf1PatFlags, 128)  and patEveningInput
bool tf1_EveDoji    = f_bit(tf1PatFlags, 256)  and patEveningInput
bool tf1_Hammer     = f_bit(tf1PatFlags, 512)  and patHammerInput
bool tf1_HangMan    = f_bit(tf1PatFlags, 1024) and patHammerInput

// TF2 Pattern States
bool tf2_BullEng    = f_bit(tf2PatFlags, 1)    and patEngulfingInput
bool tf2_BearEng    = f_bit(tf2PatFlags, 2)    and patEngulfingInput
bool tf2_TweezerTop = f_bit(tf2PatFlags, 4)    and patTweezerInput
bool tf2_TweezerBot = f_bit(tf2PatFlags, 8)    and patTweezerInput
bool tf2_Spinning   = f_bit(tf2PatFlags, 16)   and patSpinningInput
bool tf2_MorStar    = f_bit(tf2PatFlags, 32)   and patMorningInput
bool tf2_MorDoji    = f_bit(tf2PatFlags, 64)   and patMorningInput
bool tf2_EveStar    = f_bit(tf2PatFlags, 128)  and patEveningInput
bool tf2_EveDoji    = f_bit(tf2PatFlags, 256)  and patEveningInput
bool tf2_Hammer     = f_bit(tf2PatFlags, 512)  and patHammerInput
bool tf2_HangMan    = f_bit(tf2PatFlags, 1024) and patHammerInput

// =============================================================================================
// SECTION 9E -- CANDLESTICK PATTERNS: TREND CONTEXT (implements TAD V2.2 Section 11.3)
// =============================================================================================
// Piece 3 of the Section 11 delivery: the trend-context gating layer.
// Per TAD V2.2 Section 11.3, TF2 patterns reference TF2's own confirmed structural bias (Section
// 7.2). TF1 patterns reference a separate, TF1-local trend read using the same moving-average
// mechanism the studied reference used (SMA50, stacked SMA50/SMA200, or off).
// This TF1-local read explicitly does NOT feed into the Section 7.2 bias state machine. It exists
// solely as a local gating signal for candlestick pattern labeling on TF1's own chart.

tf1TrendRuleInput    = input.string("Price vs Fast SMA", "TF1 Trend Context Rule", options=["Price vs Fast SMA", "Stacked Fast/Slow SMA", "No detection"], group = "Candlestick Patterns", tooltip = "Default: Price vs Fast SMA. Choose the TF1-local simple-average context used only by candlestick labels; setup eligibility stays independent.")
tf1TrendFastLenInput = input.int(5, "Fast SMA length", minval = 1, group = "Candlestick Patterns", inline = "tf1TrendLens", tooltip = "Default: 5. Set the faster native simple-average length used by TF1 candlestick context.")
tf1TrendSlowLenInput = input.int(20, "Slow SMA length", minval = 1, group = "Candlestick Patterns", inline = "tf1TrendLens", tooltip = "Default: 20. Set the slower native simple-average length used by stacked TF1 candlestick context.")

// Pull TF1 SMAs and Close for local trend calculation, at user-configured lengths
tf1SmaFast = request.security(syminfo.tickerid, tf1Input, ta.sma(close, tf1TrendFastLenInput)[1], lookahead = barmerge.lookahead_on)
tf1SmaSlow = request.security(syminfo.tickerid, tf1Input, ta.sma(close, tf1TrendSlowLenInput)[1], lookahead = barmerge.lookahead_on)
tf1Close   = request.security(syminfo.tickerid, tf1Input, close[1], lookahead = barmerge.lookahead_on)

// Calculate TF1 Local Trend Context
bool tf1_LocalUpTrend = false
bool tf1_LocalDownTrend = false

if tf1TrendRuleInput == "Price vs Fast SMA"
    tf1_LocalUpTrend := tf1Close > tf1SmaFast
    tf1_LocalDownTrend := tf1Close < tf1SmaFast
else if tf1TrendRuleInput == "Stacked Fast/Slow SMA"
    tf1_LocalUpTrend := tf1Close > tf1SmaFast and tf1SmaFast > tf1SmaSlow
    tf1_LocalDownTrend := tf1Close < tf1SmaFast and tf1SmaFast < tf1SmaSlow
else // "No detection"
    tf1_LocalUpTrend := true
    tf1_LocalDownTrend := true

// Calculate TF2 Structural Trend Context (from Section 7.2 bias state machine)
// If bias is "undefined", neither is true, meaning TF2 patterns won't fire until structure is established.
bool tf2_LocalUpTrend = (biasBeforeClose == "bullish")
bool tf2_LocalDownTrend = (biasBeforeClose == "bearish")

// Apply Trend Context Gates to Pattern Detections to produce the final filtered states
// TF1 Patterns
bool final_tf1_BullEng    = tf1_BullEng    and tf1_LocalDownTrend // Bullish Engulfing happens in downtrend
bool final_tf1_BearEng    = tf1_BearEng    and tf1_LocalUpTrend   // Bearish Engulfing happens in uptrend
bool final_tf1_TweezerTop = tf1_TweezerTop and tf1_LocalUpTrend
bool final_tf1_TweezerBot = tf1_TweezerBot and tf1_LocalDownTrend
bool final_tf1_Spinning   = tf1_Spinning   and (tf1_LocalUpTrend or tf1_LocalDownTrend) // Trend agnostic
bool final_tf1_MorStar    = tf1_MorStar    and tf1_LocalDownTrend
bool final_tf1_MorDoji    = tf1_MorDoji    and tf1_LocalDownTrend
bool final_tf1_EveStar    = tf1_EveStar    and tf1_LocalUpTrend
bool final_tf1_EveDoji    = tf1_EveDoji    and tf1_LocalUpTrend
bool final_tf1_Hammer     = tf1_Hammer     and tf1_LocalDownTrend
bool final_tf1_HangMan    = tf1_HangMan    and tf1_LocalUpTrend

// TF2 Patterns
bool final_tf2_BullEng    = tf2_BullEng    and tf2_LocalDownTrend
bool final_tf2_BearEng    = tf2_BearEng    and tf2_LocalUpTrend
bool final_tf2_TweezerTop = tf2_TweezerTop and tf2_LocalUpTrend
bool final_tf2_TweezerBot = tf2_TweezerBot and tf2_LocalDownTrend
bool final_tf2_Spinning   = tf2_Spinning   and (tf2_LocalUpTrend or tf2_LocalDownTrend) // Trend agnostic
bool final_tf2_MorStar    = tf2_MorStar    and tf2_LocalDownTrend
bool final_tf2_MorDoji    = tf2_MorDoji    and tf2_LocalDownTrend
bool final_tf2_EveStar    = tf2_EveStar    and tf2_LocalUpTrend
bool final_tf2_EveDoji    = tf2_EveDoji    and tf2_LocalUpTrend
bool final_tf2_Hammer     = tf2_Hammer     and tf2_LocalDownTrend
bool final_tf2_HangMan    = tf2_HangMan    and tf2_LocalUpTrend

// =============================================================================================
// SECTION 9F -- CANDLESTICK PATTERNS: RENDERING, STAMPS & BOUNDED LIFETIME
// (implements TAD V2.2 Sections 11.4 & 11.5)
// =============================================================================================
// Piece 4 of the Section 11 delivery: turns the gated detection states from Section 9E into
// chart markers, with the two constraints this module was explicitly warned about.
//
// WHY LABELS, NOT PLOTSHAPE (trading + mechanical rationale): a pattern marker belongs to the
// historical candle that formed it, forever. plotshape can only draw on the bar currently being
// computed, so it can never place a marker back onto a past candle -- this project already paid
// for that lesson once with the Critical Swing markers. label.new with xloc.bar_time stamps the
// marker at the pattern candle's own opening timestamp, where it stays correct across every
// timeframe switch and zoom level.
//
// WHY STAMPS + REDRAW (mechanical rationale): detection records a PatternMark stamp (time, price,
// code, direction) the moment a pattern fires, with no drawing object attached (id = na). The
// render pass below creates the label from the stamp on demand. That separation is what makes
// every toggle reversible without a chart reload: switching a gate off deletes the label objects
// but keeps the stamps; switching it back on redraws from stored stamps instantly. Abandoning
// objects instead of deleting them, or deleting the underlying records, are the two failure
// classes this system has already been bitten by -- neither is repeated here.
//
// WHY A RETAINED-COUNT CAP (TAD 11.5, mandatory): pattern labels draw against the same shared,
// finite 500-label budget as Critical Swing markers, session range labels, and divider labels.
// Unmanaged, a long-running chart would silently exhaust that budget and starve every other
// label consumer with no visible error. Each layer's stamp array is therefore capped by input,
// oldest-first, deleting the evicted stamp's label along with it.

patternLabelKeepInput = input.int(25, "Retained pattern labels (per layer)", minval = 1, maxval = 250, group = "Candlestick Patterns", tooltip = "Default: 25. Keep this many pattern labels per timeframe layer; older labels are deleted.")
patternLabelSizeInput = input.string("Tiny", "Pattern label size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = "Candlestick Patterns", tooltip = "Default: Tiny. Choose the size of this display text.")
patternBullColor      = input.color(#26a69a, "Bullish pattern color", group = "Candlestick Patterns", inline = "patColors", tooltip = "Default: #26a69a placeholder. Choose the color and transparency of bullish pattern color; calculations stay unchanged.")
patternBearColor      = input.color(#ef5350, "Bearish pattern color", group = "Candlestick Patterns", inline = "patColors", tooltip = "Default: #ef5350 placeholder. Choose the color and transparency of bearish pattern color; calculations stay unchanged.")
patternNeutralColor   = input.color(#787B86, "Neutral pattern color", group = "Candlestick Patterns", inline = "patColors", tooltip = "Default: #787B86 placeholder. Choose the color and transparency of neutral pattern color; calculations stay unchanged.")

var patternLabelSize = switch patternLabelSizeInput
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge

// One recorded pattern event. t = the pattern candle's own opening timestamp (anchor), y = the
// placement price, code = short marker text, dir = "bull" | "bear" | "neutral", id = the label
// handle (na while hidden). Keeping the handle on the stamp gives it the stamp's exact lifecycle.
type PatternMark
    int    t
    float  y
    string code
    string dir
    label  id

var array<PatternMark> patMarksTf1 = array.new<PatternMark>()
var array<PatternMark> patMarksTf2 = array.new<PatternMark>()

// Records a detection and enforces the retained-count cap in the same act: evicting the oldest
// stamp deletes its label too, so the drawing-object budget and the stamp array can never drift
// apart in size.
f_pushPatMark(array<PatternMark> arr, int t, float y, string code, string dir) =>
    array.push(arr, PatternMark.new(t = t, y = y, code = code, dir = dir, id = na))
    while array.size(arr) > patternLabelKeepInput
        oldMark = array.shift(arr)
        if not na(oldMark.id)
            label.delete(oldMark.id)
    true

// TF2 candle extremes, needed only for marker placement on the TF2 layer (the TF1 layer reuses
// Section 4's existing tf1H/tf1L pulls). [1] inside the security context is the just-closed TF2
// candle at the roll-detection bar, matching Section 4's proven data-integrity convention.
[tf2CandleHigh, tf2CandleLow] = request.security(syminfo.tickerid, tf2Input, [high[1], low[1]], lookahead = barmerge.lookahead_on)

// --- 9F-a. Detection: record stamps at each timeframe's roll bar ---
// Detection runs regardless of any render gate: stamps are the record of what happened, gates
// only decide what is currently drawn. newTf1Bar/newTf2Bar (Sections 7/8) fire exactly once per
// higher-timeframe candle close.
// V3 correction: confirmed flags, OHLC and origin time refer to the SAME native candle.
if newTf1Bar and not na(tf1ClosedT)
    bullOff1 = tf1L * 0.0015
    bearOff1 = tf1H * 0.0015
    if final_tf1_BullEng
        f_pushPatMark(patMarksTf1, tf1ClosedT, tf1L - bullOff1, "ENG", "bull")
    if final_tf1_BearEng
        f_pushPatMark(patMarksTf1, tf1ClosedT, tf1H + bearOff1, "ENG", "bear")
    if final_tf1_TweezerBot
        f_pushPatMark(patMarksTf1, tf1ClosedT, tf1L - bullOff1, "TWZ", "bull")
    if final_tf1_TweezerTop
        f_pushPatMark(patMarksTf1, tf1ClosedT, tf1H + bearOff1, "TWZ", "bear")
    if final_tf1_MorStar
        f_pushPatMark(patMarksTf1, tf1ClosedT, tf1L - bullOff1, "MST", "bull")
    if final_tf1_MorDoji
        f_pushPatMark(patMarksTf1, tf1ClosedT, tf1L - bullOff1, "MDS", "bull")
    if final_tf1_EveStar
        f_pushPatMark(patMarksTf1, tf1ClosedT, tf1H + bearOff1, "EST", "bear")
    if final_tf1_EveDoji
        f_pushPatMark(patMarksTf1, tf1ClosedT, tf1H + bearOff1, "EDS", "bear")
    if final_tf1_Hammer
        f_pushPatMark(patMarksTf1, tf1ClosedT, tf1L - bullOff1, "HAM", "bull")
    if final_tf1_HangMan
        f_pushPatMark(patMarksTf1, tf1ClosedT, tf1H + bearOff1, "HGM", "bear")
    if final_tf1_Spinning
        f_pushPatMark(patMarksTf1, tf1ClosedT, tf1L - bullOff1, "SPN", "neutral")

if newTf2Bar and not na(tf2ClosedT)
    bullOff2 = tf2CandleLow * 0.0015
    bearOff2 = tf2CandleHigh * 0.0015
    if final_tf2_BullEng
        f_pushPatMark(patMarksTf2, tf2ClosedT, tf2CandleLow - bullOff2, "ENG", "bull")
    if final_tf2_BearEng
        f_pushPatMark(patMarksTf2, tf2ClosedT, tf2CandleHigh + bearOff2, "ENG", "bear")
    if final_tf2_TweezerBot
        f_pushPatMark(patMarksTf2, tf2ClosedT, tf2CandleLow - bullOff2, "TWZ", "bull")
    if final_tf2_TweezerTop
        f_pushPatMark(patMarksTf2, tf2ClosedT, tf2CandleHigh + bearOff2, "TWZ", "bear")
    if final_tf2_MorStar
        f_pushPatMark(patMarksTf2, tf2ClosedT, tf2CandleLow - bullOff2, "MST", "bull")
    if final_tf2_MorDoji
        f_pushPatMark(patMarksTf2, tf2ClosedT, tf2CandleLow - bullOff2, "MDS", "bull")
    if final_tf2_EveStar
        f_pushPatMark(patMarksTf2, tf2ClosedT, tf2CandleHigh + bearOff2, "EST", "bear")
    if final_tf2_EveDoji
        f_pushPatMark(patMarksTf2, tf2ClosedT, tf2CandleHigh + bearOff2, "EDS", "bear")
    if final_tf2_Hammer
        f_pushPatMark(patMarksTf2, tf2ClosedT, tf2CandleLow - bullOff2, "HAM", "bull")
    if final_tf2_HangMan
        f_pushPatMark(patMarksTf2, tf2ClosedT, tf2CandleHigh + bearOff2, "HGM", "bear")
    if final_tf2_Spinning
        f_pushPatMark(patMarksTf2, tf2ClosedT, tf2CandleLow - bullOff2, "SPN", "neutral")

// --- 9F-b. Render pass: gates, creation, and explicit hiding ---
// Gate composition: the layer's own dynamic visibility gate (showTf1/showTf2 -- a Weekly pattern
// marker on a Monthly chart is meaningless, same principle as every other level here) AND the
// module's master render toggle for that layer (Section 11.4). Per-pattern family toggles were
// already applied upstream in Sections 9D/9E.
drawTf1Pats = showTf1 and renderTf1PatternsInput
drawTf2Pats = showTf2 and renderTf2PatternsInput

f_patColor(dir) =>
    dir == "bull" ? patternBullColor : dir == "bear" ? patternBearColor : patternNeutralColor

f_patStyle(dir) =>
    dir == "bear" ? label.style_label_down : label.style_label_up

if drawTf1Pats
    for m in patMarksTf1
        if na(m.id)
            m.id := label.new(x = m.t, y = m.y, text = m.code, xloc = xloc.bar_time, yloc = yloc.price, style = f_patStyle(m.dir), color = f_patColor(m.dir), textcolor = color.white, size = patternLabelSize)
        else
            // Colour refreshed every bar so input changes restyle existing markers live, matching
            // how TF2 structure lines behave.
            label.set_color(m.id, f_patColor(m.dir))
else
    // Gate closed: delete the objects, KEEP the stamps. Reopening the gate (or switching back
    // down to a valid TF3) redraws every retained marker from its stamp on the next bar.
    for m in patMarksTf1
        if not na(m.id)
            label.delete(m.id)
            m.id := na

if drawTf2Pats
    for m in patMarksTf2
        if na(m.id)
            m.id := label.new(x = m.t, y = m.y, text = m.code, xloc = xloc.bar_time, yloc = yloc.price, style = f_patStyle(m.dir), color = f_patColor(m.dir), textcolor = color.white, size = patternLabelSize)
        else
            label.set_color(m.id, f_patColor(m.dir))
else
    for m in patMarksTf2
        if not na(m.id)
            label.delete(m.id)
            m.id := na

// =============================================================================================
// SECTION 10 -- SESSIONS: CONSTANTS & INPUTS
// =============================================================================================
// Adapted from "Sessions [LuxAlgo]" (c) LuxAlgo, CC BY-NC-SA 4.0. Constants, inputs, and
// tooltips below are unchanged from the original -- no identifier in this section collided with
// anything in Sections 1-9, so nothing needed renaming.
color BULL_COLOR         = #089981
color BEAR_COLOR         = #f23645
color DATA               = #DBDBDB
color HEADERS            = #808080
color BACKGROUND         = #161616
color BORDERS            = #2E2E2E

string TOP_RIGHT         = "Top Right"
string BOTTOM_RIGHT      = "Bottom Right"
string BOTTOM_LEFT       = "Bottom Left"

string TINY              = "Tiny"
string SMALL             = "Small"
string NORMAL            = "Normal"
string LARGE             = "Large"
string HUGE              = "Huge"

string SESSION_A_GROUP   = "Session A"
string SESSION_B_GROUP   = "Session B"
string SESSION_C_GROUP   = "Session C"
string SESSION_D_GROUP   = "Session D"
string TIMEZONE_GROUP    = "Timezone"
string RANGES_GROUP      = "Ranges Settings"
string STYLE_GROUP       = "Style"
string DASHBOARD_GROUP   = "Dashboard"
string DIVIDERS_GROUP    = "Dividers"

string showSessionTooltip        = "Enable or disable this session and all of its optional displays."
string sessionNameTooltip        = "Set the name displayed for this session."
string sessionTimeTooltip        = "Set the session's start and end times."
string sessionRangeTooltip       = "Draw a box around the high-to-low range formed during the session."
string sessionTrendlineTooltip   = "Draw a linear-regression trendline during the session."
string sessionMeanTooltip        = "Draw the running arithmetic mean during the session."
string sessionVwapTooltip        = "Plot the running volume-weighted average price during the session."
string sessionMaxMinTooltip      = "Extend the completed session's maximum and minimum until the next session begins."
string sessionColorTooltip       = "Select the color used for this session's visuals."
string timezoneOffsetTooltip     = "Set the fixed UTC offset used to interpret all session times."
string exchangeTimezoneTooltip   = "Use the symbol's exchange timezone instead of the fixed UTC offset."
string rangeTransparencyTooltip  = "Set the transparency of session range boxes from 0 (opaque) to 100 (invisible)."
string rangeOutlineTooltip       = "Show a dotted outline around each session range box."
string rangeLabelTooltip         = "Show the session name above each range box."
string dashboardTooltip          = "Enable or disable the dashboard."
string advancedDashboardTooltip  = "Add trend, cumulative volume, and volatility statistics to the dashboard."
string dashboardPositionTooltip  = "Select the dashboard location."
string dashboardSizeTooltip      = "Select the dashboard text size."
string sessionDividerTooltip     = "Mark active session bars and session boundaries along the bottom of the chart."
string dayDividerTooltip         = "Draw a dashed divider and weekday label when a new day begins."

bool showSessionAInput       = input.bool(true, "Enable", group = SESSION_A_GROUP, inline = "sessionA", tooltip = "Default: on. Enable this session display on charts of 30 minutes or less.")
string sessionANameInput     = input.string("New York", "Name", group = SESSION_A_GROUP, inline = "sessionA", tooltip = "Default: New York. Rename this session on its boxes and dashboard; the name does not set its timezone.")
string sessionATimeInput     = input.session("1300-2200", "Hours", group = SESSION_A_GROUP, tooltip = "Default: 1300-2200. Set the session hours in the configured Sessions timezone; overnight hours are supported.")
bool sessionARangeInput      = input.bool(true, "Range", group = SESSION_A_GROUP, inline = "sessionAOverlays", tooltip = "Default: on. Show the running session high-to-low box.")
bool sessionATrendlineInput  = input.bool(false, "Trendline", group = SESSION_A_GROUP, inline = "sessionAOverlays", tooltip = "Default: off. Show a fitted line through the session closing prices.")
bool sessionAMeanInput       = input.bool(false, "Mean", group = SESSION_A_GROUP, inline = "sessionAOverlays", tooltip = "Default: off. Show the average closing price during this session.")
bool sessionAVwapInput       = input.bool(false, "VWAP", group = SESSION_A_GROUP, inline = "sessionAOverlays", tooltip = "Default: off. Show the volume-weighted closing price during this session.")
bool sessionAMaxMinInput     = input.bool(false, "Max/Min", group = SESSION_A_GROUP, inline = "sessionAOverlays", tooltip = "Default: off. Extend the completed session highest and lowest prices.")

bool showSessionBInput       = input.bool(true, "Enable", group = SESSION_B_GROUP, inline = "sessionB", tooltip = "Default: on. Enable this session display on charts of 30 minutes or less.")
string sessionBNameInput     = input.string("London", "Name", group = SESSION_B_GROUP, inline = "sessionB", tooltip = "Default: London. Rename this session on its boxes and dashboard; the name does not set its timezone.")
string sessionBTimeInput     = input.session("0700-1600", "Hours", group = SESSION_B_GROUP, tooltip = "Default: 0700-1600. Set the session hours in the configured Sessions timezone; overnight hours are supported.")
bool sessionBRangeInput      = input.bool(true, "Range", group = SESSION_B_GROUP, inline = "sessionBOverlays", tooltip = "Default: on. Show the running session high-to-low box.")
bool sessionBTrendlineInput  = input.bool(false, "Trendline", group = SESSION_B_GROUP, inline = "sessionBOverlays", tooltip = "Default: off. Show a fitted line through the session closing prices.")
bool sessionBMeanInput       = input.bool(false, "Mean", group = SESSION_B_GROUP, inline = "sessionBOverlays", tooltip = "Default: off. Show the average closing price during this session.")
bool sessionBVwapInput       = input.bool(false, "VWAP", group = SESSION_B_GROUP, inline = "sessionBOverlays", tooltip = "Default: off. Show the volume-weighted closing price during this session.")
bool sessionBMaxMinInput     = input.bool(false, "Max/Min", group = SESSION_B_GROUP, inline = "sessionBOverlays", tooltip = "Default: off. Extend the completed session highest and lowest prices.")

bool showSessionCInput       = input.bool(true, "Enable", group = SESSION_C_GROUP, inline = "sessionC", tooltip = "Default: on. Enable this session display on charts of 30 minutes or less.")
string sessionCNameInput     = input.string("Tokyo", "Name", group = SESSION_C_GROUP, inline = "sessionC", tooltip = "Default: Tokyo. Rename this session on its boxes and dashboard; the name does not set its timezone.")
string sessionCTimeInput     = input.session("0000-0900", "Hours", group = SESSION_C_GROUP, tooltip = "Default: 0000-0900. Set the session hours in the configured Sessions timezone; overnight hours are supported.")
bool sessionCRangeInput      = input.bool(true, "Range", group = SESSION_C_GROUP, inline = "sessionCOverlays", tooltip = "Default: on. Show the running session high-to-low box.")
bool sessionCTrendlineInput  = input.bool(false, "Trendline", group = SESSION_C_GROUP, inline = "sessionCOverlays", tooltip = "Default: off. Show a fitted line through the session closing prices.")
bool sessionCMeanInput       = input.bool(false, "Mean", group = SESSION_C_GROUP, inline = "sessionCOverlays", tooltip = "Default: off. Show the average closing price during this session.")
bool sessionCVwapInput       = input.bool(false, "VWAP", group = SESSION_C_GROUP, inline = "sessionCOverlays", tooltip = "Default: off. Show the volume-weighted closing price during this session.")
bool sessionCMaxMinInput     = input.bool(false, "Max/Min", group = SESSION_C_GROUP, inline = "sessionCOverlays", tooltip = "Default: off. Extend the completed session highest and lowest prices.")

bool showSessionDInput       = input.bool(true, "Enable", group = SESSION_D_GROUP, inline = "sessionD", tooltip = "Default: on. Enable this session display on charts of 30 minutes or less.")
string sessionDNameInput     = input.string("Sydney", "Name", group = SESSION_D_GROUP, inline = "sessionD", tooltip = "Default: Sydney. Rename this session on its boxes and dashboard; the name does not set its timezone.")
string sessionDTimeInput     = input.session("2100-0600", "Hours", group = SESSION_D_GROUP, tooltip = "Default: 2100-0600. Set the session hours in the configured Sessions timezone; overnight hours are supported.")
bool sessionDRangeInput      = input.bool(true, "Range", group = SESSION_D_GROUP, inline = "sessionDOverlays", tooltip = "Default: on. Show the running session high-to-low box.")
bool sessionDTrendlineInput  = input.bool(false, "Trendline", group = SESSION_D_GROUP, inline = "sessionDOverlays", tooltip = "Default: off. Show a fitted line through the session closing prices.")
bool sessionDMeanInput       = input.bool(false, "Mean", group = SESSION_D_GROUP, inline = "sessionDOverlays", tooltip = "Default: off. Show the average closing price during this session.")
bool sessionDVwapInput       = input.bool(false, "VWAP", group = SESSION_D_GROUP, inline = "sessionDOverlays", tooltip = "Default: off. Show the volume-weighted closing price during this session.")
bool sessionDMaxMinInput     = input.bool(false, "Max/Min", group = SESSION_D_GROUP, inline = "sessionDOverlays", tooltip = "Default: off. Extend the completed session highest and lowest prices.")

int timezoneOffsetInput       = input.int(0, "UTC (+/-)", group = TIMEZONE_GROUP, minval = -12, maxval = 14, tooltip = "Default: 0. Set the fixed UTC offset used by Sessions; city names do not automatically adjust for daylight saving.")
bool useExchangeTimezoneInput = input.bool(false, "Use Exchange Timezone", group = TIMEZONE_GROUP, tooltip = "Default: off. Use the symbol exchange timezone for Sessions; turn off to use the fixed UTC offset.")

// --- Period Dividers (new -- replaces the old, LuxAlgo-inherited "Show Daily Divider") ---
// Declared here, immediately after Timezone, purely for settings-panel ordering: TradingView lays
// input groups out in the order their first input is declared, so this is what puts Dividers
// directly beneath Timezone in the panel.
//
// The old Daily Divider silently never rendered above 30-minute charts, because it was gated by
// sessionsTimeframeOk -- a cutoff that exists for genuinely intraday session shading and was never
// appropriate for period dividers. Nothing below is gated by it.
string DIVIDERS_NEW_GROUP = "Period Dividers"
bool showDiv4hInput      = input.bool(false, "4 Hour", group = DIVIDERS_NEW_GROUP, inline = "divToggles1", tooltip = "Default: off. Show boundaries and optional names for this period when the chart timeframe is lower.")
bool showDivDailyInput   = input.bool(true, "Daily", group = DIVIDERS_NEW_GROUP, inline = "divToggles1", tooltip = "Default: on. Show boundaries and optional names for this period when the chart timeframe is lower.")
bool showDivWeeklyInput  = input.bool(false, "Weekly", group = DIVIDERS_NEW_GROUP, inline = "divToggles1", tooltip = "Default: off. Show boundaries and optional names for this period when the chart timeframe is lower.")
bool showDivMonthlyInput = input.bool(false, "Monthly", group = DIVIDERS_NEW_GROUP, inline = "divToggles2", tooltip = "Default: off. Show boundaries and optional names for this period when the chart timeframe is lower.")
bool showDivQuarterInput = input.bool(false, "Quarterly", group = DIVIDERS_NEW_GROUP, inline = "divToggles2", tooltip = "Default: off. Show boundaries and optional names for this period when the chart timeframe is lower.")
int  dividerLookbackInput = input.int(20, "Lookback (how many to keep)", minval = 1, maxval = 200, group = DIVIDERS_NEW_GROUP, tooltip = "Default: 20. Keep this many boundaries for each enabled period; larger counts use more drawing space.")
int  dividerOpacityInput  = input.int(25, "Opacity %", minval = 0, maxval = 100, group = DIVIDERS_NEW_GROUP, tooltip = "Default: 25. Increase line and label visibility; zero hides them and 100 gives full color.")
color dividerColorInput   = input.color(#787B86, "Colour", group = DIVIDERS_NEW_GROUP, inline = "divStyle", tooltip = "Default: #787B86 placeholder. Choose the color and transparency of colour; calculations stay unchanged.")
string dividerLabelPosInput = input.string("Top", "Label", options = ["Top", "Bottom", "None"], group = DIVIDERS_NEW_GROUP, inline = "divStyle", tooltip = "Default: Top. Choose top or bottom period names; None hides the names.")

int rangeTransparencyInput   = input.int(90, "Range Area Transparency", group = RANGES_GROUP, minval = 0, maxval = 100, tooltip = "Default: 90. Make session range shading more transparent as this value increases.")
bool showRangeOutlineInput   = input.bool(true, "Range Outline", group = RANGES_GROUP, tooltip = "Default: on. Show borders around session ranges.")
bool showRangeLabelInput     = input.bool(true, "Range Label", group = RANGES_GROUP, tooltip = "Default: on. Show names on session range boxes.")
int sessionRangeKeepInput = input.int(60, "Retained completed ranges", group = RANGES_GROUP, minval = 1, maxval = 500, tooltip = "Default: 60. Keep this many completed session boxes and names; older objects are deleted.")
int sessionLineKeepInput  = input.int(60, "Retained completed trend/mean lines", group = RANGES_GROUP, minval = 1, maxval = 500, tooltip = "Default: 60. Keep this many completed session trend and mean lines; older objects are deleted.")

color sessionAColorInput     = input.color(#ff5d00, "New York", group = STYLE_GROUP, inline = "sessionColors", tooltip = "Default: #ff5d00 placeholder. Choose the color and transparency of new york; calculations stay unchanged.")
color sessionBColorInput     = input.color(#2157f3, "London", group = STYLE_GROUP, inline = "sessionColors", tooltip = "Default: #2157f3 placeholder. Choose the color and transparency of london; calculations stay unchanged.")
color sessionCColorInput     = input.color(#e91e63, "Tokyo", group = STYLE_GROUP, inline = "sessionColors2", tooltip = "Default: #e91e63 placeholder. Choose the color and transparency of tokyo; calculations stay unchanged.")
color sessionDColorInput     = input.color(#ffeb3b, "Sydney", group = STYLE_GROUP, inline = "sessionColors2", tooltip = "Default: #ffeb3b placeholder. Choose the color and transparency of sydney; calculations stay unchanged.")

bool dashboardInput          = input.bool(false, "Dashboard", group = DASHBOARD_GROUP, tooltip = "Default: off. Show the separate Sessions dashboard.")
bool advancedDashboardInput  = input.bool(false, "Advanced", group = DASHBOARD_GROUP, tooltip = "Default: off. Include session volume, variation and trend measurements in the dashboard.")
string dashboardPositionInput = input.string(TOP_RIGHT, "Position", group = DASHBOARD_GROUP, options = [TOP_RIGHT, BOTTOM_RIGHT, BOTTOM_LEFT], tooltip = "Default: top right. Choose the corner used by the separate Sessions dashboard.")
string dashboardSizeInput     = input.string(SMALL, "Size", group = DASHBOARD_GROUP, options = [TINY, SMALL, NORMAL, LARGE, HUGE], tooltip = "Default: small. Choose the Sessions dashboard text size.")

bool showSessionDividerInput = input.bool(false, "Show Sessions Divider", group = DIVIDERS_NEW_GROUP, tooltip = "Default: off. Mark session boundaries on charts of 30 minutes or less.")

// =============================================================================================
// SECTION 11 -- SESSIONS: TIMEFRAME-ACCURACY GATE (new)
// =============================================================================================
// You previously enforced ">30min only" via this indicator's own Visibility tab. Now that one
// Visibility tab covers this whole merged script, that native toggle can't apply to only the
// Sessions half without also hiding TF1/TF2 above 30min -- so the same cutoff is reproduced here
// in code instead, and applied everywhere the original checked showSessionX/showSessionDivider.
// Hardcoded at 30 minutes to match what you had; trivial to change if you want a different cutoff.
sessionsTimeframeOk = timeframe.in_seconds() <= timeframe.in_seconds("30")

bool effectiveShowSessionA = showSessionAInput and sessionsTimeframeOk
bool effectiveShowSessionB = showSessionBInput and sessionsTimeframeOk
bool effectiveShowSessionC = showSessionCInput and sessionsTimeframeOk
bool effectiveShowSessionD = showSessionDInput and sessionsTimeframeOk
bool effectiveShowSessionDivider = showSessionDividerInput and sessionsTimeframeOk

// =============================================================================================
// SECTION 12 -- SESSIONS: PARSED SETTINGS
// =============================================================================================
var parsedDashboardPosition = switch dashboardPositionInput
    TOP_RIGHT    => position.top_right
    BOTTOM_RIGHT => position.bottom_right
    BOTTOM_LEFT  => position.bottom_left

var parsedDashboardSize = switch dashboardSizeInput
    TINY   => size.tiny
    SMALL  => size.small
    NORMAL => size.normal
    LARGE  => size.large
    HUGE   => size.huge

string sessionTimezone = useExchangeTimezoneInput ? syminfo.timezone : str.format("UTC{0}{1}", timezoneOffsetInput >= 0 ? "+" : "-", math.abs(timezoneOffsetInput))
int barNumber = bar_index

// =============================================================================================
// SECTION 13 -- SESSIONS: HELPER FUNCTIONS
// =============================================================================================
cell(table tableId, int column, int row, string data, color textColor = #DBDBDB, string alignment = text.align_right, color background = na, float height = 0.0) =>
    tableId.cell(column, row, data, text_color = textColor, text_size = parsedDashboardSize, text_halign = alignment, bgcolor = background, height = height)

divider(table tableId, int row, int lastColumn) =>
    string rowDivider = "━━━━━━━━━━━━━━"
    tableId.merge_cells(0, row, lastColumn, row)
    cell(tableId, 0, row, rowDivider, textColor = BORDERS, alignment = text.align_center, height = 0.5)


// =============================================================================================
// SECTION 14 -- SESSIONS: SESSION DETECTION
// =============================================================================================
bool sessionAActive = not na(time(timeframe.period, sessionATimeInput, sessionTimezone))
bool sessionBActive = not na(time(timeframe.period, sessionBTimeInput, sessionTimezone))
bool sessionCActive = not na(time(timeframe.period, sessionCTimeInput, sessionTimezone))
bool sessionDActive = not na(time(timeframe.period, sessionDTimeInput, sessionTimezone))

// =============================================================================================
// SECTION 15 -- SESSIONS: DASHBOARD
// =============================================================================================
int dashboardColumnCount = advancedDashboardInput ? 5 : 2
int dashboardLastColumn = dashboardColumnCount - 1
var table dashboardTable = table.new(parsedDashboardPosition, dashboardColumnCount, 7, bgcolor = BACKGROUND, border_width = 0, frame_color = BORDERS, frame_width = 1, force_overlay = true)

if barstate.isfirst and dashboardInput and sessionsTimeframeOk
    dashboardTable.merge_cells(0, 0, dashboardLastColumn, 0)
    cell(dashboardTable, 0, 0, "Sessions [LuxAlgo]", textColor = DATA, alignment = text.align_center)
    divider(dashboardTable, 1, dashboardLastColumn)
    cell(dashboardTable, 0, 2, "Session", textColor = HEADERS, alignment = text.align_left)
    cell(dashboardTable, 1, 2, "Status", textColor = HEADERS)

    if advancedDashboardInput
        cell(dashboardTable, 2, 2, "Trend", textColor = HEADERS)
        cell(dashboardTable, 3, 2, "Volume", textColor = HEADERS)
        cell(dashboardTable, 4, 2, "σ", textColor = HEADERS)

    cell(dashboardTable, 0, 3, sessionANameInput, textColor = sessionAColorInput, alignment = text.align_left)
    cell(dashboardTable, 0, 4, sessionBNameInput, textColor = sessionBColorInput, alignment = text.align_left)
    cell(dashboardTable, 0, 5, sessionCNameInput, textColor = sessionCColorInput, alignment = text.align_left)
    cell(dashboardTable, 0, 6, sessionDNameInput, textColor = sessionDColorInput, alignment = text.align_left)

if barstate.islast and dashboardInput and sessionsTimeframeOk
    string sessionAStatus = effectiveShowSessionA ? (sessionAActive ? "Active" : "Inactive") : "Disabled"
    string sessionBStatus = effectiveShowSessionB ? (sessionBActive ? "Active" : "Inactive") : "Disabled"
    string sessionCStatus = effectiveShowSessionC ? (sessionCActive ? "Active" : "Inactive") : "Disabled"
    string sessionDStatus = effectiveShowSessionD ? (sessionDActive ? "Active" : "Inactive") : "Disabled"

    color sessionAStatusColor = effectiveShowSessionA ? (sessionAActive ? BULL_COLOR : BEAR_COLOR) : HEADERS
    color sessionBStatusColor = effectiveShowSessionB ? (sessionBActive ? BULL_COLOR : BEAR_COLOR) : HEADERS
    color sessionCStatusColor = effectiveShowSessionC ? (sessionCActive ? BULL_COLOR : BEAR_COLOR) : HEADERS
    color sessionDStatusColor = effectiveShowSessionD ? (sessionDActive ? BULL_COLOR : BEAR_COLOR) : HEADERS

    cell(dashboardTable, 1, 3, sessionAStatus, textColor = DATA, background = sessionAStatusColor)
    cell(dashboardTable, 1, 4, sessionBStatus, textColor = DATA, background = sessionBStatusColor)
    cell(dashboardTable, 1, 5, sessionCStatus, textColor = DATA, background = sessionCStatusColor)
    cell(dashboardTable, 1, 6, sessionDStatus, textColor = DATA, background = sessionDStatusColor)

// =============================================================================================
// SECTION 16 -- SESSIONS: PER-SESSION STATE ENGINE (rebuilt, V2.3)
// =============================================================================================
// Why rebuilt rather than patched: the inherited helpers kept running state in function-local
// `var` variables. Explicit per-session slots make ownership and retirement unambiguous.
// Four sessions sharing one accumulator set meant (a) overlapping sessions overwrote each other's
// range boxes, means, VWAPs and regressions mid-bar, and (b) every session start orphaned the
// previous box/label/line handles -- they could never be deleted, so the first history replay at
// or below 30 minutes (where sessionsTimeframeOk opens the gate) drove straight through Pine's
// 500-per-type drawing-object cap. Each session now owns slot 0..3 in explicit state arrays, and
// every finished drawing object has a bounded lifetime: retiring into a capped history array with
// oldest-first deletion, the same discipline the TAD's Bounded Lifetime principle demands.

bool calculateAdvancedDashboard = dashboardInput and advancedDashboardInput and sessionsTimeframeOk

// Plot-feed globals keep their inherited names so Section 17's plots stay byte-identical.
var float sessionAMaximum = na
var float sessionAMinimum = na
var float sessionBMaximum = na
var float sessionBMinimum = na
var float sessionCMaximum = na
var float sessionCMinimum = na
var float sessionDMaximum = na
var float sessionDMinimum = na
var float sessionAVwap = na
var float sessionBVwap = na
var float sessionCVwap = na
var float sessionDVwap = na

// --- 16a. Per-session running state: one slot per session, never shared between them ---
var array<int>   sessStart  = array.new<int>(4, 0)
var array<float> sessHigh   = array.new<float>(4, na)
var array<float> sessLow    = array.new<float>(4, na)
var array<box>   sessBox    = array.new<box>(4, na)
var array<label> sessLbl    = array.new<label>(4, na)
var array<line>  sessTrend  = array.new<line>(4, na)
var array<line>  sessMeanLn = array.new<line>(4, na)
var array<int>   sessLen    = array.new<int>(4, 0)      // regression bar count
var array<int>   sessLenM   = array.new<int>(4, 0)      // mean bar count (independent: the two
                                                         // features can be toggled separately)
var array<float> sessCumC   = array.new<float>(4, na)   // regression: sum of closes
var array<float> sessCumSq  = array.new<float>(4, na)   // regression: sum of squared closes
var array<float> sessCumW   = array.new<float>(4, na)   // regression: position-weighted closes
var array<float> sessCumM   = array.new<float>(4, na)   // mean: sum of closes
var array<float> sessDev    = array.new<float>(4, na)   // regression: latest std deviation
var array<float> sessCorr   = array.new<float>(4, na)   // regression: latest correlation
var array<float> sessLinA   = array.new<float>(4, na)   // regression line: start value
var array<float> sessLinB   = array.new<float>(4, na)   // regression line: end value
var array<float> sessMeanV  = array.new<float>(4, na)   // running arithmetic mean
var array<float> sessVNum   = array.new<float>(4, na)   // VWAP numerator
var array<float> sessVDen   = array.new<float>(4, na)   // VWAP denominator (cumulative volume)

// --- 16b. Bounded history for FINISHED session drawing objects ---
var array<box>   finishedBoxes  = array.new<box>()
var array<label> finishedLabels = array.new<label>()
var array<line>  finishedLines  = array.new<line>()

// Retires a finished object into its capped history, deleting the oldest entry once the cap is
// exceeded. Only ever called with a handle that is ABOUT TO BE REPLACED by a new session start,
// so everything sitting in these arrays is, by construction, already complete -- an open object
// is never deleted out from under its own living session.
f_retireBox(b) =>
    array.push(finishedBoxes, b)
    while array.size(finishedBoxes) > sessionRangeKeepInput
        box.delete(array.shift(finishedBoxes))
    true

f_retireLabel(l) =>
    array.push(finishedLabels, l)
    while array.size(finishedLabels) > sessionRangeKeepInput
        label.delete(array.shift(finishedLabels))
    true

f_retireLine(l) =>
    array.push(finishedLines, l)
    while array.size(finishedLines) > sessionLineKeepInput
        line.delete(array.shift(finishedLines))
    true

// --- 16c. Per-bar configuration snapshot (plain series arrays, rebuilt each bar) ---
sessionActiveNow  = array.from(sessionAActive, sessionBActive, sessionCActive, sessionDActive)
sessionStartedNow = array.from(sessionAActive and not sessionAActive[1], sessionBActive and not sessionBActive[1], sessionCActive and not sessionCActive[1], sessionDActive and not sessionDActive[1])
sessionEnabledNow = array.from(effectiveShowSessionA, effectiveShowSessionB, effectiveShowSessionC, effectiveShowSessionD)
sessionNameNow    = array.from(sessionANameInput, sessionBNameInput, sessionCNameInput, sessionDNameInput)
sessionColorNow   = array.from(sessionAColorInput, sessionBColorInput, sessionCColorInput, sessionDColorInput)
sessionRangeNow   = array.from(sessionARangeInput, sessionBRangeInput, sessionCRangeInput, sessionDRangeInput)
sessionTrendNow   = array.from(sessionATrendlineInput, sessionBTrendlineInput, sessionCTrendlineInput, sessionDTrendlineInput)
sessionMeanNow    = array.from(sessionAMeanInput, sessionBMeanInput, sessionCMeanInput, sessionDMeanInput)
sessionVwapNow    = array.from(sessionAVwapInput, sessionBVwapInput, sessionCVwapInput, sessionDVwapInput)
sessionMaxMinNow  = array.from(sessionAMaxMinInput, sessionBMaxMinInput, sessionCMaxMinInput, sessionDMaxMinInput)

// --- 16d. The engine: one pass over the four sessions, each touching only its own slot ---
for i = 0 to 3
    bool   enabled = array.get(sessionEnabledNow, i)
    bool   active  = array.get(sessionActiveNow, i)
    bool   started = array.get(sessionStartedNow, i)
    color  sColor  = array.get(sessionColorNow, i)
    string sName   = array.get(sessionNameNow, i)

    // Feature guards mirror the inherited structure exactly: a feature computes only when the
    // session is enabled AND at least one consumer (its own overlay, the Max/Min plots, or the
    // advanced dashboard) actually needs it.
    bool guardRange = enabled and (array.get(sessionRangeNow, i) or array.get(sessionMaxMinNow, i))
    bool guardTrend = enabled and (array.get(sessionTrendNow, i) or calculateAdvancedDashboard)
    bool guardMean  = enabled and array.get(sessionMeanNow, i)
    bool guardVwap  = enabled and (array.get(sessionVwapNow, i) or calculateAdvancedDashboard)

    // ----- Range box, range label, and the Max/Min plot feed -----
    if guardRange
        if started
            // Retire the previous instance's objects BEFORE overwriting the handles -- this one
            // step is what closes the unbounded-accumulation leak the inherited code had.
            if not na(array.get(sessBox, i))
                f_retireBox(array.get(sessBox, i))
            if not na(array.get(sessLbl, i))
                f_retireLabel(array.get(sessLbl, i))
            array.set(sessStart, i, time)
            array.set(sessHigh, i, high)
            array.set(sessLow, i, low)
            if array.get(sessionRangeNow, i)
                array.set(sessBox, i, box.new(barNumber, high, barNumber, low, bgcolor = color.new(sColor, rangeTransparencyInput), border_color = showRangeOutlineInput ? sColor : na, border_style = line.style_dotted))
                if showRangeLabelInput
                    array.set(sessLbl, i, label.new(time, high, sName, xloc = xloc.bar_time, textcolor = sColor, style = label.style_label_down, color = #00000000, size = size.tiny))
                else
                    array.set(sessLbl, i, na)
            else
                array.set(sessBox, i, na)
                array.set(sessLbl, i, na)
        else if active
            array.set(sessHigh, i, math.max(high, array.get(sessHigh, i)))
            array.set(sessLow, i, math.min(low, array.get(sessLow, i)))
            if not na(array.get(sessBox, i))
                box.set_top(array.get(sessBox, i), array.get(sessHigh, i))
                box.set_rightbottom(array.get(sessBox, i), barNumber, array.get(sessLow, i))
                if not na(array.get(sessLbl, i))
                    label.set_xy(array.get(sessLbl, i), int(math.avg(array.get(sessStart, i), time)), array.get(sessHigh, i))
        // Max/Min plot feed: na while the session is still forming (the linebr gap), then the
        // frozen extreme afterwards -- the inherited "extend until the next session begins".
        float mmH = active ? na : array.get(sessHigh, i)
        float mmL = active ? na : array.get(sessLow, i)
        if i == 0
            sessionAMaximum := mmH
            sessionAMinimum := mmL
        else if i == 1
            sessionBMaximum := mmH
            sessionBMinimum := mmL
        else if i == 2
            sessionCMaximum := mmH
            sessionCMinimum := mmL
        else
            sessionDMaximum := mmH
            sessionDMinimum := mmL

    // ----- Linear-regression trendline (and the dashboard's Trend / sigma cells) -----
    if guardTrend
        if started
            if not na(array.get(sessTrend, i))
                f_retireLine(array.get(sessTrend, i))
            array.set(sessLen, i, 1)
            array.set(sessCumC, i, close)
            array.set(sessCumSq, i, close * close)
            array.set(sessCumW, i, close)
            array.set(sessDev, i, 0.0)
            array.set(sessCorr, i, na)
            array.set(sessLinA, i, close)
            array.set(sessLinB, i, close)
            array.set(sessTrend, i, line.new(barNumber, close, barNumber, close, color = sColor))
        else if active
            int   len   = array.get(sessLen, i) + 1
            float cumC  = array.get(sessCumC, i) + close
            float cumSq = array.get(sessCumSq, i) + close * close
            float cumW  = array.get(sessCumW, i) + close * len
            array.set(sessLen, i, len)
            array.set(sessCumC, i, cumC)
            array.set(sessCumSq, i, cumSq)
            array.set(sessCumW, i, cumW)
            float average         = cumC / len
            float weightedAverage = cumW / (len * (len + 1) / 2.0)
            float covariance      = (weightedAverage - average) * (len + 1) / 2.0
            float variance        = math.max(cumSq / len - average * average, 0.0)
            float corrDen         = math.sqrt(variance) * (math.sqrt(len * len - 1.0) / (2.0 * math.sqrt(3.0)))
            array.set(sessDev, i, math.sqrt(variance))
            array.set(sessCorr, i, corrDen != 0.0 ? covariance / corrDen : na)
            float firstV = 4.0 * average - 3.0 * weightedAverage
            float lastV  = 3.0 * weightedAverage - 2.0 * average
            array.set(sessLinA, i, firstV)
            array.set(sessLinB, i, lastV)
            if not na(array.get(sessTrend, i))
                line.set_y1(array.get(sessTrend, i), firstV)
                line.set_xy2(array.get(sessTrend, i), barNumber, lastV)

    // ----- Running arithmetic mean -----
    if guardMean
        if started
            if not na(array.get(sessMeanLn, i))
                f_retireLine(array.get(sessMeanLn, i))
            array.set(sessLenM, i, 1)
            array.set(sessCumM, i, close)
            array.set(sessMeanV, i, close)
            array.set(sessMeanLn, i, line.new(barNumber, close, barNumber, close, color = sColor))
        else if active
            int   lenM = array.get(sessLenM, i) + 1
            float cumM = array.get(sessCumM, i) + close
            array.set(sessLenM, i, lenM)
            array.set(sessCumM, i, cumM)
            float avgM = cumM / lenM
            array.set(sessMeanV, i, avgM)
            if not na(array.get(sessMeanLn, i))
                line.set_y1(array.get(sessMeanLn, i), avgM)
                line.set_xy2(array.get(sessMeanLn, i), barNumber, avgM)

    // ----- Session VWAP (plot feed + dashboard Volume cell) -----
    if guardVwap
        if started
            array.set(sessVNum, i, close * volume)
            array.set(sessVDen, i, volume)
        else if active
            array.set(sessVNum, i, array.get(sessVNum, i) + close * volume)
            array.set(sessVDen, i, array.get(sessVDen, i) + volume)
        else
            // Inactive: numerator resets so the plotted VWAP goes na after the session ends,
            // exactly as the inherited helper behaved; the denominator deliberately stays put so
            // the dashboard's cumulative-volume cell keeps showing the finished session's total.
            array.set(sessVNum, i, na)
        if array.get(sessionVwapNow, i)
            float vwapVal = array.get(sessVDen, i) != 0.0 ? array.get(sessVNum, i) / array.get(sessVDen, i) : na
            if i == 0
                sessionAVwap := vwapVal
            else if i == 1
                sessionBVwap := vwapVal
            else if i == 2
                sessionCVwap := vwapVal
            else
                sessionDVwap := vwapVal

// --- 16e. Advanced dashboard data cells ---
// Written once on the last bar instead of every bar: the table persists between bars, so the
// visible result is identical and the per-bar cell-write cost disappears. Rows 3..6 are sessions
// A..D, matching the header block built in Section 15.
if barstate.islast and calculateAdvancedDashboard
    for i = 0 to 3
        if array.get(sessionEnabledNow, i)
            color trendColor = na(array.get(sessCorr, i)) ? na : array.get(sessCorr, i) >= 0.0 ? BULL_COLOR : BEAR_COLOR
            cell(dashboardTable, 2, 3 + i, str.tostring(array.get(sessCorr, i), "#.##"), textColor = DATA, background = trendColor)
            cell(dashboardTable, 3, 3 + i, str.tostring(array.get(sessVDen, i), format.volume), textColor = DATA)
            cell(dashboardTable, 4, 3 + i, str.tostring(array.get(sessDev, i), "#.####"), textColor = DATA)

// =============================================================================================
// SECTION 17 -- SESSIONS: PLOTS & DIVIDERS
// =============================================================================================
plot(effectiveShowSessionA and sessionAMaxMinInput ? sessionAMaximum : na, "Session A Maximum", sessionAColorInput, 1, plot.style_linebr)
plot(effectiveShowSessionA and sessionAMaxMinInput ? sessionAMinimum : na, "Session A Minimum", sessionAColorInput, 1, plot.style_linebr)
plot(effectiveShowSessionB and sessionBMaxMinInput ? sessionBMaximum : na, "Session B Maximum", sessionBColorInput, 1, plot.style_linebr)
plot(effectiveShowSessionB and sessionBMaxMinInput ? sessionBMinimum : na, "Session B Minimum", sessionBColorInput, 1, plot.style_linebr)
plot(effectiveShowSessionC and sessionCMaxMinInput ? sessionCMaximum : na, "Session C Maximum", sessionCColorInput, 1, plot.style_linebr)
plot(effectiveShowSessionC and sessionCMaxMinInput ? sessionCMinimum : na, "Session C Minimum", sessionCColorInput, 1, plot.style_linebr)
plot(effectiveShowSessionD and sessionDMaxMinInput ? sessionDMaximum : na, "Session D Maximum", sessionDColorInput, 1, plot.style_linebr)
plot(effectiveShowSessionD and sessionDMaxMinInput ? sessionDMinimum : na, "Session D Minimum", sessionDColorInput, 1, plot.style_linebr)

plot(sessionAVwapInput ? sessionAVwap : na, "Session A VWAP", sessionAColorInput, 1, plot.style_linebr)
plot(sessionBVwapInput ? sessionBVwap : na, "Session B VWAP", sessionBColorInput, 1, plot.style_linebr)
plot(sessionCVwapInput ? sessionCVwap : na, "Session C VWAP", sessionCColorInput, 1, plot.style_linebr)
plot(sessionDVwapInput ? sessionDVwap : na, "Session D VWAP", sessionDColorInput, 1, plot.style_linebr)

plotshape(sessionAActive and effectiveShowSessionDivider and effectiveShowSessionA, title = "Session A Active", style = shape.square, location = location.bottom, color = na, text = ".", textcolor = sessionAColorInput, size = size.tiny, display = display.all - display.status_line, editable = false)
plotshape(sessionAActive != sessionAActive[1] and effectiveShowSessionDivider and effectiveShowSessionA, title = "Session A Boundary", style = shape.labelup, location = location.bottom, color = na, text = "❚", textcolor = sessionAColorInput, size = size.tiny, display = display.all - display.status_line, editable = false)

plotshape(sessionBActive and effectiveShowSessionDivider and effectiveShowSessionB, title = "Session B Active", style = shape.labelup, location = location.bottom, color = na, text = ".", textcolor = sessionBColorInput, size = size.tiny, display = display.all - display.status_line, editable = false)
plotshape(sessionBActive != sessionBActive[1] and effectiveShowSessionDivider and effectiveShowSessionB, title = "Session B Boundary", style = shape.labelup, location = location.bottom, color = na, text = "❚", textcolor = sessionBColorInput, size = size.tiny, display = display.all - display.status_line, editable = false)

plotshape(sessionCActive and effectiveShowSessionDivider and effectiveShowSessionC, title = "Session C Active", style = shape.square, location = location.bottom, color = na, text = ".", textcolor = sessionCColorInput, size = size.tiny, display = display.all - display.status_line, editable = false)
plotshape(sessionCActive != sessionCActive[1] and effectiveShowSessionDivider and effectiveShowSessionC, title = "Session C Boundary", style = shape.labelup, location = location.bottom, color = na, text = "❚", textcolor = sessionCColorInput, size = size.tiny, display = display.all - display.status_line, editable = false)

plotshape(sessionDActive and effectiveShowSessionDivider and effectiveShowSessionD, title = "Session D Active", style = shape.labelup, location = location.bottom, color = na, text = ".", textcolor = sessionDColorInput, size = size.tiny, display = display.all - display.status_line, editable = false)
plotshape(sessionDActive != sessionDActive[1] and effectiveShowSessionDivider and effectiveShowSessionD, title = "Session D Boundary", style = shape.labelup, location = location.bottom, color = na, text = "❚", textcolor = sessionDColorInput, size = size.tiny, display = display.all - display.status_line, editable = false)

// =============================================================================================
// SECTION 18 -- PERIOD DIVIDERS (rebuilt)
// =============================================================================================
// Replaces the original LuxAlgo daily-divider block, which drew a dashed line plus a weekday
// label but was gated by sessionsTimeframeOk -- so it silently did nothing on any chart above 30
// minutes. That cutoff is correct for intraday session shading and wrong for period dividers;
// nothing in this section references it.
//
// Five period types, each independently toggleable, all sharing one lookback count expressed in
// that type's own units: set 20, and Daily keeps the last 20 days while Weekly keeps the last 20
// weeks. Each type owns its own array so the counts never interfere with each other.
//
// Bounded Lifetime: every divider is a line plus an optional label, both held on the Divider UDT
// so they share one lifecycle. The moment an array exceeds the lookback, its oldest entry is
// deleted outright -- line and label together -- which caps total drawing-object usage at
// (lookback x 5 x 2) regardless of how long the chart runs.
var array<Divider> div4h      = array.new<Divider>()
var array<Divider> divDaily   = array.new<Divider>()
var array<Divider> divWeekly  = array.new<Divider>()
var array<Divider> divMonthly = array.new<Divider>()
var array<Divider> divQuarter = array.new<Divider>()

dividerRenderColor = color.new(dividerColorInput, 100 - dividerOpacityInput)

// Reference height for labels. Pine cannot read the actual viewport, so the top/bottom of recent
// price action stands in for "top/bottom of the chart" -- close enough visually, and it scrolls
// naturally with price instead of drifting off-screen.
divHiRef  = ta.highest(high, 200)
divLoRef  = ta.lowest(low, 200)
divSpan   = nz(divHiRef - divLoRef, 0)
divLabelY = dividerLabelPosInput == "Bottom" ? nz(divLoRef, close) - divSpan * 0.03 : nz(divHiRef, close) + divSpan * 0.03

// A vertical line is drawn as a near-zero-height segment with extend.both, which stretches it to
// fill the chart's full height at any zoom level.
f_pushDivider(array<Divider> arr, string labelText, float labelY) =>
    dl = line.new(x1 = time, y1 = close, x2 = time, y2 = close + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both, color = dividerRenderColor, style = line.style_dashed, width = 1)
    label lb = na
    if dividerLabelPosInput != "None"
        lb := label.new(x = time, y = labelY, text = labelText, xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, textcolor = dividerRenderColor, size = size.small)
    array.push(arr, Divider.new(lineId = dl, labelId = lb))
    while array.size(arr) > dividerLookbackInput
        oldDiv = array.shift(arr)
        if not na(oldDiv.lineId)
            line.delete(oldDiv.lineId)
        if not na(oldDiv.labelId)
            label.delete(oldDiv.labelId)
    true

// Each label was created using the reference height as it stood on its own bar, so without this
// they would sit at slightly different heights and look ragged. Realigning them all on the final
// bar puts every visible label in one clean row. Only runs on the last bar -- doing it on every
// historical bar would repeat the same work thousands of times for no visible benefit.
f_alignDividerLabels(array<Divider> arr, float y) =>
    for d in arr
        if not na(d.labelId)
            label.set_y(d.labelId, y)
    true

// A divider is only meaningful when the chart is STRICTLY below its period: on a 4H chart every
// bar starts a new 4H period, which would draw a divider on literally every candle.
chartSeconds   = timeframe.in_seconds()
canShow4h      = chartSeconds < timeframe.in_seconds("240")
canShowDaily   = chartSeconds < timeframe.in_seconds("1D")
canShowWeekly  = chartSeconds < timeframe.in_seconds("1W")
canShowMonthly = chartSeconds < timeframe.in_seconds("1M")
canShowQuarter = chartSeconds < timeframe.in_seconds("3M")

// Period-rollover detection: time(tf) returns the opening timestamp of the period the current bar
// belongs to, so a change in that value is exactly the moment a new period begins.
t4h      = time("240")
tDaily   = time("1D")
tWeekly  = time("1W")
tMonthly = time("1M")
tQuarter = time("3M")

newPeriod4h      = not na(t4h)      and t4h      != t4h[1]
newPeriodDaily   = not na(tDaily)   and tDaily   != tDaily[1]
newPeriodWeekly  = not na(tWeekly)  and tWeekly  != tWeekly[1]
newPeriodMonthly = not na(tMonthly) and tMonthly != tMonthly[1]
newPeriodQuarter = not na(tQuarter) and tQuarter != tQuarter[1]

if showDiv4hInput and canShow4h and newPeriod4h
    f_pushDivider(div4h, "4H", divLabelY)

if showDivDailyInput and canShowDaily and newPeriodDaily
    f_pushDivider(divDaily, "Daily", divLabelY)

if showDivWeeklyInput and canShowWeekly and newPeriodWeekly
    f_pushDivider(divWeekly, "Weekly", divLabelY)

if showDivMonthlyInput and canShowMonthly and newPeriodMonthly
    f_pushDivider(divMonthly, "Monthly", divLabelY)

if showDivQuarterInput and canShowQuarter and newPeriodQuarter
    f_pushDivider(divQuarter, "Quarterly", divLabelY)

if barstate.islast and dividerLabelPosInput != "None"
    f_alignDividerLabels(div4h, divLabelY)
    f_alignDividerLabels(divDaily, divLabelY)
    f_alignDividerLabels(divWeekly, divLabelY)
    f_alignDividerLabels(divMonthly, divLabelY)
    f_alignDividerLabels(divQuarter, divLabelY)
// =============================================================================================
// SECTION 19 -- V3 DOL, NATIVE RANGE AND TURTLE SOUP
// Native structure is still Sections 7/8. This layer annotates it and never writes TF2 bias.
// =============================================================================================
type V3Gap
    string kind
    string nativeTf
    int direction
    float lower
    float upper
    int origin
    int availableAt
    int sequenceOrigin
    bool active = true
    int endedAt = na
    box id = na

type V3Setup
    string setupId
    int origin
    int availableAt
    int referenceTime
    float rangeHigh
    float rangeLow
    float manOpen
    float manHigh
    float manLow
    float manClose
    int direction
    string variant
    bool actionable
    float target = na
    string targetTf = ""
    int targetOrigin = na
    float entry = na
    float stop = na
    float r3 = na
    float r5 = na
    array<line> quadrantIds
    bool opposition = false
    bool twoSided = false
    int manipulationCandles = 1
    string state = "CONTEXT"
    int endTime = na
    bool confluence = false
    bool aligned = false
    bool fvg = false
    bool vi = false
    bool sessionTag = false
    bool tsTiming = false
    bool crtTiming = false
    bool location = false
    bool pattern = false
    string breakClass = "None"
    bool caution = false
    bool dualHit = false
    float score = 0
    string grade = ""
    box zoneId = na
    label labelId = na
    line highId = na
    line lowId = na
    line ceId = na
    line targetId = na
    line stopId = na
    line r3Id = na
    line r5Id = na

type V3PatternContext
    int t
    int boundary
    float h
    float l
    int flags
var array<V3PatternContext> v3RawTf2Patterns = array.new<V3PatternContext>()

var array<Level> v3ExtraDols = array.new<Level>()
var array<V3Gap> v3Gaps = array.new<V3Gap>()
var array<V3Setup> v3Setups = array.new<V3Setup>()
var V3Setup v3Owner = na
var string v3RangeState = "IDLE"
var int v3RangeOrigin = na
var float v3RangeHigh = na
var float v3RangeLow = na
var array<int> v3ExtraLast = array.new<int>(3, na)

f_v3Inside(float value, float lowValue, float highValue) =>
    value > lowValue and value < highValue
f_v3Touch(array<Level> levels, float barHigh, float barLow, int observationStart, int observationEnd, string nativeTf) =>
    bool changed = false
    for level in levels
        if level.dolRole != "" and level.dolState == 0 and not na(level.availableAt) and observationStart >= level.availableAt
            touched = level.isHighLow == "High" ? barHigh >= level.price : barLow <= level.price
            if touched
                changed := true
                level.dolState := 1
                level.dolChangedAt := observationEnd
                f_v3DolEvent(level, nativeTf == "" ? level.tf : nativeTf)
    changed
f_v3ConsumeExtra(string nativeTf, float c, float h, float l, int t, int boundary) =>
    for level in v3ExtraDols
        if level.tf == nativeTf and level.isActive and level.availableAt <= t
            level.dolCoverage := true
            broken = level.isHighLow == "High" ? c > level.price : c < level.price
            touched = level.isHighLow == "High" ? h >= level.price : l <= level.price
            if broken
                level.isActive := false
                level.endTime := t
                level.dolState := 2
                level.dolChangedAt := boundary
                f_v3DolEvent(level, nativeTf)
            else if level.dolState == 0 and touched
                level.dolState := 1
                level.dolChangedAt := boundary
                f_v3DolEvent(level, nativeTf)
    true
f_v3Near(float a, float b) =>
    100.0 * math.abs(a - b) / math.max(math.max(math.abs(a), math.abs(b)), syminfo.mintick) <= v3DolProximityInput
// Native candle direction defines the primary draw. Color, pattern and bias do not redefine it.
f_v3PickTarget(int direction, float entryValue, int manipulationStart) =>
    float selectedPrice = na
    string selectedTf = ""
    int selectedOrigin = na
    float selectedSeconds = -1.0
    float bestDistance = na
    allLevels = array.copy(tf1Levels)
    array.concat(allLevels, v3ExtraDols)
    for level in allLevels
        isPrimary = level.dolRole == "PDOL" and level.dolState == 0 and level.dolCoverage
        eligibleTime = not na(level.availableAt) and level.availableAt <= manipulationStart
        correctSide = direction == 1 ? level.price > entryValue : level.price < entryValue
        if isPrimary and eligibleTime and correctSide
            nativeTf = level.tf == "TF1" ? tf1Input : level.tf
            seconds = f_v3TfRank(nativeTf)
            distance = math.abs(level.price - entryValue)
            replace = seconds > selectedSeconds or (seconds == selectedSeconds and (na(bestDistance) or distance < bestDistance or (distance == bestDistance and level.startTime > selectedOrigin)))
            if replace
                selectedPrice := level.price
                selectedTf := nativeTf
                selectedOrigin := level.startTime
                selectedSeconds := seconds
                bestDistance := distance
    [selectedPrice, selectedTf, selectedOrigin]
f_v3Confluence(float target, string nativeTf) =>
    bool found = false
    allLevels = array.copy(tf1Levels)
    array.concat(allLevels, v3ExtraDols)
    for level in allLevels
        otherTf = level.tf == "TF1" ? tf1Input : level.tf
        if level.dolRole == "PDOL" and level.dolState == 0 and level.dolCoverage and f_v3TfKey(otherTf) != f_v3TfKey(nativeTf) and f_v3Near(target, level.price)
            found := true
    found
f_v3Alignment(int direction, float entryValue, string selectedTf) =>
    float highest = -1.0
    bool hasAbove = false
    bool hasBelow = false
    allLevels = array.copy(tf1Levels)
    array.concat(allLevels, v3ExtraDols)
    for level in allLevels
        if level.dolRole == "PDOL" and level.dolState == 0 and level.dolCoverage
            nativeTf = level.tf == "TF1" ? tf1Input : level.tf
            seconds = f_v3TfRank(nativeTf)
            if seconds > highest
                highest := seconds
                hasAbove := level.price > entryValue
                hasBelow := level.price < entryValue
            else if seconds == highest
                hasAbove := hasAbove or level.price > entryValue
                hasBelow := hasBelow or level.price < entryValue
    sameAnchor = selectedTf != "" and f_v3TfRank(selectedTf) == highest
    sameAnchor or (direction == 1 ? hasAbove and not hasBelow : hasBelow and not hasAbove)
// H3/K4: deferred providers retain schema fields but record no timing evidence.
// The former hour/day/week rules remain documented in the 2 October baseline snapshot.
// Restore one Sessions-based timezone provider when timing returns, never a duplicate input.
f_v3Timing(int t, bool ts) =>
    false
f_v3SessionAt(int t) =>
    false
f_v3GapTags(float lower, float upper, int t, int boundary) =>
    bool fvg = false
    bool vi = false
    for gap in v3Gaps
        if (gap.active or (not na(gap.endedAt) and gap.endedAt > t and gap.endedAt <= boundary)) and gap.availableAt <= t and upper >= gap.lower and lower <= gap.upper
            fvg := fvg or gap.kind == "FVG"
            vi := vi or gap.kind == "VI"
    [fvg, vi]
f_v3PatternAtZone(int direction, float lower, float upper, int start, int boundary) =>
    bool found = false
    for mark in v3RawTf2Patterns
        directional = direction == 1 ? f_bit(mark.flags, 1) or f_bit(mark.flags, 32) or f_bit(mark.flags, 64) : f_bit(mark.flags, 2) or f_bit(mark.flags, 128) or f_bit(mark.flags, 256)
        found := found or (directional and mark.t >= start and mark.boundary <= boundary and mark.h >= lower and mark.l <= upper)
    found

f_v3DeleteSetup(V3Setup setup) =>
    if not na(setup.zoneId)
        box.delete(setup.zoneId)
        setup.zoneId := na
    if not na(setup.labelId)
        label.delete(setup.labelId)
        setup.labelId := na
    handles = array.from(setup.highId, setup.lowId, setup.ceId, setup.targetId, setup.stopId, setup.r3Id, setup.r5Id)
    for handle in handles
        if not na(handle)
            line.delete(handle)
    setup.highId := na
    setup.lowId := na
    setup.ceId := na
    setup.targetId := na
    setup.stopId := na
    setup.r3Id := na
    setup.r5Id := na
    for handle in setup.quadrantIds
        if not na(handle)
            line.delete(handle)
    array.fill(setup.quadrantIds, na)
    true
f_v3Transition(V3Setup setup, string nextState, int stamp) =>
    if setup.state != nextState
        prior = setup.state
        setup.state := nextState
        if nextState == "DONE" or nextState == "INVALIDATED" or nextState == "SUPERSEDED" or nextState == "EXPIRED"
            setup.endTime := stamp
        f_v3Event("RANGE_STATE", tf1Input, setup.origin, stamp, ",\"setupId\":" + f_v3Quote(setup.setupId) + ",\"from\":" + f_v3Quote(prior) + ",\"to\":" + f_v3Quote(nextState) + ",\"target\":" + f_v3Number(setup.target) + ",\"dualHit\":" + f_v3Bool(setup.dualHit))
    true
f_v3Grade(V3Setup setup, int stamp) =>
    if setup.actionable
        float score = (setup.confluence ? v3WConfluence : 0) + (setup.aligned ? v3WHtf : 0) + (setup.fvg or setup.vi ? v3WKey : 0) + (setup.sessionTag or setup.tsTiming or setup.crtTiming ? v3WTiming : 0) + (setup.location ? v3WLocation : 0) + (setup.pattern ? v3WPattern : 0)
        score += setup.breakClass == "Critical" ? v3WCritical : setup.breakClass == "Major" ? v3WMajor : setup.breakClass == "Minor" ? v3WMinor : 0
        score += setup.caution ? v3WCaution : 0
        score += setup.opposition ? v3WOpposition : 0
        grade = score >= math.max(v3GradeAInput, v3GradeBInput) ? "A" : score >= math.min(v3GradeAInput, v3GradeBInput) ? "B" : "C"
        changed = setup.grade != grade or setup.score != score
        setup.grade := grade
        setup.score := score
        if changed
            f_v3Event("GRADE", tf1Input, setup.origin, stamp, ",\"setupId\":" + f_v3Quote(setup.setupId) + ",\"grade\":" + f_v3Quote(grade) + ",\"score\":" + f_v3Number(score) + ",\"breakClass\":" + f_v3Quote(setup.breakClass) + ",\"caution\":" + f_v3Bool(setup.caution))
    true
f_v3TsExport(V3Setup setup) =>
    fields = ",\"setupId\":" + f_v3Quote(setup.setupId) + ",\"variant\":" + f_v3Quote(setup.variant) + ",\"direction\":" + str.tostring(setup.direction) + ",\"actionable\":" + f_v3Bool(setup.actionable)
    fields += ",\"referenceTime\":" + str.tostring(setup.referenceTime) + ",\"rangeHigh\":" + f_v3Number(setup.rangeHigh) + ",\"rangeLow\":" + f_v3Number(setup.rangeLow)
    fields += ",\"open\":" + f_v3Number(setup.manOpen) + ",\"high\":" + f_v3Number(setup.manHigh) + ",\"low\":" + f_v3Number(setup.manLow) + ",\"close\":" + f_v3Number(setup.manClose)
    fields += ",\"target\":" + f_v3Number(setup.target) + ",\"targetTf\":" + f_v3Quote(setup.targetTf) + ",\"targetOrigin\":" + (na(setup.targetOrigin) ? "null" : str.tostring(setup.targetOrigin))
    fields += ",\"entry\":" + f_v3Number(setup.entry) + ",\"zoneLow\":" + f_v3Number(setup.actionable ? (setup.direction == 1 ? setup.manLow : math.max(setup.manOpen, setup.manClose)) : na) + ",\"zoneHigh\":" + f_v3Number(setup.actionable ? (setup.direction == 1 ? math.min(setup.manOpen, setup.manClose) : setup.manHigh) : na)
    fields += ",\"stop\":" + f_v3Number(setup.stop) + ",\"r3\":" + f_v3Number(setup.r3) + ",\"r5\":" + f_v3Number(setup.r5)
    fields += ",\"confluence\":" + f_v3Bool(setup.confluence) + ",\"aligned\":" + f_v3Bool(setup.aligned) + ",\"fvg\":" + f_v3Bool(setup.fvg) + ",\"vi\":" + f_v3Bool(setup.vi)
    fields += ",\"session\":null,\"tsTiming\":null,\"crtTiming\":null,\"premiumDiscount\":" + f_v3Bool(setup.location) + ",\"patternContext\":" + f_v3Bool(setup.pattern)
    fields += ",\"opposition\":" + f_v3Bool(setup.opposition) + ",\"manipulationCandles\":" + str.tostring(setup.manipulationCandles) + ",\"twoSided\":" + f_v3Bool(setup.twoSided)
    fields += ",\"tf2PatternFlags\":" + str.tostring(tf2PatFlags)
    f_v3Event("TS", tf1Input, setup.origin, setup.availableAt, fields)

v3ChartOk = chart.is_standard and f_v3TfLe(timeframe.period, tf2Input) and f_v3TfLe(tf2Input, tf1Input)
v3NativeEnabled = v3EnableInput and v3ChartOk
bool v3DolRefresh = newTf1Bar
var int v3FirstObserved = time
// Raw native context is stored without render-family or trend gates. It has no drawing handles.
if v3NativeEnabled and newTf2Bar
    array.push(v3RawTf2Patterns, V3PatternContext.new(tf2ClosedT, tf2ClosedEnd, tf2CandleHigh, tf2CandleLow, tf2PatFlags))
    while array.size(v3RawTf2Patterns) > 500
        array.shift(v3RawTf2Patterns)
while array.size(v3RawTf2Patterns) > 0
    if array.get(v3RawTf2Patterns, 0).t < tf1WindowAnchor
        array.shift(v3RawTf2Patterns)
    else
        break

// Additional anchors share one expression and only create DOL Levels, never another setup engine.
v3ExtraOn = array.from(v3Dol1On, v3Dol2On, v3Dol3On)
v3ExtraTf = array.from(v3Dol1Tf, v3Dol2Tf, v3Dol3Tf)
v3ExtraLookback1 = v3Dol1Lookback == 0 ? tf1SubLookbackEff : v3Dol1Lookback == -1 ? lookbackInput : v3Dol1Lookback
v3ExtraLookback2 = v3Dol2Lookback == 0 ? tf1SubLookbackEff : v3Dol2Lookback == -1 ? lookbackInput : v3Dol2Lookback
v3ExtraLookback3 = v3Dol3Lookback == 0 ? tf1SubLookbackEff : v3Dol3Lookback == -1 ? lookbackInput : v3Dol3Lookback
var array<string> v3SeenExtra = array.new<string>()
array.clear(v3SeenExtra)
for slot = 0 to 2
    nativeTf = array.get(v3ExtraTf, slot)
    key = f_v3TfKey(nativeTf)
    enabled = v3NativeEnabled and array.get(v3ExtraOn, slot) and key != f_v3TfKey(tf1Input) and f_v3TfLe(timeframe.period, nativeTf) and not array.includes(v3SeenExtra, key)
    if enabled
        array.push(v3SeenExtra, key)
        // Request expressions cannot depend on the loop index. Transport all three input cutoffs.
        [o, h, l, c, t, boundary, cutoff1, cutoff2, cutoff3] = request.security(syminfo.tickerid, nativeTf, [open[1], high[1], low[1], close[1], time[1], time_close[1], time[v3ExtraLookback1], time[v3ExtraLookback2], time[v3ExtraLookback3]], lookahead = barmerge.lookahead_on)
        cutoff = slot == 0 ? cutoff1 : slot == 1 ? cutoff2 : cutoff3
        lastStamp = array.get(v3ExtraLast, slot)
        if not na(t) and (na(lastStamp) or t != lastStamp)
            v3DolRefresh := true
            array.set(v3ExtraLast, slot, t)
            f_v3ConsumeExtra(nativeTf, c, h, l, t, boundary)
            dir = c > o ? "up" : c < o ? "down" : "neutral"
            if dir != "neutral"
                array.push(v3ExtraDols, Level.new(price = h, startTime = t, tf = nativeTf, isActive = true, isHighLow = "High", polarity = "resistance", tf1Direction = dir, dolRole = dir == "up" ? "PDOL" : "SDOL", availableAt = boundary, dolCoverage = boundary >= v3FirstObserved))
                array.push(v3ExtraDols, Level.new(price = l, startTime = t, tf = nativeTf, isActive = true, isHighLow = "Low", polarity = "support", tf1Direction = dir, dolRole = dir == "down" ? "PDOL" : "SDOL", availableAt = boundary, dolCoverage = boundary >= v3FirstObserved))
            idx = array.size(v3ExtraDols) - 1
            while idx >= 0
                level = array.get(v3ExtraDols, idx)
                if level.tf == nativeTf and not na(cutoff) and level.startTime < cutoff
                    f_hideLevel(level)
                    array.remove(v3ExtraDols, idx)
                idx -= 1

// AMENDMENT D2: reference is N complete candles BEFORE this newly confirmed candle.
f_v3WindowPacket(int length) =>
    [ta.highest(high, length)[2], ta.lowest(low, length)[2], time[length+1]]
[v3WindowH, v3WindowL, v3WindowT] = request.security(syminfo.tickerid, tf1Input, f_v3WindowPacket(tf1SubLookbackEff), lookahead = barmerge.lookahead_on)
type V3Manipulation
    int referenceTime
    float rangeHigh
    float rangeLow
    int origin
    float o
    float h
    float l
    float c
    int boundary
    int candles = 1
    bool sweptHigh = false
    bool sweptLow = false
var V3Manipulation v3Manipulation = na
f_v3OwnerClean(V3Setup owner) =>
    bool clean = false
    if not na(owner) and na(owner.endTime)
        allLevels = array.copy(tf1Levels)
        array.concat(allLevels, v3ExtraDols)
        for level in allLevels
            nativeTf = level.tf == "TF1" ? tf1Input : level.tf
            clean := clean or (level.startTime == owner.targetOrigin and f_v3TfKey(nativeTf) == f_v3TfKey(owner.targetTf) and level.dolRole == "PDOL" and level.dolState == 0 and level.dolCoverage)
    clean
if v3NativeEnabled and newTf1Bar
    // Apply the current confirmed native OHLC before target qualification.
    f_v3Touch(tf1Levels, tf1H, tf1L, tf1ClosedT, tf1ClosedEnd, tf1Input)
    for extra in v3ExtraDols
        if extra.dolState == 0 and extra.availableAt <= tf1ClosedT
            hit = extra.isHighLow == "High" ? tf1H >= extra.price : tf1L <= extra.price
            if hit
                extra.dolState := 1
                extra.dolChangedAt := tf1ClosedEnd
                f_v3DolEvent(extra, extra.tf)
    if not na(v3Owner) and tf1ClosedT >= v3Owner.availableAt and (na(v3Owner.endTime) or (v3Owner.state == "DONE" and v3Owner.endTime >= tf1ClosedT))
        failed = v3Owner.direction == 1 ? tf1C < v3Owner.manLow : tf1C > v3Owner.manHigh
        hitTarget = v3Owner.direction == 1 ? tf1H >= v3Owner.target : tf1L <= v3Owner.target
        if failed
            v3Owner.dualHit := hitTarget
            f_v3Transition(v3Owner, "INVALIDATED", tf1ClosedEnd)
        else if hitTarget and na(v3Owner.endTime)
            f_v3Transition(v3Owner, "DONE", tf1ClosedEnd)
    if na(v3Manipulation) and not na(v3WindowT) and v3WindowH > v3WindowL
        sweptHigh = tf1H > v3WindowH
        sweptLow = tf1L < v3WindowL
        if sweptHigh or sweptLow
            v3Manipulation := V3Manipulation.new(v3WindowT, v3WindowH, v3WindowL, tf1ClosedT, tf1O, tf1H, tf1L, tf1C, tf1ClosedEnd, 1, sweptHigh, sweptLow)
    else if not na(v3Manipulation)
        v3Manipulation.h := math.max(v3Manipulation.h, tf1H)
        v3Manipulation.l := math.min(v3Manipulation.l, tf1L)
        v3Manipulation.c := tf1C
        v3Manipulation.boundary := tf1ClosedEnd
        v3Manipulation.candles += 1
        v3Manipulation.sweptHigh := v3Manipulation.sweptHigh or tf1H > v3Manipulation.rangeHigh
        v3Manipulation.sweptLow := v3Manipulation.sweptLow or tf1L < v3Manipulation.rangeLow
    completed = not na(v3Manipulation) ? f_v3Inside(v3Manipulation.c, v3Manipulation.rangeLow, v3Manipulation.rangeHigh) : false
    if completed
        episode = v3Manipulation
        // Two-sided native OHLC does not reveal the path. Preserve both candidates, long first.
        ownerCleanAtDetection = f_v3OwnerClean(v3Owner)
        ownerDirectionAtDetection = not na(v3Owner) ? v3Owner.direction : 0
        for candidate = 0 to 1
            direction = candidate == 0 ? 1 : -1
            qualifies = direction == 1 ? episode.sweptLow : episode.sweptHigh
            if qualifies
                f_v3Touch(tf1Levels, episode.h, episode.l, episode.origin, episode.boundary, tf1Input)
                f_v3Touch(v3ExtraDols, episode.h, episode.l, episode.origin, episode.boundary, "")
                zoneLo = direction == 1 ? episode.l : math.max(episode.o, episode.c)
                zoneHi = direction == 1 ? math.min(episode.o, episode.c) : episode.h
                entryValue = (zoneLo + zoneHi) / 2.0
                [targetPrice, targetTf, targetOrigin] = f_v3PickTarget(direction, entryValue, episode.origin)
                stopValue = direction == 1 ? episode.l - v3StopTicksInput * syminfo.mintick : episode.h + v3StopTicksInput * syminfo.mintick
                risk = math.abs(stopValue - entryValue)
                actionable = not na(targetPrice)
                [fvgTag, viTag] = f_v3GapTags(direction == 1 ? episode.l : episode.rangeHigh, direction == 1 ? episode.rangeLow : episode.h, episode.origin, episode.boundary)
                setup = V3Setup.new(setupId = tf1Input + ":" + str.tostring(episode.origin) + ":" + str.tostring(direction), origin = episode.origin, availableAt = episode.boundary, referenceTime = episode.referenceTime, rangeHigh = episode.rangeHigh, rangeLow = episode.rangeLow, manOpen = episode.o, manHigh = episode.h, manLow = episode.l, manClose = episode.c, direction = direction, variant = episode.candles == 1 ? "Window" : "WindowMulti", actionable = actionable, target = targetPrice, targetTf = targetTf, targetOrigin = targetOrigin, entry = actionable ? entryValue : na, stop = actionable ? stopValue : na, r3 = actionable ? entryValue + direction * 3 * risk : na, r5 = actionable ? entryValue + direction * 5 * risk : na, quadrantIds = array.new<line>(8, na), opposition = ownerCleanAtDetection and direction != ownerDirectionAtDetection, twoSided = episode.sweptHigh and episode.sweptLow, manipulationCandles = episode.candles, confluence = actionable and f_v3Confluence(targetPrice, targetTf), aligned = actionable and f_v3Alignment(direction, entryValue, targetTf), fvg = fvgTag, vi = viTag, location = direction == 1 ? entryValue < (episode.rangeHigh+episode.rangeLow)/2 : entryValue > (episode.rangeHigh+episode.rangeLow)/2)
                setup.pattern := f_v3PatternAtZone(direction, zoneLo, zoneHi, episode.origin, episode.boundary)
                f_v3TsExport(setup)
                if actionable
                    if na(v3Owner)
                        v3Owner := setup
                        f_v3Transition(setup, "MANIPULATION", episode.boundary)
                    else if not na(v3Owner.endTime)
                        v3Owner := setup
                        f_v3Transition(setup, "MANIPULATION", episode.boundary)
                    else
                        f_v3Transition(setup, "SUPERSEDED", episode.boundary)
                    f_v3Grade(setup, episode.boundary)
                else
                    setup.endTime := episode.boundary
                array.push(v3Setups, setup)
                while array.size(v3Setups) > v3SetupKeepInput
                    removed = array.shift(v3Setups)
                    if not na(v3Owner) and removed.setupId == v3Owner.setupId
                        f_v3Transition(removed, "EXPIRED", tf1ClosedEnd)
                        v3Owner := na
                    f_v3DeleteSetup(removed)
        v3Manipulation := na
    // Idle references have no event or geometry. Pending sweeps own one constant-size stamp.
    if not na(v3Manipulation)
        v3RangeState := "SWEEP_PENDING"
        v3RangeOrigin := v3Manipulation.referenceTime
        v3RangeHigh := v3Manipulation.rangeHigh
        v3RangeLow := v3Manipulation.rangeLow
    else
        v3RangeState := not na(v3Owner) and na(v3Owner.endTime) ? v3Owner.state : "RANGE_SET"
        v3RangeOrigin := v3WindowT
        v3RangeHigh := v3WindowH
        v3RangeLow := v3WindowL

// Live touches are observed on the chart only after the parent anchor became available.
// OHLC accumulation preserves transient touches at chart close; native consumption remains separate.
if v3NativeEnabled and barstate.isconfirmed
    primaryChanged = f_v3Touch(tf1Levels, high, low, time, time_close, tf1Input)
    extraChanged = f_v3Touch(v3ExtraDols, high, low, time, time_close, "")
    v3DolRefresh := v3DolRefresh or primaryChanged or extraChanged
    if not na(v3Owner) and na(v3Owner.endTime) and time >= v3Owner.availableAt
        targetTouched = v3Owner.direction == 1 ? high >= v3Owner.target : low <= v3Owner.target
        if targetTouched
            f_v3Transition(v3Owner, "DONE", time_close)
        else if v3Owner.state == "MANIPULATION" and (v3Owner.direction == 1 ? high > v3Owner.manClose : low < v3Owner.manClose)
            f_v3Transition(v3Owner, "DISTRIBUTION", time_close)

// The DOL tag lives on its parent Level. Confluence is recomputed, not accumulated.
if v3NativeEnabled and v3DolRefresh
    for level in tf1Levels
        level.dolConfluent := level.dolRole == "PDOL" and level.dolState == 0 and level.dolCoverage and f_v3Confluence(level.price, tf1Input)
    for level in v3ExtraDols
        level.dolConfluent := level.dolRole == "PDOL" and level.dolState == 0 and level.dolCoverage and f_v3Confluence(level.price, level.tf)

// Refresh primary colors after this bar's DOL state settles, avoiding a one-bar visual delay.
if v3NativeEnabled and v3DolShowInput and showTf1
    for level in tf1Levels
        if not na(level.id) and level.dolRole != ""
            base = f_lineColor(level)
            faded = level.dolState == 1 or (not barstate.isconfirmed and time >= level.availableAt and (level.isHighLow == "High" ? high >= level.price : low <= level.price)) or (not na(tf1SubLookbackCutoff) and level.startTime < tf1SubLookbackCutoff)
            ink = level.dolConfluent and level.dolState == 0 ? v3ConfluentColorInput : faded ? f_fadeColor(base, fadeOpacityInput) : base
            line.set_color(level.id, ink)

// =============================================================================================
// SECTION 20 -- V3 KEY LEVELS: FVG AND PRICE-BODY VOLUME IMBALANCE
// Neither key level gates TS geometry. Pre-existing zones tag a manipulation before fill commits.
// =============================================================================================
f_v3GapPacket(int age) =>
    [high[1], low[1], time[1], time_close[1], high[3], low[3], open[1], close[2], high[2], low[2], time[age], time[3], time[2]]
f_v3DeleteGap(V3Gap gap) =>
    if not na(gap.id)
        box.delete(gap.id)
        gap.id := na
    true
f_v3AddGap(string kind, string nativeTf, int direction, float lower, float upper, int t, int boundary, int sequence) =>
    array.push(v3Gaps, V3Gap.new(kind = kind, nativeTf = nativeTf, direction = direction, lower = lower, upper = upper, origin = t, availableAt = boundary, sequenceOrigin = sequence))
    while array.size(v3Gaps) > v3GapKeepInput
        oldGap = array.shift(v3Gaps)
        f_v3DeleteGap(oldGap)
    true
[v3G1H, v3G1L, v3G1T, v3G1End, v3G1H2, v3G1L2, v3G1O, v3G1C1, v3G1H1, v3G1L1, v3G1Cutoff, v3G1Seq, v3G1Prior] = request.security(syminfo.tickerid, tf1Input, f_v3GapPacket(v3GapAgeInput), lookahead = barmerge.lookahead_on)
[v3G2H, v3G2L, v3G2T, v3G2End, v3G2H2, v3G2L2, v3G2O, v3G2C1, v3G2H1, v3G2L1, v3G2Cutoff, v3G2Seq, v3G2Prior] = request.security(syminfo.tickerid, tf2Input, f_v3GapPacket(v3GapAgeInput), lookahead = barmerge.lookahead_on)
if v3NativeEnabled
    for pass = 0 to 1
        nativeTf = pass == 0 ? tf1Input : tf2Input
        rolled = pass == 0 ? newTf1Bar : newTf2Bar
        if rolled and (pass == 0 or f_v3TfKey(tf2Input) != f_v3TfKey(tf1Input))
            gh = pass == 0 ? v3G1H : v3G2H
            gl = pass == 0 ? v3G1L : v3G2L
            gt = pass == 0 ? v3G1T : v3G2T
            ge = pass == 0 ? v3G1End : v3G2End
            gh2 = pass == 0 ? v3G1H2 : v3G2H2
            gl2 = pass == 0 ? v3G1L2 : v3G2L2
            go = pass == 0 ? v3G1O : v3G2O
            gc1 = pass == 0 ? v3G1C1 : v3G2C1
            gh1 = pass == 0 ? v3G1H1 : v3G2H1
            gl1 = pass == 0 ? v3G1L1 : v3G2L1
            sequence = pass == 0 ? v3G1Seq : v3G2Seq
            prior = pass == 0 ? v3G1Prior : v3G2Prior
            // Own-timeframe complete OHLC fills an already-available zone at native close.
            for gap in v3Gaps
                if gap.active and f_v3TfKey(gap.nativeTf) == f_v3TfKey(nativeTf) and gap.availableAt <= gt
                    filled = gap.direction == 1 ? gl <= gap.lower : gh >= gap.upper
                    if filled
                        gap.active := false
                        gap.endedAt := ge
            if gl > gh2
                f_v3AddGap("FVG", nativeTf, 1, gh2, gl, gt, ge, sequence)
            if gh < gl2
                f_v3AddGap("FVG", nativeTf, -1, gh, gl2, gt, ge, sequence)
            overlapLow = math.max(gl, gl1)
            overlapHigh = math.min(gh, gh1)
            if overlapHigh >= overlapLow and go != gc1 and not na(gc1)
                lower = v3ViWickExtendInput ? math.min(math.min(go, gc1), overlapLow) : math.min(go, gc1)
                upper = v3ViWickExtendInput ? math.max(math.max(go, gc1), overlapHigh) : math.max(go, gc1)
                f_v3AddGap("VI", nativeTf, go > gc1 ? 1 : -1, lower, upper, gt, ge, prior)
    idxGap = array.size(v3Gaps) - 1
    while idxGap >= 0
        gap = array.get(v3Gaps, idxGap)
        cutoff = f_v3TfKey(gap.nativeTf) == f_v3TfKey(tf1Input) ? v3G1Cutoff : v3G2Cutoff
        if not na(cutoff) and gap.origin < cutoff
            f_v3DeleteGap(gap)
            array.remove(v3Gaps, idxGap)
        idxGap -= 1

// =============================================================================================
// SECTION 21 -- V3 SETUP CONTEXT RANKING AND LIFETIME
// Ranking reads structural facts. It does not promote Minor breaks into protected-swing CHoCH.
// =============================================================================================
if v3NativeEnabled and newTf2Bar
    if bias != biasBeforeClose
        f_v3Event("TF2_BIAS", tf2Input, tf2ClosedT, tf2ClosedEnd, ",\"from\":" + f_v3Quote(biasBeforeClose) + ",\"to\":" + f_v3Quote(bias))
    for setup in v3Setups
        if setup.actionable and na(setup.endTime) and tf2ClosedEnd >= setup.availableAt
            for layer = 0 to 1
                levels = layer == 0 ? tf2Levels : tf2MinorLevels
                for level in levels
                    if not level.isActive and level.endTime == tf2ClosedT and tf2ClosedT >= setup.origin
                        directionMatches = setup.direction == 1 ? level.isHighLow == "High" : level.isHighLow == "Low"
                        if directionMatches
                            classification = level.isCritical ? "Critical" : layer == 0 ? "Major" : "Minor"
                            rank = classification == "Critical" ? 3 : classification == "Major" ? 2 : 1
                            priorRank = setup.breakClass == "Critical" ? 3 : setup.breakClass == "Major" ? 2 : setup.breakClass == "Minor" ? 1 : 0
                            if rank >= priorRank
                                setup.breakClass := classification
                                setup.caution := na(time_close[1]) or time_close[1] != tf2ClosedEnd or (setup.direction == 1 ? close[1] <= level.price : close[1] >= level.price)
            rawPattern = setup.direction == 1 ? f_bit(tf2PatFlags, 1) or f_bit(tf2PatFlags, 32) or f_bit(tf2PatFlags, 64) : f_bit(tf2PatFlags, 2) or f_bit(tf2PatFlags, 128) or f_bit(tf2PatFlags, 256)
            zoneLo = setup.direction == 1 ? setup.manLow : math.max(setup.manOpen, setup.manClose)
            zoneHi = setup.direction == 1 ? math.min(setup.manOpen, setup.manClose) : setup.manHigh
            atZone = tf2CandleHigh >= zoneLo and tf2CandleLow <= zoneHi and tf2ClosedT >= setup.origin
            setup.pattern := setup.pattern or (rawPattern and atZone)
            f_v3Grade(setup, tf2ClosedEnd)

// Anchor-window eviction applies in addition to the count cap: no stale setup extends forever.
setupIndex = array.size(v3Setups) - 1
while setupIndex >= 0
    setup = array.get(v3Setups, setupIndex)
    if not na(tf1WindowAnchor) and setup.availableAt <= tf1WindowAnchor
        if na(setup.endTime)
            f_v3Transition(setup, "EXPIRED", time)
        f_v3DeleteSetup(setup)
        array.remove(v3Setups, setupIndex)
    setupIndex -= 1
if not na(v3Owner)
    if v3Owner.availableAt <= tf1WindowAnchor
        v3Owner := na

// =============================================================================================
// SECTION 22 -- V3 OBJECT RENDERING
// Every drawing owns a handle. Hidden modules preserve stamps; evictions destroy both.
// =============================================================================================
f_v3LevelLine(line handle, bool enabled, int origin, int endpoint, float price, color lineColor, string styleValue) =>
    line result = handle
    if not enabled or na(price)
        if not na(result)
            line.delete(result)
            result := na
    else if na(result)
        if f_v3Room(1, 0, 0)
            result := line.new(origin, price, endpoint, price, xloc = xloc.bar_time, color = lineColor, style = styleValue, width = v3LineWidthInput)
    else
        line.set_xy2(result, endpoint, price)
        line.set_color(result, lineColor)
    result
for level in v3ExtraDols
    if v3NativeEnabled and v3DolShowInput
        base = level.tf1Direction == "up" ? (level.isHighLow == "High" ? tf1HighColor : tf1LowColor) : (level.isHighLow == "High" ? tf1LowColor : tf1HighColor)
        ink = level.dolState == 1 ? f_fadeColor(base, fadeOpacityInput) : level.dolConfluent and level.dolState == 0 ? v3ConfluentColorInput : base
        level.id := f_v3LevelLine(level.id, true, level.startTime, level.isActive ? time : level.endTime, level.price, ink, line.style_solid)
    else
        f_hideLevel(level)
allDolLabels = array.copy(tf1Levels)
array.concat(allDolLabels, v3ExtraDols)
for level in allDolLabels
    nativeTf = level.tf == "TF1" ? tf1Input : level.tf
    showRole = v3NativeEnabled and v3DolShowInput and v3DolLabelsInput and level.dolRole != "" and (level.tf != "TF1" or showTf1)
    if showRole
        textValue = level.dolRole + " " + nativeTf + (level.dolCoverage ? " " : " coverage? ") + (level.dolState == 0 ? "U" : level.dolState == 1 ? "S" : "C")
        labelY = level.price + (level.isHighLow == "High" ? 1 : -1) * syminfo.mintick
        labelStyle = level.isHighLow == "High" ? label.style_label_down : label.style_label_up
        if na(level.dolLabel)
            if f_v3Room(0, 0, 1)
                level.dolLabel := label.new(level.startTime, labelY, textValue, xloc = xloc.bar_time, style = labelStyle, color = color.new(color.black, 100), textcolor = tf1MidColor, size = size.tiny)
        else
            label.set_xy(level.dolLabel, level.startTime, labelY)
            label.set_text(level.dolLabel, textValue)
    else if not na(level.dolLabel)
        label.delete(level.dolLabel)
        level.dolLabel := na
for gap in v3Gaps
    tf1Gap = f_v3TfKey(gap.nativeTf) == f_v3TfKey(tf1Input)
    tf2Gap = f_v3TfKey(gap.nativeTf) == f_v3TfKey(tf2Input)
    enabled = v3NativeEnabled and (gap.kind == "FVG" ? (tf1Gap and v3Tf1FvgInput) or (tf2Gap and v3Tf2FvgInput) : (tf1Gap and v3Tf1ViInput) or (tf2Gap and v3Tf2ViInput))
    endpoint = gap.active ? time_close(gap.nativeTf) : gap.endedAt
    ink = gap.kind == "FVG" ? v3FvgColorInput : v3ViColorInput
    if enabled
        if na(gap.id)
            if f_v3Room(0, 1, 0)
                gap.id := box.new(v3GapLeftInput == "Sequence start" ? gap.sequenceOrigin : gap.origin, gap.upper, endpoint, gap.lower, xloc = xloc.bar_time, border_color = ink, bgcolor = ink)
        else
            box.set_right(gap.id, endpoint)
    else
        f_v3DeleteGap(gap)
for setup in v3Setups
    if not v3NativeEnabled
        f_v3DeleteSetup(setup)
    else
        ink = setup.direction == 1 ? v3BullColorInput : v3BearColorInput
        endpoint = na(setup.endTime) ? time : setup.endTime
        zoneLo = setup.direction == 1 ? setup.manLow : math.max(setup.manOpen, setup.manClose)
        zoneHi = setup.direction == 1 ? math.min(setup.manOpen, setup.manClose) : setup.manHigh
        showGeometry = setup.actionable and (setup.state != "SUPERSEDED" or v3SupersededGeometryInput)
        if showGeometry and v3ShowZoneInput
            if na(setup.zoneId)
                if f_v3Room(0, 1, 0)
                    setup.zoneId := box.new(setup.origin, zoneHi, endpoint, zoneLo, xloc = xloc.bar_time, bgcolor = color.new(ink, 100-v3ZoneOpacityInput), border_color = color.new(ink, 65))
            else
                box.set_right(setup.zoneId, endpoint)
        else if not na(setup.zoneId)
            box.delete(setup.zoneId)
            setup.zoneId := na
        setup.highId := f_v3LevelLine(setup.highId, showGeometry and v3ShowRangeInput, setup.referenceTime, endpoint, setup.rangeHigh, ink, line.style_dotted)
        setup.lowId := f_v3LevelLine(setup.lowId, showGeometry and v3ShowRangeInput, setup.referenceTime, endpoint, setup.rangeLow, ink, line.style_dotted)
        setup.ceId := f_v3LevelLine(setup.ceId, showGeometry and v3ShowCeInput, setup.referenceTime, endpoint, (setup.rangeHigh+setup.rangeLow)/2, tf1MidColor, line.style_dashed)
        setup.targetId := f_v3LevelLine(setup.targetId, showGeometry and v3ShowTargetInput, setup.origin, endpoint, setup.target, ink, line.style_solid)
        setup.stopId := f_v3LevelLine(setup.stopId, showGeometry and v3ShowStopInput, setup.origin, endpoint, setup.stop, ink, line.style_dotted)
        setup.r3Id := f_v3LevelLine(setup.r3Id, showGeometry and v3ShowRrInput, setup.origin, endpoint, setup.r3, ink, line.style_dashed)
        setup.r5Id := f_v3LevelLine(setup.r5Id, showGeometry and v3ShowRrInput, setup.origin, endpoint, setup.r5, ink, line.style_dashed)
        for q = 0 to 7
            enabledQuadrant = q < array.size(v3QuadrantValues) and array.get(v3QuadrantSwitches, q)
            percentage = q < array.size(v3QuadrantValues) ? array.get(v3QuadrantValues, q) : float(na)
            price = zoneLo + (zoneHi-zoneLo) * percentage / 100.0
            handle = array.get(setup.quadrantIds, q)
            handle := f_v3LevelLine(handle, showGeometry and v3ShowQuarterInput and enabledQuadrant, setup.origin, endpoint, price, tf1MidColor, line.style_dotted)
            array.set(setup.quadrantIds, q, handle)
        if v3ShowTsInput
            textValue = "TS " + setup.variant + (setup.direction == 1 ? " LONG" : " SHORT")
            textValue += setup.actionable ? (v3RankingInput ? " " + setup.grade + " " + str.tostring(setup.score, "#.##") : "") + " -> " + setup.targetTf : " CONTEXT"
            textValue += (setup.opposition ? " OPPOSITION" : "") + (setup.twoSided ? " TWO SIDES" : "")
            textValue += "\n" + setup.state + (setup.fvg ? " FVG" : "") + (setup.vi ? " VI" : "") + (setup.caution ? " TF3?" : "") + (setup.dualHit ? " DUAL HIT" : "")
            if setup.actionable
                targetR = setup.direction * (setup.target-setup.entry) / math.abs(setup.stop-setup.entry)
                textValue += " Target " + str.tostring(targetR, "#.##") + "R"
            y = v3LabelPlacementInput == "At close" ? setup.manClose : setup.direction == 1 ? setup.manLow-v3LabelOffsetInput*syminfo.mintick : setup.manHigh+v3LabelOffsetInput*syminfo.mintick
            if na(setup.labelId)
                if f_v3Room(0, 0, 1)
                    setup.labelId := label.new(setup.origin, y, textValue, xloc = xloc.bar_time, style = setup.direction == 1 ? label.style_label_up : label.style_label_down, color = color.new(ink, 80), textcolor = ink, size = f_v3Size(v3LabelSizeInput))
            else
                label.set_text(setup.labelId, textValue)
        else if not na(setup.labelId)
            label.delete(setup.labelId)
            setup.labelId := na
// =============================================================================================
// SECTION 23 -- INDEPENDENT HTF CANDLE PANEL
// Display packets never feed setup/bias. Exact exchange-native weekly/monthly data is requested.
// =============================================================================================
type V3PanelCandle
    float o
    float h
    float l
    float c
    int t
    int boundary
    bool developing = false

type V3PanelGroup
    array<V3PanelCandle> history
    V3PanelCandle live = na
    string nativeTf = ""
    int desired = 1
    string name = ""

var array<V3PanelGroup> v3PanelGroups = array.new<V3PanelGroup>()
if barstate.isfirst
    for slot = 0 to 5
        array.push(v3PanelGroups, V3PanelGroup.new(history = array.new<V3PanelCandle>()))
v3PanelTfs = array.from(v3Panel1Tf, v3Panel2Tf, v3Panel3Tf, v3Panel4Tf, v3Panel5Tf, v3Panel6Tf)
v3PanelOns = array.from(v3Panel1On, v3Panel2On, v3Panel3On, v3Panel4On, v3Panel5On, v3Panel6On)
v3PanelCounts = array.from(v3Panel1Count, v3Panel2Count, v3Panel3Count, v3Panel4Count, v3Panel5Count, v3Panel6Count)
v3PanelNames = array.from(v3Panel1Label, v3Panel2Label, v3Panel3Label, v3Panel4Label, v3Panel5Label, v3Panel6Label)
var array<string> v3SeenPanel = array.new<string>()
array.clear(v3SeenPanel)
for slot = 0 to 5
    group = array.get(v3PanelGroups, slot)
    nativeTf = array.get(v3PanelTfs, slot)
    group.nativeTf := nativeTf
    group.desired := array.get(v3PanelCounts, slot)
    group.name := array.get(v3PanelNames, slot)
    eligible = v3PanelInput and array.get(v3PanelOns, slot) and f_v3TfRank(nativeTf) > f_v3TfRank(timeframe.period) and not array.includes(v3SeenPanel, f_v3TfKey(nativeTf))
    if eligible
        array.push(v3SeenPanel, f_v3TfKey(nativeTf))
        // Request one last-confirmed packet per native context, not one request per displayed candle.
        [o, h, l, c, t, boundary] = request.security(syminfo.tickerid, nativeTf, [open[1], high[1], low[1], close[1], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
        [liveO, liveH, liveL, liveC, liveT, liveEnd] = request.security(syminfo.tickerid, nativeTf, [open, high, low, close, time, time_close], lookahead = barmerge.lookahead_off)
        lastT = array.size(group.history) > 0 ? array.get(group.history, array.size(group.history)-1).t : na
        if not na(t) and (na(lastT) or t != lastT)
            array.push(group.history, V3PanelCandle.new(o, h, l, c, t, boundary))
            while array.size(group.history) > group.desired
                array.shift(group.history)
        // Historical lookahead_off can still refer to the previous HTF candle. Do not invent
        // a developing candle from that stale packet; show it only when its native time matches.
        currentNativeTime = time(nativeTf)
        group.live := not na(liveT) and liveT == currentNativeTime and not na(liveEnd) and timenow < liveEnd ? V3PanelCandle.new(liveO, liveH, liveL, liveC, liveT, liveEnd, true) : na
    else
        group.live := na

f_v3PanelBox(int left, float upper, int right, float lower, color fill, color border) =>
    if f_v3Room(0, 1, 0)
        handle = box.new(left, upper, right, lower, xloc = xloc.bar_time, bgcolor = fill, border_color = border)
        array.push(v3PanelBoxes, handle)
    true
f_v3PanelLine(int start, float y1, int finish, float y2, color ink, string styleValue, int widthValue) =>
    if f_v3Room(1, 0, 0)
        handle = line.new(start, y1, finish, y2, xloc = xloc.bar_time, color = ink, style = styleValue, width = widthValue)
        array.push(v3PanelLines, handle)
    true
f_v3PanelLabel(int x, float y, string textValue) =>
    if f_v3Room(0, 0, 1)
        handle = label.new(x, y, textValue, xloc = xloc.bar_time, style = label.style_none, textcolor = v3PanelLabelColorInput, size = f_v3Size(v3PanelLabelSizeInput))
        array.push(v3PanelLabels, handle)
    true
f_v3Countdown(int boundary) =>
    secondsLeft = int(math.max(boundary - timenow, 0) / 1000)
    daysLeft = int(secondsLeft / 86400)
    hoursLeft = int((secondsLeft % 86400) / 3600)
    minutesLeft = int((secondsLeft % 3600) / 60)
    daysLeft > 0 ? str.tostring(daysLeft) + "d " + str.tostring(hoursLeft) + "h" : str.tostring(hoursLeft) + "h " + str.tostring(minutesLeft) + "m " + str.tostring(secondsLeft % 60) + "s"

var table v3StatusTable = table.new(position.bottom_right, 1, 1)
if barstate.islast
    // The previous panel was deleted ahead of core rendering by the early registry cleanup.
    // Layout uses chart-duration units only for x coordinates. OHLC uses native feed packets.
    int unit = int(timeframe.in_seconds() * 1000)
    unit := math.max(nz(unit, 60000), 1)
    int cursor = time + unit * v3PanelPaddingInput
    int displayedGroups = 0
    int displayedCandles = 0
    int drawnGaps = 0
    int omitted = 0
    int skippedSlots = 0
    int skippedAnchors = 0
    float rowTop = na
    float rowBottom = na
    array<V3PanelGroup> chosen = array.new<V3PanelGroup>()
    array.clear(v3SeenPanel)
    if v3PanelInput
        for slot = 0 to 5
            group = array.get(v3PanelGroups, slot)
            enabled = array.get(v3PanelOns, slot)
            higher = f_v3TfRank(group.nativeTf) > f_v3TfRank(timeframe.period)
            skippedSlots += enabled and not higher ? 1 : 0
            if enabled and higher and displayedGroups < v3PanelLimitInput and not array.includes(v3SeenPanel, f_v3TfKey(group.nativeTf))
                array.push(v3SeenPanel, f_v3TfKey(group.nativeTf))
                array.push(chosen, group)
                displayedGroups += 1
                for candle in group.history
                    rowTop := na(rowTop) ? candle.h : math.max(rowTop, candle.h)
                    rowBottom := na(rowBottom) ? candle.l : math.min(rowBottom, candle.l)
                if not na(group.live)
                    rowTop := na(rowTop) ? group.live.h : math.max(rowTop, group.live.h)
                    rowBottom := na(rowBottom) ? group.live.l : math.min(rowBottom, group.live.l)
    labelOffset = math.max(nz(rowTop-rowBottom, 0)*0.025, syminfo.mintick*10)
    V3PanelCandle traceCandle = na
    int traceX = na
    int groupIndex = 0
    for group in chosen
        candles = array.copy(group.history)
        if not na(group.live)
            // Avoid duplicates when chart time is exactly a native close.
            if array.size(candles) == 0
                array.push(candles, group.live)
            else if array.get(candles, array.size(candles)-1).t != group.live.t
                array.push(candles, group.live)
        while array.size(candles) > group.desired
            array.shift(candles)
        // Reserve global headroom for all other modules and future core draws.
        freeCount = math.max(0, math.min(90-displayedCandles, math.min(470-array.size(line.all), 470-array.size(box.all))))
        while array.size(candles) > freeCount
            array.shift(candles)
            omitted += 1
        groupStart = cursor
        float groupHigh = na
        float groupLow = na
        int candleIndex = 0
        for candle in candles
            int left = cursor
            int right = left + unit*v3PanelWidthInput
            int center = int((left+right)/2)
            bullish = candle.c >= candle.o
            f_v3PanelBox(left, math.max(candle.o,candle.c), right, math.min(candle.o,candle.c), bullish ? v3PanelBullBody : v3PanelBearBody, bullish ? v3PanelBullBorder : v3PanelBearBorder)
            f_v3PanelLine(center, candle.l, center, candle.h, bullish ? v3PanelBullWick : v3PanelBearWick, line.style_solid, 1)
            groupHigh := na(groupHigh) ? candle.h : math.max(groupHigh,candle.h)
            groupLow := na(groupLow) ? candle.l : math.min(groupLow,candle.l)
            if candleIndex == array.size(candles)-1
                if groupIndex == 0 or v3PanelTraceAnchorInput == "Last Timeframe"
                    traceCandle := candle
                    traceX := center
            // Imbalances use CONFIRMED candles only. A forming candle is context, not a new zone.
            if not candle.developing and drawnGaps < 18
                if v3PanelFvgInput and candleIndex >= 2
                    older = array.get(candles,candleIndex-2)
                    gapDirection = candle.l > older.h ? 1 : candle.h < older.l ? -1 : 0
                    lower = gapDirection == 1 ? older.h : candle.h
                    upper = gapDirection == 1 ? candle.l : older.l
                    bool filled = false
                    if gapDirection != 0 and candleIndex+1 < array.size(candles)
                        for laterIndex = candleIndex+1 to array.size(candles)-1
                            later = array.get(candles,laterIndex)
                            filled := filled or (gapDirection == 1 ? later.l <= lower : later.h >= upper)
                    if gapDirection != 0 and not filled
                        gapLeft = groupStart + (candleIndex-2)*unit*(v3PanelWidthInput+v3PanelSpaceInput)
                        f_v3PanelBox(gapLeft, upper, right, lower, v3PanelFvgFillInput, v3PanelFvgBorderInput)
                        drawnGaps += 1
                if v3PanelViInput and candleIndex >= 1 and drawnGaps < 18
                    prior = array.get(candles,candleIndex-1)
                    overlap = math.min(candle.h,prior.h) >= math.max(candle.l,prior.l)
                    direction = candle.o > prior.c ? 1 : candle.o < prior.c ? -1 : 0
                    lower = v3ViWickExtendInput ? math.min(math.min(candle.o,prior.c), math.max(candle.l,prior.l)) : math.min(candle.o,prior.c)
                    upper = v3ViWickExtendInput ? math.max(math.max(candle.o,prior.c), math.min(candle.h,prior.h)) : math.max(candle.o,prior.c)
                    bool filled = false
                    if direction != 0 and candleIndex+1 < array.size(candles)
                        for laterIndex = candleIndex+1 to array.size(candles)-1
                            later = array.get(candles,laterIndex)
                            filled := filled or (direction == 1 ? later.l <= lower : later.h >= upper)
                    if overlap and direction != 0 and not filled
                        gapLeft = left-unit*(v3PanelWidthInput+v3PanelSpaceInput)
                        f_v3PanelBox(gapLeft, upper, right, lower, v3PanelViFillInput, v3PanelViBorderInput)
                        drawnGaps += 1
            cursor += unit*(v3PanelWidthInput+v3PanelSpaceInput)
            displayedCandles += 1
            candleIndex += 1
        if array.size(candles) > 0
            textValue = v3PanelLabelInput ? (group.name == "" ? group.nativeTf : group.name) : ""
            if v3PanelTimerInput
                liveCountdown = not na(group.live) and barstate.isrealtime and not barstate.isconfirmed and timenow < group.live.boundary
                textValue += "\n" + (liveCountdown ? f_v3Countdown(group.live.boundary) : "n/a")
            textValue += array.size(candles) < group.desired ? "\n" + str.tostring(array.size(candles)) + "/" + str.tostring(group.desired) + " available" : ""
            if textValue != ""
                y = v3PanelLabelPosInput == "Top" ? (v3PanelLabelAlignInput ? rowTop : groupHigh)+labelOffset : (v3PanelLabelAlignInput ? rowBottom : groupLow)-labelOffset
                f_v3PanelLabel(int((groupStart+cursor)/2), y, textValue)
        cursor += unit*v3PanelGroupSpaceInput
        groupIndex += 1
    if v3PanelInput and v3PanelTraceInput and not na(traceCandle)
        values = array.from(traceCandle.o,traceCandle.c,traceCandle.h,traceCandle.l)
        colors = array.from(v3TraceOpenColor,v3TraceCloseColor,v3TraceHighColor,v3TraceLowColor)
        styles = array.from(v3TraceOpenStyle,v3TraceCloseStyle,v3TraceHighStyle,v3TraceLowStyle)
        widths = array.from(v3TraceOpenWidth,v3TraceCloseWidth,v3TraceHighWidth,v3TraceLowWidth)
        for i = 0 to 3
            value = array.get(values,i)
            f_v3PanelLine(traceCandle.t, value, traceX, value, array.get(colors,i), f_v3Style(array.get(styles,i)), array.get(widths,i))
            if v3PanelPriceInput
                f_v3PanelLabel(traceX,value,str.tostring(value,format.mintick))
    status = ""
    if v3EnableInput and not v3ChartOk
        reason = not chart.is_standard ? "Use ordinary time-based candles." : na(f_v3TfRank(timeframe.period)) ? "Tick charts cannot run setups." : not f_v3TfLe(timeframe.period, tf2Input) ? "Chart timeframe is above TF2." : "TF2 is above TF1."
        status += "Setup engine: " + reason + "\n"
    if omitted > 0
        status += "Panel: " + str.tostring(omitted) + " candles hidden to keep drawing space.\n"
    if skippedSlots > 0 and v3PanelInput
        status += "Panel: " + str.tostring(skippedSlots) + " slot(s) hidden, set at or below your chart timeframe.\n"
    if v3NativeEnabled
        for slot = 0 to 2
            if array.get(v3ExtraOn, slot) and not f_v3TfLe(timeframe.period, array.get(v3ExtraTf, slot))
                skippedAnchors += 1
    if skippedAnchors > 0
        status += "Draw levels: " + str.tostring(skippedAnchors) + " anchor(s) below your chart timeframe.\n"
    if array.size(line.all) >= 470 or array.size(box.all) >= 470 or array.size(label.all) >= 470
        status += "Drawing space nearly full. Keep fewer candles or labels.\n"
    if array.get(v3QueueDrops,0) > 0
        status += "Alerts: " + str.tostring(array.get(v3QueueDrops,0)) + " older queued events dropped."
    table.cell(v3StatusTable,0,0,status,text_color = color.orange,text_size = size.tiny,bgcolor = color.new(color.black, status == "" ? 100 : 75), tooltip = "The panel draws only timeframes higher than the chart. An enabled slot at or below the chart timeframe is skipped. Drawing-space limits can hide older panel candles.")

// =============================================================================================
// SECTION 24 -- EA-FACING EVENT TRANSPORT
// One envelope preserves simultaneous transitions. Default flush requires a confirmed TF1 roll.
// Realtime mode changes transport timing only; it never changes native consumption or TS geometry.
// =============================================================================================
if v3ExportInput and barstate.isconfirmed and (newTf1Bar or v3ExportRealtimeInput)
    if array.size(v3PendingEvents) > 0
        envelope = "{\"schema\":\"rino.v3.phase1\",\"symbol\":" + f_v3Quote(syminfo.tickerid) + ",\"observedAt\":" + str.tostring(time_close) + ",\"chartTf\":" + f_v3Quote(timeframe.period) + ",\"events\":[" + array.join(v3PendingEvents,",") + "]}"
        alert(envelope,alert.freq_all)
        array.clear(v3PendingEvents)
