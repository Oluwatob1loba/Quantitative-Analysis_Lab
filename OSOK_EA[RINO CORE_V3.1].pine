                f_v3DolEvent(extra, extra.tf)
    if not na(v3Owner) and tf1ClosedT >= v3Owner.availableAt and (na(v3Owner.endTime) or (v3Owner.state == "DONE" and v3Owner.endTime >= tf1ClosedT))
        failed = v3Owner.direction == 1 ? tf1C < v3Owner.manLow : tf1C > v3Owner.manHigh
        hitTarget = v3Owner.direction == 1 ? tf1H >= v3Owner.target : tf1L <= v3Owner.target
        if failed
            v3Owner.dualHit := hitTarget
            f_v3Transition(v3Owner, "INVALIDATED", tf1ClosedEnd)
        else if hitTarget and na(v3Owner.endTime)
            f_v3Transition(v3Owner, "DONE", tf1ClosedEnd)
    // V3.1 amendment (owner-ratified): a pending episode whose frozen reference has fallen behind
    // the TF1 retention horizon has lost its verifiable evidence base and retires instead of
    // blocking every future detection. This is the system's own evidence horizon, not an
    // arbitrary timeout; multi-candle episodes complete or fail well inside it.
    // V3.1 amendment (revised): a pending episode retires when its aggregate candle count exceeds the
    // TF1 main lookback -- bounded and owner-tunable, killing zombie episodes (the 2007 case) without
    // violating TAD V3 §5, which forbids retiring a pending episode merely because its reference left
    // the rendered window. The withdrawn referenceTime-vs-anchor test retired EVERY episode on the
    // next roll whenever sub-lookback + 1 >= main lookback: the silent setups=0 on GBPCAD monthly.
    
    // M-1b pairwise sequential sweep (owner rule): comparisons run candle-vs-candle INSIDE the
    // window sequence, never against the window aggregate. A sweep is a strict trade below an
    // earlier window candle's own low (or above its high) that FAILS to close beyond it. The
    // completion reference is the highest swept low (long) / lowest swept high (short); the frozen
    // display bounds are the swept cluster's own extremes.
    if v3G1L > v3G1H2
        array.push(v3PoiPending, V3PoiCandidate.new(1, v3G1H2, v3G1L, v3G1End, tf1Input))
    if v3G1H < v3G1L2
        array.push(v3PoiPending, V3PoiCandidate.new(-1, v3G1H, v3G1L2, v3G1End, tf1Input))
    completed = not na(v3Manipulation) ? (v3Manipulation.sweptLow and v3Manipulation.c > v3Manipulation.closeRefLow) or (v3Manipulation.sweptHigh and v3Manipulation.c < v3Manipulation.closeRefHigh) : false
    if completed
        episode = v3Manipulation
        // Two-sided native OHLC does not reveal the path. Candidates preserved; priority order first.
        priorLive = (not na(v3Owner) and na(v3Owner.endTime)) ? v3Owner : na
        priorLiveClean = not na(priorLive) ? f_v3OwnerClean(priorLive) : false
        priorLiveDir = not na(priorLive) ? priorLive.direction : 0
        prioDir = f_v3PriorityDir((episode.h + episode.l) / 2.0)
        firstDir = prioDir != 0 ? prioDir : 1
        for cand = 0 to 1
            direction = cand == 0 ? firstDir : -firstDir
            qualifies = direction == 1 ? (episode.sweptLow and episode.c > episode.closeRefLow) : (episode.sweptHigh and episode.c < episode.closeRefHigh)
            if qualifies
                f_v3Touch(tf1Levels, episode.h, episode.l, episode.origin, episode.boundary, tf1Input)
                f_v3Touch(v3ExtraDols, episode.h, episode.l, episode.origin, episode.boundary, "")
                zoneLo = direction == 1 ? episode.l : math.max(episode.o, episode.c)
                zoneHi = direction == 1 ? math.min(episode.o, episode.c) : episode.h
                entryValue = (zoneLo + zoneHi) / 2.0
                [targetPrice, targetTf, targetOrigin, secPrice, secTf, secOrigin] = f_v3PickTarget(direction, entryValue, episode.origin)
                stopValue = direction == 1 ? episode.l - v3StopTicksInput * syminfo.mintick : episode.h + v3StopTicksInput * syminfo.mintick
                risk = math.abs(stopValue - entryValue)
                actionable = not na(targetPrice)
                contextReason = actionable ? "" : "no clean PDOL target (TF1 or higher)"

                // V3.1.1 PDOL Direction Gate (Owner Rule): Setup must align with the most recent undisturbed TF1 PDOL.
                // If the engine found a clear directional preference (prioDir != 0) and this setup opposes it, kill it.
                if actionable and prioDir != 0 and prioDir != direction
                    actionable := false
                    contextReason := "opposes TF1 draw (prio " + str.tostring(prioDir) + " vs dir " + str.tostring(direction) + ")"
                [poiHit, poiDiag] = f_v3PoiGate(direction, direction == 1 ? episode.l : episode.h, episode.origin, episode.boundary, episode.rangeLow, episode.rangeHigh)
                if actionable and not poiHit
                    actionable := false
                    contextReason := "no POI souped: " + poiDiag
                confLayers = not na(targetPrice) ? f_v3ConfluenceLayers(targetPrice, targetTf) : f_v3ConfluenceLayers(entryValue, tf1Input)
                intact = f_v3IntactPrimary(direction, entryValue, episode.boundary)
                cls = f_v3SetupClass(episode.o, episode.c, episode.h, episode.l, tf1PrevO, tf1PrevC)
                if cls == "A" and confLayers > 0
                    cls := "A+"
                [fvgTag, viTag] = f_v3GapTags(direction == 1 ? episode.l : episode.rangeHigh, direction == 1 ? episode.rangeLow : episode.h, episode.origin, episode.boundary)
                // V3.2 C-4: T1-by-class (Corrected A/B definition)
                // Class A (Opposing close): Target = TS candle's PDOL (Recovery extreme)
                // Class B (Same-color close): Target = TS candle's SDOL (Manipulation extreme)
                float t1Cand = na
                bool t1Flip = false
                bool tsBullish = episode.c > episode.o

                if cls == "A" or cls == "A+"
                    // Class A: Target PDOL. If TS is bullish, PDOL = High. If bearish, PDOL = Low.
                    t1Cand := tsBullish ? episode.h : episode.l
                else
                    // Class B: Target SDOL. If TS is bullish, SDOL = Low. If bearish, SDOL = High.
                    t1Cand := tsBullish ? episode.l : episode.h

                // Profit-side guard: If T1 is on the wrong side of entry, flip it and log it.
                if not na(t1Cand) and not na(entryValue)
                    bool profitOk = direction == 1 ? t1Cand > entryValue : t1Cand < entryValue
                    if not profitOk
                        t1Cand := tsBullish ? (cls == "A" or cls == "A+" ? episode.l : episode.h) : (cls == "A" or cls == "A+" ? episode.h : episode.l)
                        t1Flip := true
                setup = V3Setup.new(setupId = tf1Input + ":" + str.tostring(episode.origin) + ":" + str.tostring(direction), origin = episode.origin, availableAt = episode.boundary, referenceTime = episode.referenceTime, rangeHigh = episode.rangeHigh, rangeLow = episode.rangeLow, manOpen = episode.o, manHigh = episode.h, manLow = episode.l, manClose = episode.c, direction = direction, variant = episode.candles == 1 ? "Window" : "WindowMulti", actionable = actionable, target = targetPrice, targetTf = targetTf, targetOrigin = targetOrigin, secondaryTarget = secPrice, secondaryTf = secTf, secondaryOrigin = secOrigin, entry = actionable ? entryValue : na, stop = actionable ? stopValue : na, r3 = actionable ? entryValue + direction * 3 * risk : na, r5 = actionable ? entryValue + direction * 5 * risk : na, quadrantIds = array.new<line>(4, na), opposition = priorLiveClean and direction != priorLiveDir, twoSided = episode.sweptHigh and episode.sweptLow, manipulationCandles = episode.candles, confluence = confLayers > 0, aligned = actionable and f_v3Alignment(direction, entryValue, targetTf), fvg = fvgTag, vi = viTag, location = direction == 1 ? entryValue < (episode.rangeHigh + episode.rangeLow) / 2 : entryValue > (episode.rangeHigh + episode.rangeLow) / 2, t1 = t1Cand, t1Flipped = t1Flip)
                setup.setupClass := cls
                setup.confluenceLayers := confLayers
                setup.intactPrimary := intact
                setup.contextReason := contextReason
                f_v3TsExport(setup)
                if actionable
                    // D-33: no supersession; owner tracks the most recent actionable setup only.
                    v3Owner := setup
                    f_v3Transition(setup, "MANIPULATION", episode.boundary)
                    f_v3Grade(setup, episode.boundary)
                else
                    setup.endTime := episode.boundary
                    f_v3Grade(setup, episode.boundary)
                array.push(v3Setups, setup)
                while array.size(v3Setups) > v3SetupKeepInput
                    removed = array.shift(v3Setups)
                    if not na(v3Owner) and removed.setupId == v3Owner.setupId
                        f_v3Transition(removed, "EXPIRED", tf1ClosedEnd)
                        v3Owner := na
                    f_v3DeleteSetup(removed)
        v3Manipulation := na
        
    // Idle references have no event or geometry. Pending sweeps own one constant-size stamp.
    
    if not na(v3Manipulation)
        v3RangeState := "SWEEP_PENDING"
        v3RangeOrigin := v3Manipulation.referenceTime
        v3RangeHigh := v3Manipulation.rangeHigh
        v3RangeLow := v3Manipulation.rangeLow
    else
        v3RangeState := not na(v3Owner) and na(v3Owner.endTime) ? v3Owner.state : "RANGE_SET"
        v3RangeOrigin := v3WindowT
        v3RangeHigh := v3WindowH
        v3RangeLow := v3WindowL

/// Owner rule: lower timeframes never commit state. Touches, DONE and DISTRIBUTION are decided
// only by TF1 native packets in the roll block above. The live-bar fade in the color refresh
// below remains a display-only preview and exports nothing.

// The DOL tag lives on its parent Level. Confluence is recomputed, not accumulated.
if v3NativeEnabled and v3DolRefresh
    for level in tf1Levels
        level.dolConfluent := level.dolRole == "PDOL" and level.dolState == 0 and level.dolCoverage and f_v3Confluence(level.price, tf1Input)
    for level in v3ExtraDols
        level.dolConfluent := level.dolRole == "PDOL" and level.dolState == 0 and level.dolCoverage and f_v3Confluence(level.price, level.tf)

// Refresh primary colors after this bar's DOL state settles, avoiding a one-bar visual delay.
if v3NativeEnabled and v3DolShowInput and showTf1
    for level in tf1Levels
        if not na(level.id) and level.dolRole != ""
            base = f_lineColor(level)
            faded = level.dolState == 1 or (not barstate.isconfirmed and time >= level.availableAt and (level.isHighLow == "High" ? high >= level.price : low <= level.price)) or (not na(tf1SubLookbackCutoff) and level.startTime < tf1SubLookbackCutoff)
            ink = level.dolConfluent and level.dolState == 0 ? v3ConfluentColorInput : faded ? f_fadeColor(base, fadeOpacityInput) : base
            line.set_color(level.id, ink)

// =============================================================================================
// SECTION 20 -- V3 KEY LEVELS: FVG AND PRICE-BODY VOLUME IMBALANCE
// Neither key level gates TS geometry. Pre-existing zones tag a manipulation before fill commits.
// =============================================================================================

if v3NativeEnabled
    for pass = 0 to 1
        nativeTf = pass == 0 ? tf1Input : tf2Input
        rolled = pass == 0 ? newTf1Bar : newTf2Bar
        if rolled and (pass == 0 or (f_v3TfKey(tf2Input) != f_v3TfKey(tf1Input) and (v3Tf2FvgInput or v3Tf2ViInput)))
            gh = pass == 0 ? v3G1H : v3G2H
            gl = pass == 0 ? v3G1L : v3G2L
            gt = pass == 0 ? v3G1T : v3G2T
            ge = pass == 0 ? v3G1End : v3G2End
            gh2 = pass == 0 ? v3G1H2 : v3G2H2
            gl2 = pass == 0 ? v3G1L2 : v3G2L2
            go = pass == 0 ? v3G1O : v3G2O
            gc1 = pass == 0 ? v3G1C1 : v3G2C1
            gh1 = pass == 0 ? v3G1H1 : v3G2H1
            gl1 = pass == 0 ? v3G1L1 : v3G2L1
            sequence = pass == 0 ? v3G1Seq : v3G2Seq
            prior = pass == 0 ? v3G1Prior : v3G2Prior
            // Own-timeframe complete OHLC fills an already-available zone at native close.
            for gap in v3Gaps
                if gap.active and f_v3TfKey(gap.nativeTf) == f_v3TfKey(nativeTf) and gap.availableAt <= gt
                    filled = gap.direction == 1 ? gl <= gap.lower : gh >= gap.upper
                    if filled
                        gap.active := false
                        gap.endedAt := ge
            if gl > gh2
                f_v3AddGap("FVG", nativeTf, 1, gh2, gl, gt, ge, sequence)
            if gh < gl2
                f_v3AddGap("FVG", nativeTf, -1, gh, gl2, gt, ge, sequence)
            overlapLow = math.max(gl, gl1)
            overlapHigh = math.min(gh, gh1)
            viWidth = math.abs(go - gc1)
            if overlapHigh >= overlapLow and go != gc1 and not na(gc1) and (v3ViMinWidthPctInput <= 0 or viWidth >= (gh - gl) * v3ViMinWidthPctInput / 100.0)
                lower = math.min(go, gc1)
                upper = math.max(go, gc1)
                f_v3AddGap("VI", nativeTf, go > gc1 ? 1 : -1, lower, upper, gt, ge, prior)
    idxGap = array.size(v3Gaps) - 1
    while idxGap >= 0
        gap = array.get(v3Gaps, idxGap)
        cutoff = not na(gap.retireAt) ? gap.retireAt : f_v3TfKey(gap.nativeTf) == f_v3TfKey(tf1Input) ? v3G1Cutoff : v3G2Cutoff
        // L-1: drawDead retires RECORDS only for the TF2 family (flash-only, never gates). TF1 and
        // anchor records survive their drawing life so G-POI can gate against POIs formed days ago;
        // their boxes still hide on schedule via the drawDead box-deletion line in Section 22.
        if (not na(cutoff) and gap.origin < cutoff) or (gap.drawDead and f_v3TfKey(gap.nativeTf) == f_v3TfKey(tf2Input))
            f_v3DeleteGap(gap)
            array.remove(v3Gaps, idxGap)
        idxGap -= 1

// =============================================================================================
// SECTION 20B -- ORDER BLOCK RESEARCH FRAMEWORK (P-2 scaffold: draw-only, never gates)
// =============================================================================================
v3ObEnableInput   = input.bool(false, "Order block outlines (research framework)", group = "V3 Key Levels", tooltip = "Default: off. Draw-only +/- OB scaffold on TF1 native candles; never enters the POI gate. Mitigation and composite flags are research fields.")
v3ObDispMultInput = input.float(1.5, "Displacement multiple of prior candle range", minval = 0.5, step = 0.1, maxval = 10.0, group = "V3 Key Levels", tooltip = "Default: 1.5. The displacement candle's range must be at least this multiple of the OB candle's range.")
v3ObColorInput    = input.color(color.new(#26a69a, 80), "Bullish OB", group = "V3 Key Levels", inline = "obc")
v3ObBearColorInput = input.color(color.new(#ef5350, 80), "Bearish OB", group = "V3 Key Levels", inline = "obc")
type V3Ob
    int origin
    int boundary
    int direction
    float lower
    float upper
    bool composite = false
    bool mitigated = false
    int mitigatedAt = na
    box id = na
    line midId = na
var array<V3Ob> v3Obs = array.new<V3Ob>()
if v3NativeEnabled and v3ObEnableInput and newTf1Bar
    priorRange = v3G1H1 - v3G1L1
    dispOk = priorRange > 0 and (tf1H - tf1L) >= v3ObDispMultInput * priorRange
    obDir = dispOk and tf1C > tf1O and tf1PrevC < tf1PrevO ? 1 : dispOk and tf1C < tf1O and tf1PrevC > tf1PrevO ? -1 : 0
    if obDir != 0
        obLo = math.min(tf1PrevO, tf1PrevC)
        obHi = math.max(tf1PrevO, tf1PrevC)
        isComp = obDir == 1 ? tf1L > v3G1H2 : tf1H < v3G1L2
        if isComp
            obLo := obDir == 1 ? v3G1L1 : tf1L
            obHi := obDir == 1 ? tf1H : v3G1H1
        array.push(v3Obs, V3Ob.new(origin = tf1ClosedT, boundary = tf1ClosedEnd, direction = obDir, lower = obLo, upper = obHi, composite = isComp))
    for ob in v3Obs
        if not ob.mitigated and ob.boundary <= tf1ClosedT
            if ob.direction == 1 ? tf1L <= ob.upper : tf1H >= ob.lower
                ob.mitigated := true
                ob.mitigatedAt := tf1ClosedEnd
    while array.size(v3Obs) > 12
        oldOb = array.shift(v3Obs)
        if not na(oldOb.id)
            box.delete(oldOb.id)
        if not na(oldOb.midId)
            line.delete(oldOb.midId)
if v3NativeEnabled and v3ObEnableInput
    for ob in v3Obs
        inkOb = ob.direction == 1 ? v3ObColorInput : v3ObBearColorInput
        if ob.mitigated
            inkOb := color.new(inkOb, 90)
        if na(ob.id) and f_v3Room(0, 1, 0)
            ob.id := box.new(ob.origin, ob.upper, time, ob.lower, xloc = xloc.bar_time, border_color = inkOb, bgcolor = color.new(inkOb, 85))
        else if not na(ob.id)
            box.set_right(ob.id, time)
            box.set_border_color(ob.id, inkOb)
        if ob.composite
            midOb = (ob.upper + ob.lower) / 2.0
            if na(ob.midId) and f_v3Room(1, 0, 0)
                ob.midId := line.new(ob.origin, midOb, time, midOb, xloc = xloc.bar_time, color = inkOb, style = line.style_dotted, width = 1)
            else if not na(ob.midId)
                line.set_x2(ob.midId, time)

// =============================================================================================
// SECTION 21 -- V3 SETUP CONTEXT RANKING AND LIFETIME
// Ranking reads structural facts. It does not promote Minor breaks into protected-swing CHoCH.
// =============================================================================================
if v3NativeEnabled and newTf2Bar
    if bias != biasBeforeClose
        f_v3Event("TF2_BIAS", tf2Input, tf2ClosedT, tf2ClosedEnd, ",\"from\":" + f_v3Quote(biasBeforeClose) + ",\"to\":" + f_v3Quote(bias))
    for setup in v3Setups
        if setup.actionable and na(setup.endTime) and tf2ClosedEnd >= setup.availableAt
            for layer = 0 to 1
                levels = layer == 0 ? tf2Levels : tf2MinorLevels
                for level in levels
                    if not level.isActive and level.endTime == tf2ClosedT and tf2ClosedT >= setup.origin
                        directionMatches = setup.direction == 1 ? level.isHighLow == "High" : level.isHighLow == "Low"
                        if directionMatches
                            classification = level.isCritical ? "Critical" : layer == 0 ? "Major" : "Minor"
                            rank = classification == "Critical" ? 3 : classification == "Major" ? 2 : 1
                            priorRank = setup.breakClass == "Critical" ? 3 : setup.breakClass == "Major" ? 2 : setup.breakClass == "Minor" ? 1 : 0
                            if rank >= priorRank
                                setup.breakClass := classification
            f_v3Grade(setup, tf2ClosedEnd)

// Anchor-window eviction applies in addition to the count cap: no stale setup extends forever.
setupIndex = array.size(v3Setups) - 1
while setupIndex >= 0
    setup = array.get(v3Setups, setupIndex)
    if not na(tf1WindowAnchor) and setup.availableAt <= tf1WindowAnchor
        if na(setup.endTime)
            f_v3Transition(setup, "EXPIRED", time)
        f_v3DeleteSetup(setup)
        array.remove(v3Setups, setupIndex)
    setupIndex -= 1
if not na(v3Owner)
    if v3Owner.availableAt <= tf1WindowAnchor
        v3Owner := na

// =============================================================================================
// SECTION 21B -- TF3 MICROSTRUCTURE: alternating swing marks + caution flag (V3.2 item 1)
// =============================================================================================
tf3Input = input.timeframe("60", "TF3 - Microstructure", group = "V3 Setup Engine", tooltip = "Default: 60. Microstructure layer strictly below TF2. Swing marks are draw-only; a TF3 close through a TF2 swing in setup direction after the gate pass sets caution: ranked, but traded with care.")
v3Tf3MarksInput = input.bool(false, "Mark TF3 alternating swings", group = "V3 Setup Engine", tooltip = "Default: off. Tiny grey circles at confirmed TF3 alternating swing extremes. Draw-only, capped at 12.")
f_v3Tf3Packet() =>
    [high[1], low[1], close[1], close[2], time[1], time_close[1]]
[t3H, t3L, t3C, t3C1, t3T, t3End] = request.security(syminfo.tickerid, tf3Input, f_v3Tf3Packet(), lookahead = barmerge.lookahead_on)
bool newTf3Bar = not na(t3T) and t3T != t3T[1]
var float t3RunHigh = na
var float t3RunLow = na
var int t3RunHighT = na
var int t3RunLowT = na
var int t3Side = 0
var array<label> t3Marks = array.new<label>()
if v3NativeEnabled and newTf3Bar
    if na(t3RunHigh)
        t3RunHigh := t3H
        t3RunLow := t3L
        t3RunHighT := t3T
        t3RunLowT := t3T
    else
        if t3H > t3RunHigh
            t3RunHigh := t3H
            t3RunHighT := t3T
            if t3Side == -1 and v3Tf3MarksInput and f_v3Room(0, 0, 1)
                array.push(t3Marks, label.new(t3RunLowT, t3RunLow, "", xloc = xloc.bar_time, style = label.style_circle, color = color.new(color.gray, 40), textcolor = color.new(color.gray, 100), size = size.tiny))
            t3Side := 1
        if t3L < t3RunLow
            t3RunLow := t3L
            t3RunLowT := t3T
            if t3Side == 1 and v3Tf3MarksInput and f_v3Room(0, 0, 1)
                array.push(t3Marks, label.new(t3RunHighT, t3RunHigh, "", xloc = xloc.bar_time, style = label.style_circle, color = color.new(color.gray, 40), textcolor = color.new(color.gray, 100), size = size.tiny))
            t3Side := -1
    while array.size(t3Marks) > 12
        label.delete(array.shift(t3Marks))
    for setup in v3Setups
        if setup.actionable and na(setup.endTime) and t3End >= setup.availableAt and not setup.caution
            for lvl in tf2Levels
                if lvl.tf == "TF2" and (setup.direction == 1 ? (lvl.isHighLow == "High" and t3C > lvl.price and t3C1 <= lvl.price) : (lvl.isHighLow == "Low" and t3C < lvl.price and t3C1 >= lvl.price))
                    setup.caution := true

// =============================================================================================
// SECTION 22 -- V3 OBJECT RENDERING
// Every drawing owns a handle. Hidden modules preserve stamps; evictions destroy both.
// =============================================================================================
f_v3LevelLine(line handle, bool enabled, int origin, int endpoint, float price, color lineColor, string styleValue) =>
    line result = handle
    if not enabled or na(price)
        if not na(result)
            line.delete(result)
            result := na
    else if na(result)
        if f_v3Room(1, 0, 0)
            result := line.new(origin, price, endpoint, price, xloc = xloc.bar_time, color = lineColor, style = styleValue, width = v3LineWidthInput)
    else
        line.set_xy2(result, endpoint, price)
        line.set_color(result, lineColor)
    result
for level in v3ExtraDols
    isTf2Layer = level.tf != "TF1" and f_v3TfRank(level.tf) <= f_v3TfRank(tf1Input)
    showLayer = v3NativeEnabled and v3DolShowInput and (not isTf2Layer or (v3ShowTf2SweepsInput and (v3ConsumeTf2DrawsInput or level.dolState != 0)))
    if showLayer
        dirBase = level.tf1Direction == "up" ? (level.isHighLow == "High" ? tf1HighColor : tf1LowColor) : (level.isHighLow == "High" ? tf1LowColor : tf1HighColor)
        base = isTf2Layer and not v3ConsumeTf2DrawsInput ? v3Tf2SweepColorInput : dirBase
        ink = level.dolState == 1 ? f_fadeColor(base, fadeOpacityInput) : level.dolConfluent and level.dolState == 0 ? v3ConfluentColorInput : base
        level.id := f_v3LevelLine(level.id, true, level.startTime, level.isActive ? time : level.endTime, level.price, ink, line.style_solid)
        if not na(level.id)
            line.set_width(level.id, v3AnchorLineWidthInput)
    else
        f_hideLevel(level)
// Performance gate (owner runtime-timeout fix at lookback 27/sub 25): the DOL label pass with its
// collision registry is the only per-bar quadratic loop in the script. Label text, position and
// stacking change only when a TF1/anchor roll commits new state, so the pass runs on rolls and on
// the first/last bar; between rolls the already-created label objects persist untouched.
bool labelPassNow = v3DolRefresh or barstate.islast or barstate.isfirst
allDolLabels = array.copy(tf1Levels)
array.concat(allDolLabels, v3ExtraDols)
var array<int> usedLabelX = array.new<int>()
var array<float> usedLabelY = array.new<float>()
float labelStep = math.max(nz(ta.highest(high, 200) - ta.lowest(low, 200), 0) * 0.006, syminfo.mintick * 10)
labelTimeEps = (timeframe.in_seconds() <= 3600 ? 24 : timeframe.in_seconds() <= 14400 ? 16 : 4) * math.max(timeframe.in_seconds(timeframe.period) * 1000, 1)
array.clear(usedLabelX)
array.clear(usedLabelY)
for level in allDolLabels
    nativeTf = level.tf == "TF1" ? tf1Input : level.tf
    showRole = labelPassNow and v3NativeEnabled and v3DolShowInput and v3DolLabelsInput and level.dolRole != "" and (level.tf != "TF1" or showTf1) and not (level.dolRole == "SDOL" and level.dolState == 0)
    if showRole
        if level.isHighLow == "High" or level.isHighLow == "Low"
            f_refineDolX(level, timeframe.in_seconds(nativeTf) * 1000)
        labelX = na(level.dolX) ? level.startTime : level.dolX
        textValue = level.dolRole + " " + f_v3TfName(nativeTf) + (level.dolCoverage ? " " : " coverage? ") + (level.dolState == 0 ? "U" : level.dolState == 1 ? "S" : "C")
        labelY = level.price + (level.isHighLow == "High" ? 1 : -1) * syminfo.mintick
        bool collided = true
        int guard = 0
        while collided and guard < 12
            collided := false
            int nU = math.min(array.size(usedLabelX), array.size(usedLabelY))
            int iU = 0
            while iU < nU
                if math.abs(array.get(usedLabelX, iU) - level.startTime) < labelTimeEps and math.abs(array.get(usedLabelY, iU) - labelY) < labelStep
                    collided := true
                    break
                iU += 1
            if collided
                labelY := labelY + (level.isHighLow == "High" ? labelStep : -labelStep)
                guard += 1
        array.push(usedLabelX, level.startTime)
        array.push(usedLabelY, labelY)
        labelStyle = level.isHighLow == "High" ? label.style_label_down : label.style_label_up
        if na(level.dolLabel)
            if f_v3Room(0, 0, 1)
                level.dolLabel := label.new(labelX, labelY, textValue, xloc = xloc.bar_time, style = labelStyle, color = color.new(color.black, 100), textcolor = tf1MidColor, size = size.tiny)
        else
            label.set_xy(level.dolLabel, labelX, labelY)
            label.set_text(level.dolLabel, textValue)
    else if not na(level.dolLabel)
        label.delete(level.dolLabel)
        level.dolLabel := na
for gap in v3Gaps
    tf1Gap = f_v3TfKey(gap.nativeTf) == f_v3TfKey(tf1Input)
    tf2Gap = f_v3TfKey(gap.nativeTf) == f_v3TfKey(tf2Input)
    a1Gap = f_v3TfKey(gap.nativeTf) == f_v3TfKey(v3Dol1Tf)
    a2Gap = f_v3TfKey(gap.nativeTf) == f_v3TfKey(v3Dol2Tf)
    a3Gap = f_v3TfKey(gap.nativeTf) == f_v3TfKey(v3Dol3Tf)
    enabled = v3NativeEnabled and (gap.kind == "FVG" ? (tf1Gap and v3Tf1FvgInput) or (tf2Gap and v3Tf2FvgInput) or (a1Gap and v3Dol1On and v3Dol1Fvg) or (a2Gap and v3Dol2On and v3Dol2Fvg) or (a3Gap and v3Dol3On and v3Dol3Fvg) : (tf1Gap and v3Tf1ViInput) or (tf2Gap and v3Tf2ViInput))
    nativeMs = timeframe.in_seconds(gap.nativeTf) * 1000
    if time > gap.availableAt + v3GapDrawKeepInput * nativeMs
        gap.drawDead := true
    if gap.drawDead and f_v3TfKey(gap.nativeTf) != f_v3TfKey(tf1Input) and not na(gap.id)
        box.delete(gap.id)
        gap.id := na
    endpoint = not gap.active ? (not na(gap.endedAt) ? gap.endedAt : gap.availableAt) : v3GapExtendInput == "Until filled" ? time_close(gap.nativeTf) : gap.availableAt
    ink = gap.kind == "FVG" ? v3FvgColorInput : v3ViColorInput
    if enabled
        if na(gap.id)
            if f_v3Room(0, 1, 0)
                if not (gap.drawDead and f_v3TfKey(gap.nativeTf) != f_v3TfKey(tf1Input))
                    gap.id := box.new(gap.sequenceOrigin, gap.upper, endpoint, gap.lower, xloc = xloc.bar_time, border_color = gap.kind == "FVG" ? v3FvgBorderInput : v3ViBorderInput, bgcolor = ink)
        else
            box.set_right(gap.id, endpoint)
    else
        f_v3DeleteGap(gap)
    midPrice = (gap.upper + gap.lower) / 2.0
    bool gapVisible = enabled and not (gap.drawDead and f_v3TfKey(gap.nativeTf) != f_v3TfKey(tf1Input))
    if gap.kind == "FVG" and v3FvgMidInput and gapVisible
        if na(gap.midId)
            if f_v3Room(1, 0, 0)
                gap.midId := line.new(gap.sequenceOrigin, midPrice, endpoint, midPrice, xloc = xloc.bar_time, color = color.new(v3FvgBorderInput, 15), style = f_v3Style(v3FvgMidStyleInput), width = v3FvgMidWidthInput)
        else
            line.set_xy2(gap.midId, endpoint, midPrice)
    else if not na(gap.midId)
        line.delete(gap.midId)
        gap.midId := na
    if gap.kind == "FVG" and v3FvgLabelInput and gapVisible and labelPassNow
        midX = v3FvgLabelPosInput == "Center" ? int((gap.sequenceOrigin + endpoint) / 2) : gap.sequenceOrigin
        midY = midPrice
        // FVG timeframe tags join the shared collision registry (owner fixture: EURJPY 1D label mash):
        // they avoid DOL labels placed earlier this pass, and setup labels placed later avoid them.
        bool gCollided = true
        int gGuard = 0
        while gCollided and gGuard < 12
            gCollided := false
            int gU = 0
            int gN = math.min(array.size(usedLabelX), array.size(usedLabelY))
            while gU < gN
                if math.abs(array.get(usedLabelX, gU) - midX) < labelTimeEps and math.abs(array.get(usedLabelY, gU) - midY) < labelStep
                    gCollided := true
                    break
                gU += 1
            if gCollided
                midY := midY + labelStep
                gGuard += 1
        array.push(usedLabelX, midX)
        array.push(usedLabelY, midY)
        if na(gap.midLabel)
            if f_v3Room(0, 0, 1)
                gap.midLabel := label.new(midX, midY, f_v3TfName(gap.nativeTf), xloc = xloc.bar_time, style = label.style_none, textcolor = v3FvgBorderInput, size = size.tiny)
            else
                label.set_xy(gap.midLabel, midX, midY)
        else if not (gap.kind == "FVG" and v3FvgLabelInput and gapVisible) and not na(gap.midLabel)
            label.delete(gap.midLabel)
        gap.midLabel := na
for setup in v3Setups
    if not v3NativeEnabled
        f_v3DeleteSetup(setup)
    else
        ink = setup.actionable ? (setup.direction == 1 ? v3BullColorInput : v3BearColorInput) : color.new(setup.direction == 1 ? v3BullColorInput : v3BearColorInput, 55)
        endpoint = na(setup.endTime) ? time : setup.endTime
        zoneEnd = na(setup.endTime) ? setup.availableAt : setup.endTime
        zoneLo = setup.direction == 1 ? setup.manLow : math.max(setup.manOpen, setup.manClose)
        zoneHi = setup.direction == 1 ? math.min(setup.manOpen, setup.manClose) : setup.manHigh
        showGeometry = setup.actionable
        if showGeometry and v3ShowZoneInput
            if na(setup.zoneId)
                if f_v3Room(0, 1, 0)
                    setup.zoneId := box.new(setup.origin, zoneHi, zoneEnd, zoneLo, xloc = xloc.bar_time, bgcolor = color.new(ink, 100-v3ZoneOpacityInput), border_color = color.new(ink, 65))
            else
                box.set_right(setup.zoneId, zoneEnd)
        else if not na(setup.zoneId)
            box.delete(setup.zoneId)
            setup.zoneId := na
        setup.highId := f_v3LevelLine(setup.highId, showGeometry and v3ShowRangeInput, setup.referenceTime, endpoint, setup.rangeHigh, ink, line.style_dotted)
        setup.lowId := f_v3LevelLine(setup.lowId, showGeometry and v3ShowRangeInput, setup.referenceTime, endpoint, setup.rangeLow, ink, line.style_dotted)
        setup.ceId := f_v3LevelLine(setup.ceId, showGeometry and v3ShowCeInput, setup.referenceTime, endpoint, (setup.rangeHigh+setup.rangeLow)/2, tf1MidColor, line.style_dashed)
        quadrantPcts = array.from(25.0, 50.0, 75.0, 100.0)
        quadrantOns  = array.from(v3Quad1Input, v3Quad2Input, v3Quad3Input, v3Quad4Input)
        for q = 0 to 3
            enabledQuadrant = array.get(quadrantOns, q)
            percentage = array.get(quadrantPcts, q)
            price = zoneLo + (zoneHi-zoneLo) * percentage / 100.0
            handle = array.get(setup.quadrantIds, q)
            // Owner rule: quadrant lines are furniture of the entry-zone rectangle; they end where the zone
            // ends (zoneEnd), never live-extending to bar 0 the way price-reference lines do. Worst offender
            // on lower timeframes, where a live-extending quadrant reads as a phantom level.
            handle := f_v3LevelLine(handle, showGeometry and v3ShowQuarterInput and enabledQuadrant, setup.origin, zoneEnd, price, tf1MidColor, line.style_dotted)
            array.set(setup.quadrantIds, q, handle)
        if v3ShowTsInput and (labelPassNow or na(setup.labelId))
            textValue = "TS " + setup.variant + (setup.direction == 1 ? " LONG" : " SHORT")
            textValue += setup.actionable ? " -> " + f_v3TfName(setup.targetTf) : " CONTEXT"
            textValue += (setup.opposition ? " OPPOSITION" : "") + (setup.twoSided ? " TWO SIDES" : "")
            textValue += "\n" + (setup.fvg ? " FVG" : "") + (setup.vi ? " VI" : "") + (setup.caution ? " TF3?" : "") + (setup.dualHit ? " DUAL HIT" : "")
                
            y = v3LabelPlacementInput == "At close" ? setup.manClose : setup.direction == 1 ? setup.manLow-v3LabelOffsetInput*syminfo.mintick : setup.manHigh+v3LabelOffsetInput*syminfo.mintick
            if setup.twoSided and setup.direction == -1
                y := y + 2 * v3LabelOffsetInput * syminfo.mintick
        // Setup labels share the DOL collision registry: a TS label must never print on top of a
        // PDOL/SDOL label (or another setup label placed earlier this pass). Same rule as the DOL
        // stack -- shift away by one label step until the slot is free; zero extra spacing beyond
        // what avoidance requires, per owner tolerance.
            bool sCollided = true
            int sGuard = 0
            while sCollided and sGuard < 12
                sCollided := false
                int sU = 0
                int sN = math.min(array.size(usedLabelX), array.size(usedLabelY))
                while sU < sN
                    if math.abs(array.get(usedLabelX, sU) - setup.origin) < labelTimeEps and math.abs(array.get(usedLabelY, sU) - y) < labelStep
                        sCollided := true
                        break
                    sU += 1
                if sCollided
                    y := y + (setup.direction == 1 ? -labelStep : labelStep)
                    sGuard += 1
                array.push(usedLabelX, setup.origin)
                array.push(usedLabelY, y)    
            if na(setup.labelId)
                if array.size(label.all) + 1 < 470
                    setup.labelId := label.new(setup.origin, y, textValue, xloc = xloc.bar_time, style = setup.direction == 1 ? label.style_label_up : label.style_label_down, color = color.new(ink, 80), textcolor = ink, size = f_v3Size(v3LabelSizeInput))
            else
                label.set_text(setup.labelId, textValue)
        else if not v3ShowTsInput and not na(setup.labelId)
            label.delete(setup.labelId)
            setup.labelId := na


// =============================================================================================
// SECTION 23B -- CORE STATUS TABLE (restored: the original lived inside the panel section that
// moved to SPATIAL). CORE reports only engine and resource conditions; panel messages live there.
// =============================================================================================
// V3.2: index of the most recent gate-cleared (actionable) setup; -1 when none retained.
f_v3LastGatedIdx() =>
    int idx = -1
    int j = array.size(v3Setups) - 1
    while j >= 0 and idx < 0
        if array.get(v3Setups, j).actionable
            idx := j
        j -= 1
    idx
var table v3StatusTable = table.new(position.bottom_right, 1, 9)
if barstate.islast
    table.clear(v3StatusTable, 0, 0, 0, 8)
    statusA = ""
    statusB = ""
    statusC = ""
    if v3EnableInput and not v3ChartOk
        reason = not chart.is_standard ? "Use ordinary time-based candles." : na(f_v3TfRank(timeframe.period)) ? "Tick charts cannot run setups." : not f_v3TfLe(timeframe.period, tf1Input) ? "Chart timeframe is above TF1." : "TF2 is above TF1."
        statusA += "Setup engine: " + reason
    if v3NativeEnabled
        skippedAnchors = 0
        for slot = 0 to 2
            if array.get(v3ExtraOn, slot) and not f_v3TfLe(timeframe.period, array.get(v3ExtraTf, slot))
                skippedAnchors += 1
        if skippedAnchors > 0
            statusA += "Draw levels: " + str.tostring(skippedAnchors) + " anchor(s) below your chart timeframe."
    if array.size(line.all) >= 470 or array.size(box.all) >= 470 or array.size(label.all) >= 470
        statusA += "Drawing space nearly full. Keep fewer candles or labels."
    if array.get(v3QueueDrops, 0) > 0
        statusA += "Alerts: " + str.tostring(array.get(v3QueueDrops, 0)) + " older queued events dropped."
    statusB += "Engine: setups " + str.tostring(array.size(v3Setups)) + ", pending " + (na(v3Manipulation) ? "none" : "yes") + ", owner " + (na(v3Owner) ? "none" : v3Owner.state) + ", newest " + (array.size(v3Setups) > 0 ? str.format_time(array.get(v3Setups, array.size(v3Setups) - 1).origin, "dd/MM/yy", "UTC") : "none") + "."
    if not na(v3Manipulation)
        statusB += " Pending: win " + str.tostring(v3Manipulation.rangeLow, format.mintick) + "-" + str.tostring(v3Manipulation.rangeHigh, format.mintick) + ", need close " + (v3Manipulation.sweptLow ? "above " + str.tostring(v3Manipulation.closeRefLow, format.mintick) : "") + (v3Manipulation.sweptLow and v3Manipulation.sweptHigh ? " or " : "") + (v3Manipulation.sweptHigh ? "below " + str.tostring(v3Manipulation.closeRefHigh, format.mintick) : "") + ", candles " + str.tostring(v3Manipulation.candles) + ", last close " + str.tostring(v3Manipulation.c, format.mintick) + "."
    if v3NativeEnabled
        int gTf1 = 0
        int gTf2 = 0
        int gAnc = 0
        int gDead = 0
        for gap in v3Gaps
            if gap.kind == "FVG"
                gk = f_v3TfKey(gap.nativeTf)
                if gk == f_v3TfKey(tf1Input)
                    gTf1 += 1
                else if gk == f_v3TfKey(tf2Input)
                    gTf2 += 1
                else
                    gAnc += 1
                if gap.drawDead
                    gDead += 1
        statusC += "POI census: TF1 " + str.tostring(gTf1) + " TF2 " + str.tostring(gTf2) + " anchor " + str.tostring(gAnc) + " drawDead " + str.tostring(gDead) + "."
    statusC += " Objects: L" + str.tostring(array.size(label.all)) + " B" + str.tostring(array.size(box.all)) + " N" + str.tostring(array.size(line.all)) + "."
    int sessBoxes = 0
    for sb in sessBox
        if not na(sb)
            sessBoxes += 1
    statusD = "Sess gate " + (sessionsTimeframeOk ? "ON" : "OFF") + " A:" + (effectiveShowSessionA ? (sessionAActive ? "act" : "idle") : "dis") + " B:" + (effectiveShowSessionB ? (sessionBActive ? "act" : "idle") : "dis") + " C:" + (effectiveShowSessionC ? (sessionCActive ? "act" : "idle") : "dis") + " D:" + (effectiveShowSessionD ? (sessionDActive ? "act" : "idle") : "dis") + " R:" + (sessionARangeInput ? "1" : "0") + (sessionBRangeInput ? "1" : "0") + (sessionCRangeInput ? "1" : "0") + (sessionDRangeInput ? "1" : "0") + " M:" + (sessionAMaxMinInput ? "1" : "0") + (sessionBMaxMinInput ? "1" : "0") + (sessionCMaxMinInput ? "1" : "0") + (sessionDMaxMinInput ? "1" : "0") + " open " + str.tostring(sessBoxes) + " fin " + str.tostring(array.size(finishedBoxes))
    table.cell(v3StatusTable, 0, 0, statusA, text_color = color.orange, text_size = size.tiny, bgcolor = color.new(color.black, statusA == "" ? 100 : 90), tooltip = "Row 1: warnings - chart ordering, skipped anchors, drawing pressure, alert drops.")
    table.cell(v3StatusTable, 0, 1, statusB, text_color = color.orange, text_size = size.tiny, bgcolor = color.new(color.black, 90), tooltip = "Row 2: engine census and pending episode close references.")
    table.cell(v3StatusTable, 0, 2, statusC, text_color = color.orange, text_size = size.tiny, bgcolor = color.new(color.black, 90), tooltip = "Row 3: POI census and object budget.")
    // Owner rule (M-pack): chart labels stay compact; the full factor breakdown, window bounds
    // and audit note live in this panel instead of on the chart.
    if v3DetailPanelInput and v3NativeEnabled and array.size(v3Setups) > 0
        showIdx = f_v3LastGatedIdx()
        showFallback = showIdx < 0
        newest = showIdx >= 0 ? array.get(v3Setups, showIdx) : array.get(v3Setups, array.size(v3Setups) - 1)
        detailInk = newest.direction == 1 ? v3BullColorInput : v3BearColorInput
        table.cell(v3StatusTable, 0, 3, statusD, text_color = color.orange, text_size = size.tiny, bgcolor = color.new(color.black, 90), tooltip = "Row 4: sessions gate, per-session enable/active, Range and MaxMin toggles, open/finished box counts.")
        table.cell(v3StatusTable, 0, 4, (showFallback ? "NO GATED IN MEMORY: TS " : "TS ") + newest.variant + (newest.direction == 1 ? " LONG" : " SHORT") + (newest.actionable ? " " + (newest.setupClass == "" ? "B" : newest.setupClass) + " -> " + f_v3TfName(newest.targetTf) : " CONTEXT" + (newest.setupClass != "" ? " (" + newest.setupClass + ")" : "")), text_color = detailInk, text_size = size.tiny, bgcolor = color.new(color.black, 85))
        table.cell(v3StatusTable, 0, 5, (newest.actionable ? "grade " + newest.grade + " score " + str.tostring(newest.score, "#.##") : "ungraded") + " | conf x" + str.tostring(newest.confluenceLayers) + " intact " + (newest.intactPrimary ? "Y" : "N") + " break " + newest.breakClass + (newest.opposition ? " OPP" : ""), text_color = color.new(color.black, 20), text_size = size.tiny, bgcolor = color.new(color.black, 90))
        table.cell(v3StatusTable, 0, 6, "win " + str.tostring(newest.rangeLow, format.mintick) + "-" + str.tostring(newest.rangeHigh, format.mintick) + " sweep " + str.format_time(newest.origin, "dd/MM/yy", "UTC") + " close " + str.tostring(newest.manClose, format.mintick), text_color = color.new(color.black, 20), text_size = size.tiny, bgcolor = color.new(color.black, 90))
        table.cell(v3StatusTable, 0, 7, newest.actionable ? "target " + str.tostring(newest.target, format.mintick) + " " + f_v3TfName(newest.targetTf) + " entry " + str.tostring(newest.entry, format.mintick) : "reason: " + newest.contextReason, text_color = color.new(color.black, 20), text_size = size.tiny, bgcolor = color.new(color.black, 90))
        table.cell(v3StatusTable, 0, 8, v3AuditInput and not na(v3Manipulation) ? "pending sweep " + str.format_time(v3Manipulation.origin, "dd/MM/yy", "UTC") + " candles " + str.tostring(v3Manipulation.candles) + " close " + str.tostring(v3Manipulation.c, format.mintick) : "window " + v3RangeState + " " + str.tostring(v3RangeLow, format.mintick) + "-" + str.tostring(v3RangeHigh, format.mintick), text_color = color.new(color.black, 35), text_size = size.tiny, bgcolor = color.new(color.black, 90))
// =============================================================================================
// SECTION 24 -- EA-FACING EVENT TRANSPORT
// One envelope preserves simultaneous transitions. Default flush requires a confirmed TF1 roll.
// Realtime mode changes transport timing only; it never changes native consumption or TS geometry.
// =============================================================================================
if v3ExportInput and barstate.isconfirmed and (newTf1Bar or v3ExportRealtimeInput)
    if array.size(v3PendingEvents) > 0
        envelope = "{\"schema\":\"rino.v3.phase1\",\"symbol\":" + f_v3Quote(syminfo.tickerid) + ",\"observedAt\":" + str.tostring(time_close) + ",\"chartTf\":" + f_v3Quote(timeframe.period) + ",\"events\":[" + array.join(v3PendingEvents,",") + "]}"
        alert(envelope,alert.freq_all)
        array.clear(v3PendingEvents)
